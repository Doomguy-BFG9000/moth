    1, -32, 71872, 71903, 1, -32, 93792, 93823, 1, -32,
    93883, 93907, 1, -27, 125218, 125251, 1, -34
set case_upper_special to list of 223, 2, 83, 83, 329, 2, 700, 78, 496, 2,
    74, 780, 912, 3, 921, 776, 769, 944, 3, 933,
    776, 769, 1415, 2, 1333, 1362, 7830, 2, 72, 817,
    7831, 2, 84, 776, 7832, 2, 87, 778, 7833, 2,
