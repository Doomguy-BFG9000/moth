# ---------- the end of Unicode's cases ----------

# ---------- the runtime: upper and lower case ----------
# `uppercase of` and `lowercase of`, as JavaScript's toUpperCase and toLowerCase: ASCII straight away, and
# any other character from the tables above, found by halving. A Σ in lower case is ς at the end of a word,
# which is when a cased character comes before it and none after, not counting case-ignorable ones between,
# and σ anywhere else. Only a program that changes case carries all this.

# the bytes UTF-8 writes a character as
to utf8_bytes_of with code
    set out to empty list
    if code is less than 128
        add code to out
    else if code is less than 2048
        add 192 + shift code right by 6 to out
        add 128 + (code bit and 63) to out
    else if code is less than 65536
        add 224 + shift code right by 12 to out
        add 128 + ((shift code right by 6) bit and 63) to out
        add 128 + (code bit and 63) to out
    else
        add 240 + shift code right by 18 to out
        add 128 + ((shift code right by 12) bit and 63) to out
        add 128 + ((shift code right by 6) bit and 63) to out
        add 128 + (code bit and 63) to out
    end
    return out
end

# a 4-byte number, signed, into a register
to load32s with a, dst, at
    enc(a, empty list, yes, (list of 0x63), dst, at, empty list)
end

# the tables, as 4-byte numbers: each run's first, last, step and what to add; each special character, in
# order, then where its bytes are and how many, then the bytes; and the ranges' firsts and lasts
to emit_case_tables with a
    set ro to rodata of a
    pad_to(ro, 4)
    for each which in list of (list of "case_upper", case_upper_runs, case_upper_special),
        (list of "case_lower", case_lower_runs, case_lower_special)
        rodata_here(a, item 1 of which + "_runs")
        for each v in item 2 of which
            put32(ro, v)
        end
        set specials to item 3 of which
        set codes to empty list
        set places to empty list
        set blob to empty list
        set k to 1
        repeat while k is at most length of specials
            add item k of specials to codes
            set count to item (k + 1) of specials
            set made to empty list
            for each j from 1 to count
                put_all(made, utf8_bytes_of(item (k + 1 + j) of specials))
            end
            add length of blob to places
            add length of made to places
            put_all(blob, made)
            set k to k + 2 + count
        end
        rodata_here(a, item 1 of which + "_codes")
        for each v in codes
            put32(ro, v)
        end
        rodata_here(a, item 1 of which + "_places")
        for each v in places
            put32(ro, v)
        end
        rodata_here(a, item 1 of which + "_bytes")
        put_all(ro, blob)
        pad_to(ro, 4)
    end
    for each which in list of (list of "case_cased", case_cased), (list of "case_ignorable", case_ignorable)
        rodata_here(a, item 1 of which)
        for each v in item 2 of which
            put32(ro, v)
        end
    end
end

to special_count with specials
    set count to 0
    set k to 1
    repeat while k is at most length of specials
        add 1 to count
        set k to k + 2 + item (k + 1) of specials
    end
    return count
end

to emit_cases with a
    emit_case_tables(a)
    set case_common to new_label(a)
    set next_char to new_label(a)
    set cased_done to new_label(a)
    set wide to new_label(a)
    set ascii_lower to new_label(a)
    set ascii_put to new_label(a)
    set not_sigma to new_label(a)
    set not_special to new_label(a)
    set put_code to new_label(a)
    # rt_upper, rt_lower: xmm0 a text: it in upper or lower case, in xmm0, and rax 0; else rax 2
    mark(a, "rt_upper")
    need_text(a, xmm0, "'uppercase of'")
    movi(a, r8, 0)
    jmp_to(a, case_common)
    mark(a, "rt_lower")
    need_text(a, xmm0, "'lowercase of'")
    movi(a, r8, 1)
    mark(a, case_common)
    for each r in list of rbx, r12, r13, r14, r15
        push_r(a, r)
    end
    mov_rr(a, r15, r8) # 0 for upper, 1 for lower
    movq_rx(a, rbx, xmm0)
    untag(a, rbx)
    load(a, r12, mem(rbx, 16))
    mov_rr(a, r13, r12)
    alu_load(a, "add", r13, mem(rbx, 0))
    call_to(a, "rt_b_reset")
    mark(a, next_char)
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, cased_done)
    load8(a, rax, mem(r12, 0))
    alui(a, "cmp", rax, 0x80)
    jcc(a, cc_ae, wide)
    test_rr(a, r15, r15)
    jcc(a, cc_ne, ascii_lower)
    alui(a, "cmp", rax, 97) # a to z
    jcc(a, cc_b, ascii_put)
    alui(a, "cmp", rax, 122)
    jcc(a, cc_a, ascii_put)
    alui(a, "sub", rax, 32)
    jmp_to(a, ascii_put)
    mark(a, ascii_lower)
    alui(a, "cmp", rax, 65) # A to Z
    jcc(a, cc_b, ascii_put)
    alui(a, "cmp", rax, 90)
    jcc(a, cc_a, ascii_put)
    alui(a, "add", rax, 32)
    mark(a, ascii_put)
    call_to(a, "rt_b_byte")
    inc_r(a, r12)
    jmp_to(a, next_char)
    mark(a, wide)
    mov_rr(a, rsi, r12)
    call_to(a, "rt_decode")
    char_size(a)
    mov_rr(a, r14, rdx)
    test_rr(a, r15, r15)
    jcc(a, cc_e, not_sigma)
    alui(a, "cmp", rax, 0x3A3)
    jcc(a, cc_ne, not_sigma)
    call_to(a, "rt_final_sigma")
    jmp_to(a, put_code)
    mark(a, not_sigma)
    mov_rr(a, r8, r15)
    call_to(a, "rt_case_special")
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, not_special)
    call_to(a, "rt_b_bytes")
    alu(a, "add", r12, r14)
    jmp_to(a, next_char)
    mark(a, not_special)
    mov_rr(a, r8, r15)
    call_to(a, "rt_case_map")
    mark(a, put_code)
    call_to(a, "rt_b_code")
    alu(a, "add", r12, r14)
    jmp_to(a, next_char)
    mark(a, cased_done)
    call_to(a, "rt_b_text")
    movq_xr(a, xmm0, rax)
    for each r in list of r15, r14, r13, r12, rbx
        pop_r(a, r)
    end
    movi(a, rax, 0)
    ret(a)

    # rt_case_find: rax a character, rsi a table of rcx entries of rdx bytes, each starting with a 4-byte
    # character, in order: the last entry whose character is at most rax, in r8, or 0. Uses r9 to r11.
    set halving to new_label(a)
    set go_low to new_label(a)
    set halved to new_label(a)
    set none_found to new_label(a)
    mark(a, "rt_case_find")
    movi(a, r9, 0)
    mov_rr(a, r10, rcx)
    mark(a, halving)
    alu(a, "cmp", r9, r10)
    jcc(a, cc_ae, halved)
    mov_rr(a, r11, r9)
    alu(a, "add", r11, r10)
    shifti(a, "shr", r11, 1)
    mov_rr(a, r8, r11)
    imul_rr(a, r8, rdx)
    alu(a, "add", r8, rsi)
    load32(a, r8, mem(r8, 0))
    alu(a, "cmp", r8, rax)
    jcc(a, cc_a, go_low)
    lea(a, r9, mem(r11, 1))
    jmp_to(a, halving)
    mark(a, go_low)
    mov_rr(a, r10, r11)
    jmp_to(a, halving)
    mark(a, halved)
    test_rr(a, r9, r9)
    jcc(a, cc_e, none_found)
    dec_r(a, r9)
    mov_rr(a, r8, r9)
    imul_rr(a, r8, rdx)
    alu(a, "add", r8, rsi)
    ret(a)
    mark(a, none_found)
    movi(a, r8, 0)
    ret(a)

    # rt_case_map: rax a character, r8 0 for upper case or 1 for lower: the character it becomes, in rax.
    # Every other register is kept.
    set map_lower to new_label(a)
    set map_table to new_label(a)
    set map_same to new_label(a)
    set map_add to new_label(a)
    mark(a, "rt_case_map")
    for each r in list of rcx, rdx, rsi, r8, r9, r10, r11
        push_r(a, r)
    end
    test_rr(a, r8, r8)
    jcc(a, cc_ne, map_lower)
    lea(a, rsi, rip("case_upper_runs"))
    movi(a, rcx, length of case_upper_runs / 4)
    jmp_to(a, map_table)
    mark(a, map_lower)
    lea(a, rsi, rip("case_lower_runs"))
    movi(a, rcx, length of case_lower_runs / 4)
    mark(a, map_table)
    movi(a, rdx, 16)
    call_to(a, "rt_case_find")
    test_rr(a, r8, r8)
    jcc(a, cc_e, map_same)
    load32(a, r9, mem(r8, 4))
    alu(a, "cmp", rax, r9)
    jcc(a, cc_a, map_same)
    load32(a, r9, mem(r8, 8))
    alui(a, "cmp", r9, 2)
    jcc(a, cc_ne, map_add)
    load32(a, r9, mem(r8, 0))
    mov_rr(a, r10, rax)
    alu(a, "sub", r10, r9)
    alui(a, "and", r10, 1)
    jcc(a, cc_ne, map_same)
    mark(a, map_add)
    load32s(a, r9, mem(r8, 12))
    alu(a, "add", rax, r9)
    mark(a, map_same)
    for each r in list of r11, r10, r9, r8, rsi, rdx, rcx
        pop_r(a, r)
    end
    ret(a)

    # rt_case_special: rax a character, r8 0 for upper case or 1 for lower: if it becomes more than one
    # character, their bytes, rsi and rcx; else rcx 0. Every other register is kept.
    set special_lower to new_label(a)
    set special_table to new_label(a)
    set special_none to new_label(a)
    set special_back to new_label(a)
    mark(a, "rt_case_special")
    for each r in list of rdx, r8, r9, r10, r11, rbx
        push_r(a, r)
    end
    test_rr(a, r8, r8)
    jcc(a, cc_ne, special_lower)
    lea(a, rsi, rip("case_upper_codes"))
    lea(a, rbx, rip("case_upper_places"))
    lea(a, r11, rip("case_upper_bytes"))
    movi(a, rcx, special_count(case_upper_special))
    jmp_to(a, special_table)
    mark(a, special_lower)
    lea(a, rsi, rip("case_lower_codes"))
    lea(a, rbx, rip("case_lower_places"))
    lea(a, r11, rip("case_lower_bytes"))
    movi(a, rcx, special_count(case_lower_special))
    mark(a, special_table)
    push_r(a, r11)
    movi(a, rdx, 4)
    call_to(a, "rt_case_find")
    pop_r(a, r11)
    test_rr(a, r8, r8)
    jcc(a, cc_e, special_none)
    load32(a, r9, mem(r8, 0))
    alu(a, "cmp", r9, rax)
    jcc(a, cc_ne, special_none)
    alu(a, "sub", r8, rsi) # which one: its bytes' place is twice as far into places
    alu(a, "add", r8, r8)
    alu(a, "add", r8, rbx)
    load32(a, rsi, mem(r8, 0))
    alu(a, "add", rsi, r11)
    load32(a, rcx, mem(r8, 4))
    jmp_to(a, special_back)
    mark(a, special_none)
    movi(a, rcx, 0)
    mark(a, special_back)
    for each r in list of rbx, r11, r10, r9, r8, rdx
        pop_r(a, r)
    end
    ret(a)

    # rt_case_in: rax a character, rsi ranges, rcx of them: rdx 1 if it's in one, else 0. Every other
    # register is kept.
    set in_none to new_label(a)
    set in_back to new_label(a)
    mark(a, "rt_case_in")
    for each r in list of r8, r9, r10, r11
        push_r(a, r)
    end
    movi(a, rdx, 8)
    call_to(a, "rt_case_find")
    test_rr(a, r8, r8)
    jcc(a, cc_e, in_none)
    load32(a, r9, mem(r8, 4))
    alu(a, "cmp", rax, r9)
    jcc(a, cc_a, in_none)
    movi(a, rdx, 1)
    jmp_to(a, in_back)
    mark(a, in_none)
    movi(a, rdx, 0)
    mark(a, in_back)
    for each r in list of r11, r10, r9, r8
        pop_r(a, r)
    end
    ret(a)

    # rt_final_sigma: r12 where a Σ is in the text at rbx, which ends at r13: ς if it ends a word, else σ,
    # in rax. Every other register is kept.
    set before_char to new_label(a)
    set back_byte to new_label(a)
    set after_char to new_label(a)
    set sigma_final to new_label(a)
    set sigma_not to new_label(a)
    set sigma_back to new_label(a)
    mark(a, "rt_final_sigma")
    for each r in list of rcx, rdx, rsi, rdi, r9
        push_r(a, r)
    end
    load(a, r9, mem(rbx, 16))
    mov_rr(a, rdi, r12)
    mark(a, before_char) # back past what's case-ignorable: is it cased?
    alu(a, "cmp", rdi, r9)
    jcc(a, cc_be, sigma_not)
    mark(a, back_byte)
    dec_r(a, rdi)
    load8(a, rax, mem(rdi, 0))
    alui(a, "and", rax, 0xC0)
    alui(a, "cmp", rax, 0x80)
    jcc(a, cc_e, back_byte)
    mov_rr(a, rsi, rdi)
    call_to(a, "rt_decode")
    case_ranges(a, "case_ignorable", case_ignorable)
    test_rr(a, rdx, rdx)
    jcc(a, cc_ne, before_char)
    case_ranges(a, "case_cased", case_cased)
    test_rr(a, rdx, rdx)
    jcc(a, cc_e, sigma_not)
    lea(a, rdi, mem(r12, 2))
    mark(a, after_char) # on past what's case-ignorable: is there something cased?
    alu(a, "cmp", rdi, r13)
    jcc(a, cc_ae, sigma_final)
    mov_rr(a, rsi, rdi)
    call_to(a, "rt_decode")
    char_size(a)
    alu(a, "add", rdi, rdx)
    case_ranges(a, "case_ignorable", case_ignorable)
    test_rr(a, rdx, rdx)
    jcc(a, cc_ne, after_char)
    case_ranges(a, "case_cased", case_cased)
    test_rr(a, rdx, rdx)
    jcc(a, cc_ne, sigma_not)
    mark(a, sigma_final)
    movi(a, rax, 0x3C2)
    jmp_to(a, sigma_back)
    mark(a, sigma_not)
    movi(a, rax, 0x3C3)
    mark(a, sigma_back)
    for each r in list of r9, rdi, rsi, rdx, rcx
        pop_r(a, r)
    end
    ret(a)

    # rt_b_code: rax a character: its UTF-8 bytes go in the builder; uses rax, rcx, rdx and rdi
    set two_bytes to new_label(a)
    set three_bytes to new_label(a)
    set four_bytes to new_label(a)
    mark(a, "rt_b_code")
    alui(a, "cmp", rax, 0x80)
    jcc(a, cc_ae, two_bytes)
    jmp_to(a, "rt_b_byte")
    mark(a, two_bytes)
    alui(a, "cmp", rax, 0x800)
    jcc(a, cc_ae, three_bytes)
    push_r(a, rax)
    shifti(a, "shr", rax, 6)
    alui(a, "or", rax, 0xC0)
    call_to(a, "rt_b_byte")
    pop_r(a, rax)
    alui(a, "and", rax, 63)
    alui(a, "or", rax, 0x80)
    jmp_to(a, "rt_b_byte")
    mark(a, three_bytes)
    alui(a, "cmp", rax, 0x10000)
    jcc(a, cc_ae, four_bytes)
    push_r(a, rax)
    shifti(a, "shr", rax, 12)
    alui(a, "or", rax, 0xE0)
    call_to(a, "rt_b_byte")
    load(a, rax, mem(rsp, 0))
    shifti(a, "shr", rax, 6)
    alui(a, "and", rax, 63)
    alui(a, "or", rax, 0x80)
    call_to(a, "rt_b_byte")
    pop_r(a, rax)
    alui(a, "and", rax, 63)
    alui(a, "or", rax, 0x80)
    jmp_to(a, "rt_b_byte")
    mark(a, four_bytes)
    push_r(a, rax)
    shifti(a, "shr", rax, 18)
    alui(a, "or", rax, 0xF0)
    call_to(a, "rt_b_byte")
    for each part in list of 12, 6
        load(a, rax, mem(rsp, 0))
        shifti(a, "shr", rax, part)
        alui(a, "and", rax, 63)
        alui(a, "or", rax, 0x80)
        call_to(a, "rt_b_byte")
    end
    pop_r(a, rax)
    alui(a, "and", rax, 63)
    alui(a, "or", rax, 0x80)
    jmp_to(a, "rt_b_byte")
end

# rdx 1 if the character in rax is in these ranges, else 0; keeps every other register
to case_ranges with a, label, ranges
    push_r(a, rsi)
    push_r(a, rcx)
    lea(a, rsi, rip(label))
    movi(a, rcx, length of ranges / 2)
    call_to(a, "rt_case_in")
    pop_r(a, rcx)
    pop_r(a, rsi)
end

# ---------- the runtime: drawing ----------
# The turtle, as vm.js's Turtle has it: where it is, which way it faces (90, up, to start), whether its pen
# is down, and the pen's colour (text, as the program gave it) and width. What it draws goes into a list in
# memory, each thing 64 bytes: what it is (1 a line, 2 a box, 3 a circle, 4 text), then four numbers (a
# line's ends; a box's corner, width and height; a circle's middle and radius; text's place and size), a
# line's width, its colour and, for text, the text. `clear` empties it, as the playground only shows what
# came after the last `clear`. On Windows a window shows it when the program ends (see the window, below).

set turtle_moves to list of "'move forward'", "'move back'", "'turn left'", "'turn right'"

# a 4-byte number, signed, into a register
# xmm x rounded down to a whole number (SSE4.1's roundsd)
to floor_sd with a, x, y
    enc(a, (list of 0x66), no, (list of 0x0F, 0x3A, 0x0B), x, reg_at(y), imm8(9))
end

to emit_turtle with a
    # rt_turtle_init: the turtle as it starts, before the program runs
    mark(a, "rt_turtle_init")
    load_bits(a, xmm0, double_bytes(90))
    movsd_store(a, rip("t_heading"), xmm0)
    load_bits(a, xmm0, double_bytes(2))
    movsd_store(a, rip("t_width"), xmm0)
    storei(a, rip("t_pen"), 1)
    lea(a, rax, rip(text_object(a, "#4f8ff7")))
    movi64(a, rcx, tag_text)
    alu(a, "or", rax, rcx)
    store(a, rip("t_color"), rax)
    ret(a)

    # rt_round2: xmm0 to hundredths, as the engines put a drawn thing's numbers: Math.round(n * 100) / 100,
    # and 0 rather than -0. Uses xmm1 and xmm2.
    set not_up to new_label(a)
    mark(a, "rt_round2")
    load_bits(a, xmm1, double_bytes(100))
    sse_math(a, "*", xmm0, reg_at(xmm1))
    floor_sd(a, xmm1, xmm0)
    movapd(a, xmm2, xmm0)
    sse_math(a, "-", xmm2, reg_at(xmm1))
    load_bits(a, xmm0, double_bytes(0.5))
    ucomisd(a, xmm2, reg_at(xmm0))
    jcc(a, cc_b, not_up)
    load_bits(a, xmm0, double_bytes(1))
    sse_math(a, "+", xmm1, reg_at(xmm0))
    mark(a, not_up)
    load_bits(a, xmm0, double_bytes(100))
    sse_math(a, "/", xmm1, reg_at(xmm0))
    load_bits(a, xmm0, double_bytes(0))
    sse_math(a, "+", xmm1, reg_at(xmm0)) # -0 + 0 is 0
    movapd(a, xmm0, xmm1)
    ret(a)

    # rt_pic_add: a thing drawn, from pi_kind, pi_a to pi_d, pi_w and pi_text, in the turtle's colour, goes at
    # the end of the picture's list, which grows as it needs to. Keeps every register but rax.
    set room to new_label(a)
    set some to new_label(a)
    mark(a, "rt_pic_add")
    for each r in list of rcx, rdx, rsi, rdi
        push_r(a, r)
    end
    load(a, rax, rip("pic_n"))
    alu_load(a, "cmp", rax, rip("pic_cap"))
    jcc(a, cc_b, room)
    load(a, rcx, rip("pic_cap"))
    alu(a, "add", rcx, rcx)
    jcc(a, cc_ne, some)
    movi(a, rcx, 64)
    mark(a, some)
    store(a, rip("pic_cap"), rcx)
    shifti(a, "shl", rcx, 6)
    call_to(a, "rt_alloc")
    mov_rr(a, rdi, rax)
    load(a, rsi, rip("pic_items"))
    load(a, rcx, rip("pic_n"))
    shifti(a, "shl", rcx, 3)
    rep_movsq(a)
    store(a, rip("pic_items"), rax)
    mark(a, room)
    load(a, rdi, rip("pic_n"))
    shifti(a, "shl", rdi, 6)
    alu_load(a, "add", rdi, rip("pic_items"))
    for each field in list of (list of "pi_kind", 0), (list of "pi_a", 8), (list of "pi_b", 16), (list of "pi_c", 24),
        (list of "pi_d", 32), (list of "pi_w", 40), (list of "t_color", 48), (list of "pi_text", 56)
        load(a, rax, rip(item 1 of field))
        store(a, mem(rdi, item 2 of field), rax)
    end
    alu_at(a, "add", rip("pic_n"), 1)
    for each r in list of rdi, rsi, rdx, rcx
        pop_r(a, r)
    end
    ret(a)

    # rt_pic_line: a line from (t_x, t_y) to (t_nx, t_ny), its ends to hundredths, if the pen is down
    set pen_up to new_label(a)
    mark(a, "rt_pic_line")
    load(a, rax, rip("t_pen"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, pen_up)
    for each pair in list of (list of "t_x", "pi_a"), (list of "t_y", "pi_b"), (list of "t_nx", "pi_c"), (list of "t_ny", "pi_d")
        movsd_load(a, xmm0, rip(item 1 of pair))
        call_to(a, "rt_round2")
        movsd_store(a, rip(item 2 of pair), xmm0)
    end
    load(a, rax, rip("t_width"))
    store(a, rip("pi_w"), rax)
    storei(a, rip("pi_kind"), 1)
    storei(a, rip("pi_text"), 0)
    call_to(a, "rt_pic_add")
    mark(a, pen_up)
    ret(a)

    # rt_turtle_numbers: rax a list, untagged, of rcx numbers, the one at place rdx (from 0) nothing for 16:
    # each, to hundredths, from tn0 on; rax 0, or 1 with err_a the first that isn't a number. The list is one
    # the program's own code made, so it has as many as that.
    set each_one to new_label(a)
    set fine to new_label(a)
    set not_number to new_label(a)
    set given to new_label(a)
    set numbers_done to new_label(a)
    mark(a, "rt_turtle_numbers")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    load(a, rbx, mem(rax, 16))
    mov_rr(a, r12, rcx)
    mov_rr(a, r13, rdx)
    movi(a, r14, 0)
    mark(a, each_one)
    alu(a, "cmp", r14, r12)
    jcc(a, cc_ae, numbers_done)
    mov_rr(a, rax, r14)
    shifti(a, "shl", rax, 3)
    alu(a, "add", rax, rbx)
    movsd_load(a, xmm0, mem(rax, 0))
    alu(a, "cmp", r14, r13)
    jcc(a, cc_ne, given)
    movq_rx(a, rax, xmm0)
    movi64(a, rcx, bits_nothing)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_ne, given)
    load_bits(a, xmm0, double_bytes(16))
    mark(a, given)
    odd_jump(a, xmm0, not_number)
    call_to(a, "rt_round2")
    lea(a, rax, rip("tn0"))
    mov_rr(a, rcx, r14)
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rax, rcx)
    movsd_store(a, mem(rax, 0), xmm0)
    inc_r(a, r14)
    jmp_to(a, each_one)
    mark(a, not_number)
    movsd_store(a, rip("err_a"), xmm0)
    movi(a, rax, 1)
    jmp_to(a, fine)
    mark(a, numbers_done)
    movi(a, rax, 0)
    mark(a, fine)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_turtle: rcx what to do, in vm.js's TURTLE_ACTIONS order (forward, back, left, right, up, down, color,
    # width, to, clear, box, circle, text), xmm0 what with: rax 0, or 2 with err_why for rt_why_turtle
    set acts to empty list
    for each k from 0 to 12
        add new_label(a) to acts
    end
    set wrong_kind to new_label(a)
    set wrong_numbers to new_label(a)
    set done_ok to new_label(a)
    set move_back to new_label(a)
    set turn_right to new_label(a)
    mark(a, "rt_turtle")
    for each k from 0 to 12
        alui(a, "cmp", rcx, k)
        jcc(a, cc_e, item (k + 1) of acts)
    end
    jmp_to(a, done_ok)
    for each k from 0 to 3 # forward, back, left, right: a number
        mark(a, item (k + 1) of acts)
        lea(a, rax, rip(text_object(a, item (k + 1) of turtle_moves)))
        store(a, rip("err_what"), rax)
        odd_jump(a, xmm0, wrong_kind)
        if k is 0 or k is 1
            if k is 1
                movq_rx(a, rax, xmm0)
                bit_op(a, "btc", rax, 63)
                movq_xr(a, xmm0, rax)
            end
            jmp_to(a, move_back)
        else
            if k is 3
                movq_rx(a, rax, xmm0)
                bit_op(a, "btc", rax, 63)
                movq_xr(a, xmm0, rax)
            end
            jmp_to(a, turn_right)
        end
    end
    mark(a, move_back) # steps from where it is, the way it faces
    movsd_store(a, rip("t_steps"), xmm0)
    movsd_load(a, xmm1, rip("t_heading"))
    load_bits(a, xmm2, double_bytes(3.141592653589793))
    sse_math(a, "*", xmm1, reg_at(xmm2))
    load_bits(a, xmm2, double_bytes(180))
    sse_math(a, "/", xmm1, reg_at(xmm2))
    movsd_store(a, rip("t_angle"), xmm1)
    enc(a, empty list, no, (list of 0xDD), 0, rip("t_angle"), empty list) # fld the angle
    raw(a, list of 0xD9, 0xFB) # fsincos: its cosine, then its sine
    enc(a, empty list, no, (list of 0xDD), 3, rip("t_cos"), empty list)
    enc(a, empty list, no, (list of 0xDD), 3, rip("t_sin"), empty list)
    movsd_load(a, xmm2, rip("t_steps"))
    sse_math(a, "*", xmm2, rip("t_cos"))
    movsd_load(a, xmm1, rip("t_x"))
    sse_math(a, "+", xmm1, reg_at(xmm2))
    movsd_store(a, rip("t_nx"), xmm1)
    movsd_load(a, xmm2, rip("t_steps"))
    sse_math(a, "*", xmm2, rip("t_sin"))
    movsd_load(a, xmm1, rip("t_y"))
    sse_math(a, "+", xmm1, reg_at(xmm2))
    movsd_store(a, rip("t_ny"), xmm1)
    call_to(a, "rt_pic_line")
    load(a, rax, rip("t_nx"))
    store(a, rip("t_x"), rax)
    load(a, rax, rip("t_ny"))
    store(a, rip("t_y"), rax)
    jmp_to(a, done_ok)
    mark(a, turn_right)
    movsd_load(a, xmm1, rip("t_heading"))
    sse_math(a, "+", xmm1, reg_at(xmm0))
    movsd_store(a, rip("t_heading"), xmm1)
    jmp_to(a, done_ok)
    mark(a, item 5 of acts) # up
    storei(a, rip("t_pen"), 0)
    jmp_to(a, done_ok)
    mark(a, item 6 of acts) # down
    storei(a, rip("t_pen"), 1)
    jmp_to(a, done_ok)
    mark(a, item 7 of acts) # color: any text
    movsd_store(a, rip("err_a"), xmm0)
    movq_rx(a, rax, xmm0)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    set colour_fine to new_label(a)
    jcc(a, cc_e, colour_fine)
    storei(a, rip("err_why"), 72)
    movi(a, rax, 2)
    ret(a)
    mark(a, colour_fine)
    movsd_store(a, rip("t_color"), xmm0)
    jmp_to(a, done_ok)
    mark(a, item 8 of acts) # width: a number above 0
    movsd_store(a, rip("err_a"), xmm0)
    set width_wrong to new_label(a)
    odd_jump(a, xmm0, width_wrong)
    load_bits(a, xmm1, double_bytes(0))
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_be, width_wrong)
    movsd_store(a, rip("t_width"), xmm0)
    jmp_to(a, done_ok)
    mark(a, width_wrong)
    storei(a, rip("err_why"), 73)
    movi(a, rax, 2)
    ret(a)
    mark(a, item 9 of acts) # to x, y
    lea(a, rax, rip(text_object(a, "'move to'")))
    store(a, rip("err_what"), rax)
    movq_rx(a, rax, xmm0)
    untag(a, rax)
    movi(a, rcx, 2)
    movi(a, rdx, -1)
    call_to(a, "rt_turtle_numbers")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, wrong_numbers)
    load(a, rax, rip("tn0"))
    store(a, rip("t_nx"), rax)
    load(a, rax, rip("tn1"))
    store(a, rip("t_ny"), rax)
    call_to(a, "rt_pic_line")
    load(a, rax, rip("tn0"))
    store(a, rip("t_x"), rax)
    load(a, rax, rip("tn1"))
    store(a, rip("t_y"), rax)
    jmp_to(a, done_ok)
    mark(a, item 10 of acts) # clear
    storei(a, rip("pic_n"), 0)
    jmp_to(a, done_ok)
    for each shape in list of (list of 11, "'draw box'", 4, 2), (list of 12, "'draw circle'", 3, 3)
        mark(a, item (item 1 of shape) of acts)
        lea(a, rax, rip(text_object(a, item 2 of shape)))
        store(a, rip("err_what"), rax)
        movq_rx(a, rax, xmm0)
        untag(a, rax)
        movi(a, rcx, item 3 of shape)
        movi(a, rdx, -1)
        call_to(a, "rt_turtle_numbers")
        test_rr(a, rax, rax)
        jcc(a, cc_ne, wrong_numbers)
        if item 4 of shape is 3 # a circle's size is 0 or more
            set round_fine to new_label(a)
            movsd_load(a, xmm0, rip("tn2"))
            load_bits(a, xmm1, double_bytes(0))
            ucomisd(a, xmm0, reg_at(xmm1))
            jcc(a, cc_ae, round_fine)
            movsd_store(a, rip("err_a"), xmm0)
            storei(a, rip("err_why"), 74)
            movi(a, rax, 2)
            ret(a)
            mark(a, round_fine)
        end
        for each pair in list of (list of "tn0", "pi_a"), (list of "tn1", "pi_b"), (list of "tn2", "pi_c"), (list of "tn3", "pi_d")
            load(a, rax, rip(item 1 of pair))
            store(a, rip(item 2 of pair), rax)
        end
        storei(a, rip("pi_kind"), item 4 of shape)
        storei(a, rip("pi_w"), 0)
        storei(a, rip("pi_text"), 0)
        call_to(a, "rt_pic_add")
        jmp_to(a, done_ok)
    end
    mark(a, item 13 of acts) # text at x, y, size (16 if none): text as `say` shows it
    lea(a, rax, rip(text_object(a, "'draw ... at'")))
    store(a, rip("err_what"), rax)
    movq_rx(a, rax, xmm0)
    untag(a, rax)
    push_r(a, rax)
    # the text is first: the numbers after it
    load(a, rcx, mem(rax, 16))
    alui(a, "add", rcx, 8)
    store(a, rip("t_list"), rcx) # a list's items from the second on, as rt_turtle_numbers reads them
    lea(a, rax, rip("t_list"))
    alui(a, "sub", rax, 16)
    movi(a, rcx, 3)
    movi(a, rdx, 2)
    call_to(a, "rt_turtle_numbers")
    pop_r(a, rcx)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, wrong_numbers)
    set size_fine to new_label(a)
    movsd_load(a, xmm0, rip("tn2"))
    load_bits(a, xmm1, double_bytes(0))
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_a, size_fine)
    movsd_store(a, rip("err_a"), xmm0)
    storei(a, rip("err_why"), 75)
    movi(a, rax, 2)
    ret(a)
    mark(a, size_fine)
    load(a, rcx, mem(rcx, 16)) # the text, shown
    load(a, rax, mem(rcx, 0))
    push_r(a, rax)
    call_to(a, "rt_b_reset")
    pop_r(a, rax)
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    call_to(a, "rt_b_text")
    store(a, rip("pi_text"), rax)
    for each pair in list of (list of "tn0", "pi_a"), (list of "tn1", "pi_b"), (list of "tn2", "pi_c")
        load(a, rax, rip(item 1 of pair))
        store(a, rip(item 2 of pair), rax)
    end
    storei(a, rip("pi_d"), 0)
    storei(a, rip("pi_w"), 0)
    storei(a, rip("pi_kind"), 4)
    call_to(a, "rt_pic_add")
    jmp_to(a, done_ok)
    mark(a, wrong_kind)
    movsd_store(a, rip("err_a"), xmm0)
    storei(a, rip("err_why"), 70)
    movi(a, rax, 2)
    ret(a)
    mark(a, wrong_numbers)
    storei(a, rip("err_why"), 71)
    movi(a, rax, 2)
    ret(a)
    mark(a, done_ok)
    movi(a, rax, 0)
    ret(a)

    # rt_why_turtle: what was wrong, into the builder, as vm.js's Turtle says it
    set w71 to new_label(a)
    set w72 to new_label(a)
    set w73 to new_label(a)
    set w74 to new_label(a)
    set w75 to new_label(a)
    set w77 to new_label(a)
    mark(a, "rt_why_turtle")
    load(a, rax, rip("err_why"))
    for each pair in list of (list of 71, w71), (list of 72, w72), (list of 73, w73), (list of 74, w74), (list of 75, w75), (list of 77, w77)
        alui(a, "cmp", rax, item 1 of pair)
        jcc(a, cc_e, item 2 of pair)
    end
    what_name(a) # 70
    b_text(a, " needs a number, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w71)
    what_name(a)
    b_text(a, " needs numbers, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w72)
    b_text(a, "'pen color' needs text like \"red\", not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w73)
    b_text(a, "'pen width' needs a number above 0, not ")
    load(a, rax, rip("err_a"))
    movi(a, rdx, 1)
    jmp_to(a, "rt_b_value")
    mark(a, w74)
    b_text(a, "a circle's size is 0 or more, not ")
    load(a, rax, rip("err_a"))
    movi(a, rdx, 0)
    jmp_to(a, "rt_b_value")
    mark(a, w75)
    b_text(a, "text's size is a number above 0, not ")
    load(a, rax, rip("err_a"))
    movi(a, rdx, 0)
    jmp_to(a, "rt_b_value")
    mark(a, w77)
    b_text(a, "'every' needs a number above 0, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_described")
end

# ---------- the runtime: apps ----------
# `when a key is pressed`, `when the mouse is clicked` or dragged, and `every 2 seconds`: each handler, in
# the order the program made them, 32 bytes: what it waits for (0 a key, 1 a click, 2 a drag, 3 a timer),
# the function, how many inputs it takes, and for a timer how many milliseconds apart.

to emit_app_setup with a
    # rt_on: rcx what it waits for, rax the function, rdx how many inputs it takes; rt_every: the same for a
    # timer, xmm0 how often, in units of rcx milliseconds: rax 0, or 2 (err_why 77) for a time that isn't a
    # number above 0
    set room to new_label(a)
    set some to new_label(a)
    set every_wrong to new_label(a)
    set put to new_label(a)
    mark(a, "rt_every")
    mov_rr(a, r10, rax) # the function and the unit, kept from odd_jump
    mov_rr(a, r11, rcx)
    movsd_store(a, rip("err_a"), xmm0)
    odd_jump(a, xmm0, every_wrong)
    load_bits(a, xmm1, double_bytes(0))
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_be, every_wrong)
    movq_rx(a, r8, xmm0)
    movi64(a, r9, list of 0, 0, 0, 0, 0, 0, 0xF0, 0x7F) # infinity
    alu(a, "cmp", r8, r9)
    jcc(a, cc_e, every_wrong)
    cvtsi2sd(a, xmm1, r11)
    sse_math(a, "*", xmm0, reg_at(xmm1))
    movsd_store(a, rip("ev_ms"), xmm0)
    mov_rr(a, rax, r10)
    movi(a, rcx, 3)
    jmp_to(a, put)
    mark(a, every_wrong)
    storei(a, rip("err_why"), 77)
    movi(a, rax, 2)
    ret(a)
    mark(a, "rt_on")
    storei(a, rip("ev_ms"), 0)
    mark(a, put)
    push_r(a, rax)
    push_r(a, rcx)
    push_r(a, rdx)
    load(a, rax, rip("app_n"))
    alu_load(a, "cmp", rax, rip("app_cap"))
    jcc(a, cc_b, room)
    load(a, rcx, rip("app_cap"))
    alu(a, "add", rcx, rcx)
    jcc(a, cc_ne, some)
    movi(a, rcx, 8)
    mark(a, some)
    store(a, rip("app_cap"), rcx)
    shifti(a, "shl", rcx, 5)
    call_to(a, "rt_alloc")
    mov_rr(a, rdi, rax)
    load(a, rsi, rip("app_items"))
    load(a, rcx, rip("app_n"))
    shifti(a, "shl", rcx, 2)
    rep_movsq(a)
    store(a, rip("app_items"), rax)
    mark(a, room)
    load(a, rdi, rip("app_n"))
    shifti(a, "shl", rdi, 5)
    alu_load(a, "add", rdi, rip("app_items"))
    pop_r(a, rdx)
    pop_r(a, rcx)
    pop_r(a, rax)
    store(a, mem(rdi, 0), rcx)
    store(a, mem(rdi, 8), rax)
    store(a, mem(rdi, 16), rdx)
    load(a, rax, rip("ev_ms"))
    store(a, mem(rdi, 24), rax)
    alu_at(a, "add", rip("app_n"), 1)
    movi(a, rax, 0)
    ret(a)
end

# ---------- the runtime: a window, on Windows ----------
# When a program that drew something, or set up an app, ends at a terminal, a window shows the picture as
# the playground does: 500 by 500, (0, 0) in the middle and y going up, smoothed by GDI+, and a drawing
# made smaller if it reaches past the edge (an app's never is: it's where its clicks land). An app runs in
# it: keys, clicks, drags and timers go to its handlers, and the picture is drawn again after each. A
# question that starts with "Draw", asked at a terminal, opens a pad to draw the answer on, which comes
# back the way the playground's pad gives it. Away from a terminal none of this opens, so a program runs
# as it does anywhere else; MOTH_PICTURE=file.bmp instead draws the picture into that file, after the
# events in MOTH_EVENTS ("key left;click 10 20;drag 11 21;tick 0"), which is how the tests see it.

set gui_imports to list of (list of "USER32.dll", (list of "RegisterClassExW", "CreateWindowExW", "DefWindowProcW",
    "GetMessageW", "TranslateMessage", "DispatchMessageW", "PostQuitMessage", "InvalidateRect", "BeginPaint", "EndPaint",
    "LoadCursorW", "SetTimer", "SetCapture", "ReleaseCapture", "AdjustWindowRect", "DestroyWindow", "CharLowerW",
    "GetKeyState", "SetForegroundWindow")),
    (list of "GDI32.dll", (list of "CreateCompatibleDC", "CreateCompatibleBitmap", "SelectObject", "DeleteObject",
    "DeleteDC", "BitBlt", "CreateDIBSection", "GdiFlush")),
    (list of "gdiplus.dll", (list of "GdiplusStartup", "GdipCreateFromHDC", "GdipDeleteGraphics", "GdipSetSmoothingMode",
    "GdipSetTextRenderingHint", "GdipGraphicsClear", "GdipCreatePen1", "GdipSetPenStartCap", "GdipSetPenEndCap",
    "GdipSetPenLineJoin", "GdipDeletePen", "GdipDrawLine", "GdipCreateSolidFill", "GdipDeleteBrush", "GdipFillRectangle",
    "GdipFillEllipse", "GdipCreateFontFamilyFromName", "GdipGetCellAscent", "GdipGetEmHeight", "GdipCreateFont",
    "GdipDeleteFont", "GdipDrawString", "GdipStringFormatGetGenericTypographic")),
    (list of "KERNEL32.dll", (list of "GetModuleHandleW", "GetEnvironmentVariableW"))

# CSS's named colours, as a browser's canvas knows them, each with its red, green and blue
set css_colors to list of "aliceblue", 0xF0F8FF, "antiquewhite", 0xFAEBD7, "aqua", 0x00FFFF, "aquamarine", 0x7FFFD4,
    "azure", 0xF0FFFF, "beige", 0xF5F5DC, "bisque", 0xFFE4C4, "black", 0x000000, "blanchedalmond", 0xFFEBCD,
    "blue", 0x0000FF, "blueviolet", 0x8A2BE2, "brown", 0xA52A2A, "burlywood", 0xDEB887, "cadetblue", 0x5F9EA0,
    "chartreuse", 0x7FFF00, "chocolate", 0xD2691E, "coral", 0xFF7F50, "cornflowerblue", 0x6495ED, "cornsilk", 0xFFF8DC,
    "crimson", 0xDC143C, "cyan", 0x00FFFF, "darkblue", 0x00008B, "darkcyan", 0x008B8B, "darkgoldenrod", 0xB8860B,
    "darkgray", 0xA9A9A9, "darkgreen", 0x006400, "darkgrey", 0xA9A9A9, "darkkhaki", 0xBDB76B, "darkmagenta", 0x8B008B,
    "darkolivegreen", 0x556B2F, "darkorange", 0xFF8C00, "darkorchid", 0x9932CC, "darkred", 0x8B0000,
    "darksalmon", 0xE9967A, "darkseagreen", 0x8FBC8F, "darkslateblue", 0x483D8B, "darkslategray", 0x2F4F4F,
    "darkslategrey", 0x2F4F4F, "darkturquoise", 0x00CED1, "darkviolet", 0x9400D3, "deeppink", 0xFF1493,
    "deepskyblue", 0x00BFFF, "dimgray", 0x696969, "dimgrey", 0x696969, "dodgerblue", 0x1E90FF, "firebrick", 0xB22222,
    "floralwhite", 0xFFFAF0, "forestgreen", 0x228B22, "fuchsia", 0xFF00FF, "gainsboro", 0xDCDCDC,
    "ghostwhite", 0xF8F8FF, "gold", 0xFFD700, "goldenrod", 0xDAA520, "gray", 0x808080, "green", 0x008000,
    "greenyellow", 0xADFF2F, "grey", 0x808080, "honeydew", 0xF0FFF0, "hotpink", 0xFF69B4, "indianred", 0xCD5C5C,
    "indigo", 0x4B0082, "ivory", 0xFFFFF0, "khaki", 0xF0E68C, "lavender", 0xE6E6FA, "lavenderblush", 0xFFF0F5,
    "lawngreen", 0x7CFC00, "lemonchiffon", 0xFFFACD, "lightblue", 0xADD8E6, "lightcoral", 0xF08080,
    "lightcyan", 0xE0FFFF, "lightgoldenrodyellow", 0xFAFAD2, "lightgray", 0xD3D3D3, "lightgreen", 0x90EE90,
    "lightgrey", 0xD3D3D3, "lightpink", 0xFFB6C1, "lightsalmon", 0xFFA07A, "lightseagreen", 0x20B2AA,
    "lightskyblue", 0x87CEFA, "lightslategray", 0x778899, "lightslategrey", 0x778899, "lightsteelblue", 0xB0C4DE,
    "lightyellow", 0xFFFFE0, "lime", 0x00FF00, "limegreen", 0x32CD32, "linen", 0xFAF0E6, "magenta", 0xFF00FF,
    "maroon", 0x800000, "mediumaquamarine", 0x66CDAA, "mediumblue", 0x0000CD, "mediumorchid", 0xBA55D3,
    "mediumpurple", 0x9370DB, "mediumseagreen", 0x3CB371, "mediumslateblue", 0x7B68EE, "mediumspringgreen", 0x00FA9A,
    "mediumturquoise", 0x48D1CC, "mediumvioletred", 0xC71585, "midnightblue", 0x191970, "mintcream", 0xF5FFFA,
    "mistyrose", 0xFFE4E1, "moccasin", 0xFFE4B5, "navajowhite", 0xFFDEAD, "navy", 0x000080, "oldlace", 0xFDF5E6,
    "olive", 0x808000, "olivedrab", 0x6B8E23, "orange", 0xFFA500, "orangered", 0xFF4500, "orchid", 0xDA70D6,
    "palegoldenrod", 0xEEE8AA, "palegreen", 0x98FB98, "paleturquoise", 0xAFEEEE, "palevioletred", 0xDB7093,
    "papayawhip", 0xFFEFD5, "peachpuff", 0xFFDAB9, "peru", 0xCD853F, "pink", 0xFFC0CB, "plum", 0xDDA0DD,
    "powderblue", 0xB0E0E6, "purple", 0x800080, "rebeccapurple", 0x663399, "red", 0xFF0000, "rosybrown", 0xBC8F8F,
    "royalblue", 0x4169E1, "saddlebrown", 0x8B4513, "salmon", 0xFA8072, "sandybrown", 0xF4A460, "seagreen", 0x2E8B57,
    "seashell", 0xFFF5EE, "sienna", 0xA0522D, "silver", 0xC0C0C0, "skyblue", 0x87CEEB, "slateblue", 0x6A5ACD,
    "slategray", 0x708090, "slategrey", 0x708090, "snow", 0xFFFAFA, "springgreen", 0x00FF7F, "steelblue", 0x4682B4,
    "tan", 0xD2B48C, "teal", 0x008080, "thistle", 0xD8BFD8, "tomato", 0xFF6347, "turquoise", 0x40E0D0,
    "violet", 0xEE82EE, "wheat", 0xF5DEB3, "white", 0xFFFFFF, "whitesmoke", 0xF5F5F5, "yellow", 0xFFFF00,
    "yellowgreen", 0x9ACD32

# the names keys have, as the playground gives them, by their Windows key codes
set gui_key_names to list of 0x25, "left", 0x26, "up", 0x27, "right", 0x28, "down", 0x20, "space", 0x0D, "enter",
    0x1B, "escape", 0x08, "backspace", 0x10, "shift", 0x14, "capslock", 0x2E, "delete", 0x24, "home", 0x23, "end",
    0x21, "pageup", 0x22, "pagedown", 0x2D, "insert", 0x70, "f1", 0x71, "f2", 0x72, "f3", 0x73, "f4", 0x74, "f5",
    0x75, "f6", 0x76, "f7", 0x77, "f8", 0x78, "f9", 0x79, "f10", 0x7A, "f11", 0x7B, "f12"

to w_call with a, fn_name
    call_import(a, "imp_" + fn_name)
end

# where the k-th input of a Windows function (from the 5th on) goes, inside win_enter
to arg_at with k
    return mem(rsp, 32 + 8 * (k - 5))
end

to cvtsd2ss with a, x, y
    sse(a, 0xF2, 0x5A, x, reg_at(y))
end

to movss_store with a, at, x
    sse(a, 0xF3, 0x11, x, at)
end

to minsd with a, x, y
    sse(a, 0xF2, 0x5D, x, reg_at(y))
end

to movdqu_store with a, at, x
    enc(a, (list of 0xF3), no, (list of 0x0F, 0x7F), x, at, empty list)
end

to movdqu_load with a, x, at
    enc(a, (list of 0xF3), no, (list of 0x0F, 0x6F), x, at, empty list)
end

# 16 bits of register src, signed, into dst
to movsx16 with a, dst, src
    enc(a, empty list, yes, (list of 0x0F, 0xBF), dst, reg_at(src), empty list)
end

# xmm x without its sign; uses rax
to abs_sd with a, x
    movq_rx(a, rax, x)
    bit_op(a, "btr", rax, 63)
    movq_xr(a, x, rax)
end

# xmm dst: where x in the picture goes across, 250 + x times the scale; uses xmm5
to picture_x with a, dst, at
    movsd_load(a, dst, at)
    sse_math(a, "*", dst, rip("gui_scale"))
    load_bits(a, xmm5, double_bytes(250))
    sse_math(a, "+", dst, reg_at(xmm5))
end

# xmm dst: where y goes down, 250 - y times the scale; uses xmm5
to picture_y with a, dst, at
    movsd_load(a, xmm5, at)
    sse_math(a, "*", xmm5, rip("gui_scale"))
    load_bits(a, dst, double_bytes(250))
    sse_math(a, "-", dst, reg_at(xmm5))
end

# a text's UTF-16, ending in 0, in the read-only data: its label
to wide_place with a, t
    set ro to rodata of a
    pad_to(ro, 2)
    set label to "W" + length of ro
    rodata_here(a, label)
    for each c in t
        set code to code_point(c)
        if code is less than 65536
            put16(ro, code)
        else
            set code to code - 65536
            put16(ro, 0xD800 + shift code right by 10)
            put16(ro, 0xDC00 + (code bit and 1023))
        end
    end
    put16(ro, 0)
    return label
end

to emit_gui with a, title
    set ro to rodata of a
    pad_to(ro, 8)
    rodata_here(a, "css_names") # 32 bytes each: the name's length, then the name
    set colour_count to 0
    set k to 1
    repeat while k is at most length of css_colors
        set named to (item k of css_colors) as bytes
        put64(ro, length of named)
        put_all(ro, named)
        repeat 24 - length of named times
            add 0 to ro
        end
        add 1 to colour_count
        set k to k + 2
    end
    rodata_here(a, "css_argb")
    set k to 2
    repeat while k is at most length of css_colors
        put32(ro, 0xFF000000 + item k of css_colors)
        set k to k + 2
    end
    set class_name to wide_place(a, "MothWindow")
    set font_name to wide_place(a, "Segoe UI")
    set picture_title to wide_place(a, title + " - Moth")
    set picture_env to wide_place(a, "MOTH_PICTURE")
    set events_env to wide_place(a, "MOTH_EVENTS")
    set pad_hint to wide_place(a, "Enter answers, Esc clears, closing ends the program")

    # rt_css_argb: rax a colour as text: its ARGB in rax, or -1 for one a canvas wouldn't know. #rgb, #rgba,
    # #rrggbb, #rrggbbaa, a CSS name in any case, or transparent.
    set hex_loop to new_label(a)
    set hex_done to new_label(a)
    set not_hex to new_label(a)
    set unknown to new_label(a)
    set names_loop to new_label(a)
    set name_next to new_label(a)
    set name_chars to new_label(a)
    set name_found to new_label(a)
    set digit_ok to new_label(a)
    set lower_ok to new_label(a)
    set short_form to new_label(a)
    set has_alpha to new_label(a)
    set argb_back to new_label(a)
    set a_text_colour to new_label(a)
    mark(a, "rt_css_argb")
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 48)
    alui(a, "cmp", rcx, kind_text)
    jcc(a, cc_e, a_text_colour)
    movi(a, rax, -1)
    ret(a)
    mark(a, a_text_colour)
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    untag(a, rax)
    load(a, rsi, mem(rax, 16))
    load(a, rcx, mem(rax, 0))
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, unknown)
    load8(a, rax, mem(rsi, 0))
    alui(a, "cmp", rax, 35) # #
    jcc(a, cc_ne, not_hex)
    movi(a, rbx, 0) # the hex digits, 4 bits each
    lea(a, r12, mem(rcx, -1)) # how many
    movi(a, r13, 1)
    mark(a, hex_loop)
    alu(a, "cmp", r13, rcx)
    jcc(a, cc_ae, hex_done)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, r13)
    load8(a, rax, mem(rax, 0))
    alui(a, "or", rax, 32) # lower case
    alui(a, "sub", rax, 48)
    alui(a, "cmp", rax, 9)
    jcc(a, cc_be, digit_ok)
    alui(a, "sub", rax, 49) # 'a' - '0'
    alui(a, "cmp", rax, 5)
    jcc(a, cc_a, unknown)
    alui(a, "add", rax, 10)
    mark(a, digit_ok)
    shifti(a, "shl", rbx, 4)
    alu(a, "or", rbx, rax)
    inc_r(a, r13)
    jmp_to(a, hex_loop)
    mark(a, hex_done)
    alui(a, "cmp", r12, 3)
    jcc(a, cc_e, short_form)
    alui(a, "cmp", r12, 4)
    jcc(a, cc_e, short_form)
    alui(a, "cmp", r12, 6)
    jcc(a, cc_e, argb_back)
    alui(a, "cmp", r12, 8)
    jcc(a, cc_ne, unknown)
    mov_rr(a, rax, rbx) # rrggbbaa: the alpha to the top
    alui(a, "and", rax, 255)
    shifti(a, "shl", rax, 24)
    shifti(a, "shr", rbx, 8)
    alu(a, "or", rbx, rax)
    mov_rr(a, rax, rbx)
    jmp_to(a, has_alpha)
    mark(a, short_form) # each digit twice
    movi(a, rax, 0)
    movi(a, r13, 0)
    set doubling to new_label(a)
    set doubled to new_label(a)
    mov_rr(a, rdx, r12)
    mark(a, doubling)
    test_rr(a, rdx, rdx)
    jcc(a, cc_e, doubled)
    dec_r(a, rdx)
    mov_rr(a, rcx, rdx)
    shifti(a, "shl", rcx, 2)
    mov_rr(a, r8, rbx)
    shift_cl(a, "shr", r8)
    alui(a, "and", r8, 15)
    mov_rr(a, r9, r8)
    shifti(a, "shl", r9, 4)
    alu(a, "or", r8, r9)
    shifti(a, "shl", rax, 8)
    alu(a, "or", rax, r8)
    jmp_to(a, doubling)
    mark(a, doubled)
    mov_rr(a, rbx, rax)
    alui(a, "cmp", r12, 4)
    jcc(a, cc_ne, argb_back)
    mov_rr(a, rax, rbx)
    alui(a, "and", rax, 255)
    shifti(a, "shl", rax, 24)
    shifti(a, "shr", rbx, 8)
    alu(a, "or", rbx, rax)
    mov_rr(a, rax, rbx)
    jmp_to(a, has_alpha)
    mark(a, argb_back)
    mov_rr(a, rax, rbx)
    alui(a, "or", rax, -16777216) # opaque
    shifti(a, "shl", rax, 32)
    shifti(a, "shr", rax, 32)
    mark(a, has_alpha)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
    mark(a, not_hex) # a name
    lea(a, rbx, rip("css_names"))
    movi(a, r12, 0)
    mark(a, names_loop)
    alui(a, "cmp", r12, colour_count)
    jcc(a, cc_ae, unknown)
    alu_load(a, "cmp", rcx, mem(rbx, 0))
    jcc(a, cc_ne, name_next)
    movi(a, r13, 0)
    mark(a, name_chars)
    alu(a, "cmp", r13, rcx)
    jcc(a, cc_ae, name_found)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, r13)
    load8(a, rax, mem(rax, 0))
    lea(a, rdx, mem(rax, -65)) # A to Z, lower case
    alui(a, "cmp", rdx, 25)
    jcc(a, cc_a, lower_ok)
    alui(a, "add", rax, 32)
    mark(a, lower_ok)
    mov_rr(a, rdx, rbx)
    alu(a, "add", rdx, r13)
    load8(a, rdx, mem(rdx, 8))
    alu(a, "cmp", rax, rdx)
    jcc(a, cc_ne, name_next)
    inc_r(a, r13)
    jmp_to(a, name_chars)
    mark(a, name_next)
    alui(a, "add", rbx, 32)
    inc_r(a, r12)
    jmp_to(a, names_loop)
    mark(a, name_found)
    lea(a, rax, rip("css_argb"))
    shifti(a, "shl", r12, 2)
    alu(a, "add", rax, r12)
    load32(a, rax, mem(rax, 0))
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
    mark(a, unknown) # transparent, or one it doesn't know
    set not_clear to new_label(a)
    alui(a, "cmp", rcx, 11)
    jcc(a, cc_ne, not_clear)
    lea(a, rdi, rip(label of text_place(a, "transparent")))
    movi(a, r13, 0)
    set clear_chars to new_label(a)
    mark(a, clear_chars)
    alui(a, "cmp", r13, 11)
    set is_clear to new_label(a)
    jcc(a, cc_ae, is_clear)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, r13)
    load8(a, rax, mem(rax, 0))
    alui(a, "or", rax, 32)
    mov_rr(a, rdx, rdi)
    alu(a, "add", rdx, r13)
    load8(a, rdx, mem(rdx, 0))
    alu(a, "cmp", rax, rdx)
    jcc(a, cc_ne, not_clear)
    inc_r(a, r13)
    jmp_to(a, clear_chars)
    mark(a, is_clear)
    movi(a, rax, 0)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
    mark(a, not_clear)
    movi(a, rax, -1)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_pic_scale: how much smaller to draw it: 1 for an app, else at most what fits it in, 240 from the middle
    set reach_loop to new_label(a)
    set reach_done to new_label(a)
    set not_line to new_label(a)
    set not_box to new_label(a)
    set not_round to new_label(a)
    set reached to new_label(a)
    set app_scale to new_label(a)
    mark(a, "rt_pic_scale")
    load(a, rax, rip("app_n"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, app_scale)
    load_bits(a, xmm6, double_bytes(0)) # the reach
    load(a, rsi, rip("pic_items"))
    load(a, rcx, rip("pic_n"))
    mark(a, reach_loop)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, reach_done)
    load(a, rdx, mem(rsi, 0))
    alui(a, "cmp", rdx, 1)
    jcc(a, cc_ne, not_line)
    for each off in list of 8, 16, 24, 32
        movsd_load(a, xmm0, mem(rsi, off))
        abs_sd(a, xmm0)
        sse_math(a, "max", xmm6, reg_at(xmm0))
    end
    jmp_to(a, reached)
    mark(a, not_line)
    alui(a, "cmp", rdx, 2)
    jcc(a, cc_ne, not_box)
    for each pair in list of (list of 8, 0), (list of 16, 0), (list of 8, 24), (list of 16, 32)
        movsd_load(a, xmm0, mem(rsi, item 1 of pair))
        if item 2 of pair is not 0
            sse_math(a, "+", xmm0, mem(rsi, item 2 of pair))
        end
        abs_sd(a, xmm0)
        sse_math(a, "max", xmm6, reg_at(xmm0))
    end
    jmp_to(a, reached)
    mark(a, not_box)
    alui(a, "cmp", rdx, 3)
    jcc(a, cc_ne, not_round)
    movsd_load(a, xmm0, mem(rsi, 8)) # a circle: the farther of x and y, and its radius
    abs_sd(a, xmm0)
    movsd_load(a, xmm1, mem(rsi, 16))
    abs_sd(a, xmm1)
    sse_math(a, "max", xmm0, reg_at(xmm1))
    sse_math(a, "+", xmm0, mem(rsi, 24))
    sse_math(a, "max", xmm6, reg_at(xmm0))
    jmp_to(a, reached)
    mark(a, not_round) # text: its x, and its y and size
    movsd_load(a, xmm0, mem(rsi, 8))
    abs_sd(a, xmm0)
    sse_math(a, "max", xmm6, reg_at(xmm0))
    movsd_load(a, xmm0, mem(rsi, 16))
    abs_sd(a, xmm0)
    sse_math(a, "+", xmm0, mem(rsi, 24))
    sse_math(a, "max", xmm6, reg_at(xmm0))
    mark(a, reached)
    alui(a, "add", rsi, 64)
    dec_r(a, rcx)
    jmp_to(a, reach_loop)
    mark(a, reach_done)
    load_bits(a, xmm0, double_bytes(240))
    sse_math(a, "/", xmm0, reg_at(xmm6))
    load_bits(a, xmm1, double_bytes(1))
    minsd(a, xmm1, xmm0)
    movsd_store(a, rip("gui_scale"), xmm1)
    ret(a)
    mark(a, app_scale)
    load_bits(a, xmm0, double_bytes(1))
    movsd_store(a, rip("gui_scale"), xmm0)
    ret(a)

    # rt_render_picture: rcx a GDI+ graphics: the picture on it, from the last `clear` on
    set item_loop to new_label(a)
    set items_done to new_label(a)
    set colour_known to new_label(a)
    set colour_kept to new_label(a)
    set a_box to new_label(a)
    set a_circle to new_label(a)
    set a_text to new_label(a)
    set item_next to new_label(a)
    set not_dot to new_label(a)
    mark(a, "rt_render_picture")
    for each r in list of rbx, r12, r13, r14, r15
        push_r(a, r)
    end
    mov_rr(a, r14, rcx)
    win_enter(a)
    mov_rr(a, rcx, r14)
    movi(a, rdx, 4) # smoothed
    w_call(a, "GdipSetSmoothingMode")
    mov_rr(a, rcx, r14)
    movi(a, rdx, 4)
    w_call(a, "GdipSetTextRenderingHint")
    mov_rr(a, rcx, r14)
    movi(a, rdx, 0xFF0B1122) # the playground's dark blue
    w_call(a, "GdipGraphicsClear")
    call_to(a, "rt_pic_scale")
    movi(a, rax, 0xFF000000) # a colour a canvas doesn't know keeps the one before, black to start
    store(a, rip("gui_argb"), rax)
    storei(a, rip("gui_last"), 0)
    load(a, r12, rip("pic_items"))
    load(a, r13, rip("pic_n"))
    movi(a, r15, 0)
    mark(a, item_loop)
    alu(a, "cmp", r15, r13)
    jcc(a, cc_ae, items_done)
    mov_rr(a, rbx, r15)
    shifti(a, "shl", rbx, 6)
    alu(a, "add", rbx, r12)
    load(a, rax, mem(rbx, 48))
    alu_load(a, "cmp", rax, rip("gui_last"))
    jcc(a, cc_e, colour_known)
    store(a, rip("gui_last"), rax)
    call_to(a, "rt_css_argb")
    alui(a, "cmp", rax, -1)
    jcc(a, cc_e, colour_known)
    store(a, rip("gui_argb"), rax)
    mark(a, colour_known)
    load(a, rax, mem(rbx, 0))
    alui(a, "cmp", rax, 2)
    jcc(a, cc_e, a_box)
    alui(a, "cmp", rax, 3)
    jcc(a, cc_e, a_circle)
    alui(a, "cmp", rax, 4)
    jcc(a, cc_e, a_text)
    # a line, with round ends; one that goes nowhere is a dot, as on a canvas
    movsd_load(a, xmm0, mem(rbx, 8))
    ucomisd(a, xmm0, mem(rbx, 24))
    jcc(a, cc_ne, not_dot)
    movsd_load(a, xmm0, mem(rbx, 16))
    ucomisd(a, xmm0, mem(rbx, 32))
    jcc(a, cc_ne, not_dot)
    load32(a, rcx, rip("gui_argb"))
    lea(a, rdx, rip("gui_brush"))
    w_call(a, "GdipCreateSolidFill")
    movsd_load(a, xmm0, mem(rbx, 40)) # the width, scaled: a circle that wide
    sse_math(a, "*", xmm0, rip("gui_scale"))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, arg_at(5), xmm4)
    movss_store(a, arg_at(6), xmm4)
    load_bits(a, xmm1, double_bytes(0.5))
    sse_math(a, "*", xmm0, reg_at(xmm1))
    movsd_store(a, rip("gui_half"), xmm0)
    picture_x(a, xmm2, mem(rbx, 8))
    sse_math(a, "-", xmm2, rip("gui_half"))
    cvtsd2ss(a, xmm2, xmm2)
    picture_y(a, xmm3, mem(rbx, 16))
    sse_math(a, "-", xmm3, rip("gui_half"))
    cvtsd2ss(a, xmm3, xmm3)
    mov_rr(a, rcx, r14)
    load(a, rdx, rip("gui_brush"))
    w_call(a, "GdipFillEllipse")
    load(a, rcx, rip("gui_brush"))
    w_call(a, "GdipDeleteBrush")
    jmp_to(a, item_next)
    mark(a, not_dot)
    movsd_load(a, xmm0, mem(rbx, 40))
    sse_math(a, "*", xmm0, rip("gui_scale"))
    cvtsd2ss(a, xmm1, xmm0)
    load32(a, rcx, rip("gui_argb"))
    movi(a, r8, 2) # in pixels
    lea(a, r9, rip("gui_pen"))
    w_call(a, "GdipCreatePen1")
    for each fn_name in list of "GdipSetPenStartCap", "GdipSetPenEndCap"
        load(a, rcx, rip("gui_pen"))
        movi(a, rdx, 2) # round
        w_call(a, fn_name)
    end
    picture_x(a, xmm0, mem(rbx, 24))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, arg_at(5), xmm4)
    picture_y(a, xmm0, mem(rbx, 32))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, arg_at(6), xmm4)
    picture_x(a, xmm2, mem(rbx, 8))
    cvtsd2ss(a, xmm2, xmm2)
    picture_y(a, xmm3, mem(rbx, 16))
    cvtsd2ss(a, xmm3, xmm3)
    mov_rr(a, rcx, r14)
    load(a, rdx, rip("gui_pen"))
    w_call(a, "GdipDrawLine")
    load(a, rcx, rip("gui_pen"))
    w_call(a, "GdipDeletePen")
    jmp_to(a, item_next)
    mark(a, a_box) # from its corner nearest the top left
    load32(a, rcx, rip("gui_argb"))
    lea(a, rdx, rip("gui_brush"))
    w_call(a, "GdipCreateSolidFill")
    movsd_load(a, xmm0, mem(rbx, 8))
    movapd(a, xmm1, xmm0)
    sse_math(a, "+", xmm1, mem(rbx, 24))
    minsd(a, xmm0, xmm1)
    movsd_store(a, rip("gui_t0"), xmm0)
    movsd_load(a, xmm0, mem(rbx, 16))
    movapd(a, xmm1, xmm0)
    sse_math(a, "+", xmm1, mem(rbx, 32))
    sse_math(a, "max", xmm0, reg_at(xmm1))
    movsd_store(a, rip("gui_t1"), xmm0)
    for each pair in list of (list of 24, 5), (list of 32, 6)
        movsd_load(a, xmm0, mem(rbx, item 1 of pair))
        abs_sd(a, xmm0)
        sse_math(a, "*", xmm0, rip("gui_scale"))
        cvtsd2ss(a, xmm4, xmm0)
        movss_store(a, arg_at(item 2 of pair), xmm4)
    end
    picture_x(a, xmm2, rip("gui_t0"))
    cvtsd2ss(a, xmm2, xmm2)
    picture_y(a, xmm3, rip("gui_t1"))
    cvtsd2ss(a, xmm3, xmm3)
    mov_rr(a, rcx, r14)
    load(a, rdx, rip("gui_brush"))
    w_call(a, "GdipFillRectangle")
    load(a, rcx, rip("gui_brush"))
    w_call(a, "GdipDeleteBrush")
    jmp_to(a, item_next)
    mark(a, a_circle) # in the square around it
    load32(a, rcx, rip("gui_argb"))
    lea(a, rdx, rip("gui_brush"))
    w_call(a, "GdipCreateSolidFill")
    movsd_load(a, xmm0, mem(rbx, 8))
    sse_math(a, "-", xmm0, mem(rbx, 24))
    movsd_store(a, rip("gui_t0"), xmm0)
    movsd_load(a, xmm0, mem(rbx, 16))
    sse_math(a, "+", xmm0, mem(rbx, 24))
    movsd_store(a, rip("gui_t1"), xmm0)
    movsd_load(a, xmm0, mem(rbx, 24))
    sse_math(a, "+", xmm0, reg_at(xmm0))
    sse_math(a, "*", xmm0, rip("gui_scale"))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, arg_at(5), xmm4)
    movss_store(a, arg_at(6), xmm4)
    picture_x(a, xmm2, rip("gui_t0"))
    cvtsd2ss(a, xmm2, xmm2)
    picture_y(a, xmm3, rip("gui_t1"))
    cvtsd2ss(a, xmm3, xmm3)
    mov_rr(a, rcx, r14)
    load(a, rdx, rip("gui_brush"))
    w_call(a, "GdipFillEllipse")
    load(a, rcx, rip("gui_brush"))
    w_call(a, "GdipDeleteBrush")
    jmp_to(a, item_next)
    mark(a, a_text) # its baseline at y, as a canvas puts it
    load32(a, rcx, rip("gui_argb"))
    lea(a, rdx, rip("gui_brush"))
    w_call(a, "GdipCreateSolidFill")
    load(a, rcx, rip("gui_family"))
    movsd_load(a, xmm0, mem(rbx, 24))
    sse_math(a, "*", xmm0, rip("gui_scale"))
    cvtsd2ss(a, xmm1, xmm0)
    movi(a, r8, 0)
    movi(a, r9, 2)
    lea(a, rax, rip("gui_font"))
    store(a, arg_at(5), rax)
    w_call(a, "GdipCreateFont")
    load(a, rax, mem(rbx, 56)) # the text, as UTF-16
    untag(a, rax)
    movi(a, rcx, 65001)
    movi(a, rdx, 0)
    load(a, r8, mem(rax, 16))
    load32(a, r9, mem(rax, 0))
    lea(a, rax, rip("wbuf"))
    store(a, arg_at(5), rax)
    storei(a, arg_at(6), wide_cap)
    w_call(a, "MultiByteToWideChar")
    store(a, rip("gui_units"), rax)
    picture_x(a, xmm0, mem(rbx, 8))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, rip("gui_rectf"), xmm4)
    picture_y(a, xmm0, mem(rbx, 16))
    movsd_load(a, xmm1, mem(rbx, 24))
    sse_math(a, "*", xmm1, rip("gui_scale"))
    sse_math(a, "*", xmm1, rip("gui_ascent"))
    sse_math(a, "-", xmm0, reg_at(xmm1))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, rip_plus("gui_rectf", 4), xmm4)
    load_bits(a, xmm0, double_bytes(100000))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, rip_plus("gui_rectf", 8), xmm4)
    movss_store(a, rip_plus("gui_rectf", 12), xmm4)
    mov_rr(a, rcx, r14)
    lea(a, rdx, rip("wbuf"))
    load32(a, r8, rip("gui_units"))
    load(a, r9, rip("gui_font"))
    lea(a, rax, rip("gui_rectf"))
    store(a, arg_at(5), rax)
    load(a, rax, rip("gui_format"))
    store(a, arg_at(6), rax)
    load(a, rax, rip("gui_brush"))
    store(a, arg_at(7), rax)
    w_call(a, "GdipDrawString")
    load(a, rcx, rip("gui_font"))
    w_call(a, "GdipDeleteFont")
    load(a, rcx, rip("gui_brush"))
    w_call(a, "GdipDeleteBrush")
    mark(a, item_next)
    inc_r(a, r15)
    jmp_to(a, item_loop)
    mark(a, items_done)
    win_leave(a)
    for each r in list of r15, r14, r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_render_pad: rcx a GDI+ graphics: the drawing pad, its strokes 26 wide and nearly white, as the
    # playground's pad draws them, and how to use it
    set point_loop to new_label(a)
    set points_done to new_label(a)
    set stroke_start to new_label(a)
    set point_next to new_label(a)
    mark(a, "rt_render_pad")
    for each r in list of rbx, r12, r13, r14, r15
        push_r(a, r)
    end
    mov_rr(a, r14, rcx)
    win_enter(a)
    mov_rr(a, rcx, r14)
    movi(a, rdx, 4)
    w_call(a, "GdipSetSmoothingMode")
    mov_rr(a, rcx, r14)
    movi(a, rdx, 4)
    w_call(a, "GdipSetTextRenderingHint")
    mov_rr(a, rcx, r14)
    movi(a, rdx, 0xFF080C18)
    w_call(a, "GdipGraphicsClear")
    movi(a, rcx, 0xFFF5F5F5)
    load_bits(a, xmm0, double_bytes(26))
    cvtsd2ss(a, xmm1, xmm0)
    movi(a, r8, 2)
    lea(a, r9, rip("gui_pen"))
    w_call(a, "GdipCreatePen1")
    for each fn_name in list of "GdipSetPenStartCap", "GdipSetPenEndCap", "GdipSetPenLineJoin"
        load(a, rcx, rip("gui_pen"))
        movi(a, rdx, 2)
        w_call(a, fn_name)
    end
    movi(a, rcx, 0xFFF5F5F5)
    lea(a, rdx, rip("gui_brush"))
    w_call(a, "GdipCreateSolidFill")
    load(a, r12, rip("pad_pts"))
    load(a, r13, rip("pad_n"))
    movi(a, r15, 0)
    mark(a, point_loop)
    alu(a, "cmp", r15, r13)
    jcc(a, cc_ae, points_done)
    imul_ri(a, rbx, r15, 24)
    alu(a, "add", rbx, r12)
    load(a, rax, mem(rbx, 16))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, stroke_start)
    for each pair in list of (list of 0, 5), (list of 8, 6) # from the point before to this one
        load(a, rax, mem(rbx, item 1 of pair))
        cvtsi2sd(a, xmm0, rax)
        load_bits(a, xmm1, double_bytes(4.4))
        sse_math(a, "*", xmm0, reg_at(xmm1))
        cvtsd2ss(a, xmm4, xmm0)
        movss_store(a, arg_at(item 2 of pair), xmm4)
    end
    for each pair in list of (list of -24, xmm2), (list of -16, xmm3)
        load(a, rax, mem(rbx, item 1 of pair))
        cvtsi2sd(a, item 2 of pair, rax)
        load_bits(a, xmm1, double_bytes(4.4))
        sse_math(a, "*", item 2 of pair, reg_at(xmm1))
        cvtsd2ss(a, item 2 of pair, item 2 of pair)
    end
    mov_rr(a, rcx, r14)
    load(a, rdx, rip("gui_pen"))
    w_call(a, "GdipDrawLine")
    jmp_to(a, point_next)
    mark(a, stroke_start) # a dot where a stroke starts
    load_bits(a, xmm0, double_bytes(26))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, arg_at(5), xmm4)
    movss_store(a, arg_at(6), xmm4)
    for each pair in list of (list of 0, xmm2), (list of 8, xmm3)
        load(a, rax, mem(rbx, item 1 of pair))
        cvtsi2sd(a, item 2 of pair, rax)
        load_bits(a, xmm1, double_bytes(4.4))
        sse_math(a, "*", item 2 of pair, reg_at(xmm1))
        load_bits(a, xmm1, double_bytes(13))
        sse_math(a, "-", item 2 of pair, reg_at(xmm1))
        cvtsd2ss(a, item 2 of pair, item 2 of pair)
    end
    mov_rr(a, rcx, r14)
    load(a, rdx, rip("gui_brush"))
    w_call(a, "GdipFillEllipse")
    mark(a, point_next)
    inc_r(a, r15)
    jmp_to(a, point_loop)
    mark(a, points_done)
    load(a, rcx, rip("gui_pen"))
    w_call(a, "GdipDeletePen")
    load(a, rcx, rip("gui_brush"))
    w_call(a, "GdipDeleteBrush")
    movi(a, rcx, 0xFF5A6488) # how to use it, small and dim, at the bottom
    lea(a, rdx, rip("gui_brush"))
    w_call(a, "GdipCreateSolidFill")
    load(a, rcx, rip("gui_family"))
    load_bits(a, xmm0, double_bytes(13))
    cvtsd2ss(a, xmm1, xmm0)
    movi(a, r8, 0)
    movi(a, r9, 2)
    lea(a, rax, rip("gui_font"))
    store(a, arg_at(5), rax)
    w_call(a, "GdipCreateFont")
    for each pair in list of (list of 0, 10), (list of 4, 418), (list of 8, 420), (list of 12, 30)
        load_bits(a, xmm0, double_bytes(item 2 of pair))
        cvtsd2ss(a, xmm4, xmm0)
        movss_store(a, rip_plus("gui_rectf", item 1 of pair), xmm4)
    end
    mov_rr(a, rcx, r14)
    lea(a, rdx, rip(pad_hint))
    movi(a, r8, -1)
    load(a, r9, rip("gui_font"))
    lea(a, rax, rip("gui_rectf"))
    store(a, arg_at(5), rax)
    load(a, rax, rip("gui_format"))
    store(a, arg_at(6), rax)
    load(a, rax, rip("gui_brush"))
    store(a, arg_at(7), rax)
    w_call(a, "GdipDrawString")
    load(a, rcx, rip("gui_font"))
    w_call(a, "GdipDeleteFont")
    load(a, rcx, rip("gui_brush"))
    w_call(a, "GdipDeleteBrush")
    win_leave(a)
    for each r in list of r15, r14, r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_gui_start: GDI+, the font, and the window's class, once
    set started to new_label(a)
    mark(a, "rt_gui_start")
    load(a, rax, rip("gui_started"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, started)
    storei(a, rip("gui_started"), 1)
    win_enter(a)
    storei(a, rip("gui_input"), 1)
    lea(a, rcx, rip("gui_token"))
    lea(a, rdx, rip("gui_input"))
    movi(a, r8, 0)
    w_call(a, "GdiplusStartup")
    lea(a, rcx, rip(font_name))
    movi(a, rdx, 0)
    lea(a, r8, rip("gui_family"))
    w_call(a, "GdipCreateFontFamilyFromName")
    load(a, rcx, rip("gui_family"))
    movi(a, rdx, 0)
    lea(a, r8, rip("gui_t0"))
    w_call(a, "GdipGetCellAscent")
    load(a, rcx, rip("gui_family"))
    movi(a, rdx, 0)
    lea(a, r8, rip("gui_t1"))
    w_call(a, "GdipGetEmHeight")
    load16(a, rax, rip("gui_t0")) # how far above the baseline the font goes, for its size
    cvtsi2sd(a, xmm0, rax)
    load16(a, rax, rip("gui_t1"))
    cvtsi2sd(a, xmm1, rax)
    sse_math(a, "/", xmm0, reg_at(xmm1))
    movsd_store(a, rip("gui_ascent"), xmm0)
    lea(a, rcx, rip("gui_format"))
    w_call(a, "GdipStringFormatGetGenericTypographic")
    movi(a, rcx, 0)
    w_call(a, "GetModuleHandleW")
    store(a, rip("gui_hinst"), rax)
    movi(a, rcx, 0)
    movi(a, rdx, 32512) # the arrow
    w_call(a, "LoadCursorW")
    storei(a, rip("gui_wc"), 80)
    lea(a, rcx, rip("rt_wndproc"))
    store(a, rip_plus("gui_wc", 8), rcx)
    load(a, rcx, rip("gui_hinst"))
    store(a, rip_plus("gui_wc", 24), rcx)
    store(a, rip_plus("gui_wc", 40), rax)
    lea(a, rcx, rip(class_name))
    store(a, rip_plus("gui_wc", 64), rcx)
    lea(a, rcx, rip("gui_wc"))
    w_call(a, "RegisterClassExW")
    win_leave(a)
    mark(a, started)
    ret(a)

    # rt_window_open: rcx 0 for the picture or 1 for the pad, rdx how many pixels across and down, r8 the
    # title: a window, shown
    mark(a, "rt_window_open")
    store(a, rip("gui_mode"), rcx)
    store(a, rip("gui_size"), rdx)
    storei(a, rip("gui_done"), 0)
    push_r(a, rbx)
    mov_rr(a, rbx, r8)
    call_to(a, "rt_gui_start")
    win_enter(a)
    storei(a, rip("gui_rect"), 0)
    load(a, rax, rip("gui_size"))
    store32(a, rip_plus("gui_rect", 8), rax)
    store32(a, rip_plus("gui_rect", 12), rax)
    lea(a, rcx, rip("gui_rect"))
    movi(a, rdx, 0x00CA0000) # a caption, a close box and a minimise box
    movi(a, r8, 0)
    w_call(a, "AdjustWindowRect")
    movi(a, rcx, 0)
    lea(a, rdx, rip(class_name))
    mov_rr(a, r8, rbx)
    movi(a, r9, 0x10CA0000) # and visible
    storei(a, arg_at(5), -2147483648)
    storei(a, arg_at(6), -2147483648)
    load32s(a, rax, rip_plus("gui_rect", 8))
    load32s(a, r10, rip("gui_rect"))
    alu(a, "sub", rax, r10)
    store(a, arg_at(7), rax)
    load32s(a, rax, rip_plus("gui_rect", 12))
    load32s(a, r10, rip_plus("gui_rect", 4))
    alu(a, "sub", rax, r10)
    store(a, arg_at(8), rax)
    storei(a, arg_at(9), 0)
    storei(a, arg_at(10), 0)
    load(a, rax, rip("gui_hinst"))
    store(a, arg_at(11), rax)
    storei(a, arg_at(12), 0)
    w_call(a, "CreateWindowExW")
    store(a, rip("gui_hwnd"), rax)
    mov_rr(a, rcx, rax)
    w_call(a, "SetForegroundWindow")
    win_leave(a)
    pop_r(a, rbx)
    ret(a)

    # rt_gui_loop: messages to the window until it's done with
    set loop_top to new_label(a)
    set loop_out to new_label(a)
    mark(a, "rt_gui_loop")
    win_enter(a)
    mark(a, loop_top)
    load(a, rax, rip("gui_done"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, loop_out)
    lea(a, rcx, rip("gui_msg"))
    movi(a, rdx, 0)
    movi(a, r8, 0)
    movi(a, r9, 0)
    w_call(a, "GetMessageW")
    load32s(a, rax, reg_at(rax))
    alui(a, "cmp", rax, 0)
    jcc(a, cc_le, loop_out)
    lea(a, rcx, rip("gui_msg"))
    w_call(a, "TranslateMessage")
    lea(a, rcx, rip("gui_msg"))
    w_call(a, "DispatchMessageW")
    jmp_to(a, loop_top)
    mark(a, loop_out)
    win_leave(a)
    ret(a)

    # rt_paint: rcx the window: drawn again, into a picture of its own first, then all at once
    set as_pad to new_label(a)
    set drawn to new_label(a)
    mark(a, "rt_paint")
    for each r in list of rbx, r12, r13, r14
        push_r(a, r)
    end
    mov_rr(a, rbx, rcx)
    win_enter(a)
    mov_rr(a, rcx, rbx)
    lea(a, rdx, rip("gui_ps"))
    w_call(a, "BeginPaint")
    mov_rr(a, r12, rax)
    mov_rr(a, rcx, r12)
    w_call(a, "CreateCompatibleDC")
    mov_rr(a, r13, rax)
    mov_rr(a, rcx, r12)
    load(a, rdx, rip("gui_size"))
    mov_rr(a, r8, rdx)
    w_call(a, "CreateCompatibleBitmap")
    mov_rr(a, r14, rax)
    mov_rr(a, rcx, r13)
    mov_rr(a, rdx, r14)
    w_call(a, "SelectObject")
    store(a, rip("gui_old"), rax)
    mov_rr(a, rcx, r13)
    lea(a, rdx, rip("gui_graphics"))
    w_call(a, "GdipCreateFromHDC")
    load(a, rcx, rip("gui_graphics"))
    load(a, rax, rip("gui_mode"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, as_pad)
    call_to(a, "rt_render_picture")
    jmp_to(a, drawn)
    mark(a, as_pad)
    call_to(a, "rt_render_pad")
    mark(a, drawn)
    load(a, rcx, rip("gui_graphics"))
    w_call(a, "GdipDeleteGraphics")
    mov_rr(a, rcx, r12)
    movi(a, rdx, 0)
    movi(a, r8, 0)
    load(a, r9, rip("gui_size"))
    store(a, arg_at(5), r9)
    store(a, arg_at(6), r13)
    storei(a, arg_at(7), 0)
    storei(a, arg_at(8), 0)
    storei(a, arg_at(9), 0x00CC0020) # copied as it is
    w_call(a, "BitBlt")
    mov_rr(a, rcx, r13)
    load(a, rdx, rip("gui_old"))
    w_call(a, "SelectObject")
    mov_rr(a, rcx, r14)
    w_call(a, "DeleteObject")
    mov_rr(a, rcx, r13)
    w_call(a, "DeleteDC")
    mov_rr(a, rcx, rbx)
    lea(a, rdx, rip("gui_ps"))
    w_call(a, "EndPaint")
    win_leave(a)
    for each r in list of r14, r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_app_call: rbx a handler: its function, called with ev_a and ev_b, as many as it takes. It's the
    # first call in progress, so a mistake in it lists only the calls under it.
    set no_inputs to new_label(a)
    mark(a, "rt_app_call")
    for each r in list of rbx, rbp, r12, r13, r14, r15
        push_r(a, r)
    end
    mov_rr(a, r12, rsp)
    load(a, rax, mem(rbx, 8))
    push_r(a, rax)
    load(a, rcx, mem(rbx, 16))
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, no_inputs)
    load(a, rax, rip("ev_a"))
    push_r(a, rax)
    alui(a, "cmp", rcx, 2)
    jcc(a, cc_b, no_inputs)
    load(a, rax, rip("ev_b"))
    push_r(a, rax)
    mark(a, no_inputs)
    storei(a, rip("try_top"), 0)
    movi(a, r15, 1)
    load(a, rax, mem(rbx, 8))
    untag(a, rax)
    load(a, rdx, mem(rax, 8))
    load(a, rcx, mem(rax, 0))
    movi(a, rax, -1)
    call_r(a, rcx)
    mov_rr(a, rsp, r12)
    call_to(a, "rt_flush_out") # what it said, shown now
    for each r in list of r15, r14, r13, r12, rbp, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_app_send: rcx what happened (0 a key, 1 a click, 2 a drag): each handler of it, in order
    set send_loop to new_label(a)
    set send_next to new_label(a)
    set sent to new_label(a)
    mark(a, "rt_app_send")
    for each r in list of rbx, r12, r13
        push_r(a, r)
    end
    mov_rr(a, r12, rcx)
    movi(a, r13, 0)
    mark(a, send_loop)
    alu_load(a, "cmp", r13, rip("app_n"))
    jcc(a, cc_ae, sent)
    mov_rr(a, rbx, r13)
    shifti(a, "shl", rbx, 5)
    alu_load(a, "add", rbx, rip("app_items"))
    alu_load(a, "cmp", r12, mem(rbx, 0))
    jcc(a, cc_ne, send_next)
    call_to(a, "rt_app_call")
    mark(a, send_next)
    inc_r(a, r13)
    jmp_to(a, send_loop)
    mark(a, sent)
    for each r in list of r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_app_tick: rcx which timer, from 0 in the order the program made them: its handler
    set tick_loop to new_label(a)
    set tick_next to new_label(a)
    set ticked to new_label(a)
    mark(a, "rt_app_tick")
    for each r in list of rbx, r12, r13
        push_r(a, r)
    end
    mov_rr(a, r12, rcx)
    movi(a, r13, 0)
    mark(a, tick_loop)
    alu_load(a, "cmp", r13, rip("app_n"))
    jcc(a, cc_ae, ticked)
    mov_rr(a, rbx, r13)
    shifti(a, "shl", rbx, 5)
    alu_load(a, "add", rbx, rip("app_items"))
    load(a, rax, mem(rbx, 0))
    alui(a, "cmp", rax, 3)
    jcc(a, cc_ne, tick_next)
    test_rr(a, r12, r12)
    jcc(a, cc_ne, tick_next)
    call_to(a, "rt_app_call")
    jmp_to(a, ticked)
    mark(a, tick_next)
    load(a, rax, mem(rbx, 0))
    alui(a, "cmp", rax, 3)
    set not_timer to new_label(a)
    jcc(a, cc_ne, not_timer)
    dec_r(a, r12)
    mark(a, not_timer)
    inc_r(a, r13)
    jmp_to(a, tick_loop)
    mark(a, ticked)
    for each r in list of r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_ev_spot: rcx and rdx a point in the window: as the picture's own numbers, (0, 0) in the middle and y
    # going up, in ev_a and ev_b
    mark(a, "rt_ev_spot")
    alui(a, "sub", rcx, 250)
    cvtsi2sd(a, xmm0, rcx)
    movsd_store(a, rip("ev_a"), xmm0)
    movi(a, rax, 250)
    alu(a, "sub", rax, rdx)
    cvtsi2sd(a, xmm0, rax)
    movsd_store(a, rip("ev_b"), xmm0)
    ret(a)

    # rt_math_round: xmm0 as Math.round has it, into rax
    set rounded_down to new_label(a)
    mark(a, "rt_math_round")
    floor_sd(a, xmm1, xmm0)
    movapd(a, xmm2, xmm0)
    sse_math(a, "-", xmm2, reg_at(xmm1))
    cvttsd2si(a, rax, xmm1)
    load_bits(a, xmm3, double_bytes(0.5))
    ucomisd(a, xmm2, reg_at(xmm3))
    jcc(a, cc_b, rounded_down)
    inc_r(a, rax)
    mark(a, rounded_down)
    ret(a)

    # rt_pad_point: rcx and rdx a point on the pad, in its pixels, r8 1 if a stroke starts there: added, as
    # the playground's pad has it, from 0 to 100 across and down, unless it's less than 1.5 from the last
    set pad_room to new_label(a)
    set pad_some to new_label(a)
    set pad_add to new_label(a)
    set pad_skip to new_label(a)
    mark(a, "rt_pad_point")
    for each r in list of rbx, r12, r13
        push_r(a, r)
    end
    mov_rr(a, r13, r8)
    for each pair in list of (list of rcx, rbx), (list of rdx, r12)
        cvtsi2sd(a, xmm0, item 1 of pair)
        load_bits(a, xmm1, double_bytes(440))
        sse_math(a, "/", xmm0, reg_at(xmm1))
        load_bits(a, xmm1, double_bytes(100))
        sse_math(a, "*", xmm0, reg_at(xmm1))
        call_to(a, "rt_math_round")
        mov_rr(a, item 2 of pair, rax)
    end
    set pad_has to new_label(a)
    load(a, rax, rip("pad_n"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, pad_has)
    movi(a, r13, 1) # the first point always starts a stroke
    jmp_to(a, pad_add)
    mark(a, pad_has)
    test_rr(a, r13, r13)
    jcc(a, cc_ne, pad_add)
    imul_ri(a, rax, rax, 24)
    alu_load(a, "add", rax, rip("pad_pts"))
    mov_rr(a, rcx, rbx)
    alu_load(a, "sub", rcx, mem(rax, -24))
    imul_rr(a, rcx, rcx)
    mov_rr(a, rdx, r12)
    alu_load(a, "sub", rdx, mem(rax, -16))
    imul_rr(a, rdx, rdx)
    alu(a, "add", rcx, rdx)
    cvtsi2sd(a, xmm0, rcx)
    load_bits(a, xmm1, double_bytes(2.25))
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_b, pad_skip)
    mark(a, pad_add)
    load(a, rax, rip("pad_n"))
    alu_load(a, "cmp", rax, rip("pad_cap"))
    jcc(a, cc_b, pad_room)
    load(a, rcx, rip("pad_cap"))
    alu(a, "add", rcx, rcx)
    jcc(a, cc_ne, pad_some)
    movi(a, rcx, 256)
    mark(a, pad_some)
    store(a, rip("pad_cap"), rcx)
    imul_ri(a, rcx, rcx, 24)
    call_to(a, "rt_alloc_raw")
    mov_rr(a, rdi, rax)
    load(a, rsi, rip("pad_pts"))
    load(a, rcx, rip("pad_n"))
    imul_ri(a, rcx, rcx, 3)
    rep_movsq(a)
    store(a, rip("pad_pts"), rax)
    mark(a, pad_room)
    load(a, rax, rip("pad_n"))
    imul_ri(a, rax, rax, 24)
    alu_load(a, "add", rax, rip("pad_pts"))
    store(a, mem(rax, 0), rbx)
    store(a, mem(rax, 8), r12)
    store(a, mem(rax, 16), r13)
    alu_at(a, "add", rip("pad_n"), 1)
    mark(a, pad_skip)
    for each r in list of r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_b_int: rax a whole number, maybe below 0, its digits into the builder
    set positive to new_label(a)
    set digit_loop to new_label(a)
    set digits_out to new_label(a)
    mark(a, "rt_b_int")
    push_r(a, rbx)
    mov_rr(a, rbx, rax)
    test_rr(a, rbx, rbx)
    jcc(a, cc_ns, positive)
    movi(a, rax, 45)
    call_to(a, "rt_b_byte")
    unary(a, "neg", rbx)
    mark(a, positive)
    lea(a, rdi, rip_plus("dbuf", 32))
    mov_rr(a, rax, rbx)
    movi(a, rcx, 10)
    mark(a, digit_loop)
    movi(a, rdx, 0)
    unary(a, "div", rcx)
    alui(a, "add", rdx, 48)
    dec_r(a, rdi)
    store8(a, mem(rdi, 0), rdx)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, digit_loop)
    mov_rr(a, rsi, rdi)
    lea(a, rcx, rip_plus("dbuf", 32))
    alu(a, "sub", rcx, rdi)
    call_to(a, "rt_b_bytes")
    pop_r(a, rbx)
    ret(a)

    # rt_pad_text: the strokes as text, the playground's pad's way: points "x,y" split by spaces, strokes by ";"
    set text_loop to new_label(a)
    set text_done to new_label(a)
    set not_first to new_label(a)
    set put_point to new_label(a)
    mark(a, "rt_pad_text")
    push_r(a, rbx)
    push_r(a, r12)
    call_to(a, "rt_b_reset")
    movi(a, r12, 0)
    mark(a, text_loop)
    alu_load(a, "cmp", r12, rip("pad_n"))
    jcc(a, cc_ae, text_done)
    imul_ri(a, rbx, r12, 24)
    alu_load(a, "add", rbx, rip("pad_pts"))
    test_rr(a, r12, r12)
    jcc(a, cc_e, put_point)
    movi(a, rax, 32)
    load(a, rcx, mem(rbx, 16))
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, not_first)
    movi(a, rax, 59)
    mark(a, not_first)
    call_to(a, "rt_b_byte")
    mark(a, put_point)
    load(a, rax, mem(rbx, 0))
    call_to(a, "rt_b_int")
    movi(a, rax, 44)
    call_to(a, "rt_b_byte")
    load(a, rax, mem(rbx, 8))
    call_to(a, "rt_b_int")
    inc_r(a, r12)
    jmp_to(a, text_loop)
    mark(a, text_done)
    call_to(a, "rt_b_text")
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_wndproc: what Windows calls with what happened to the window: rcx the window, rdx what, r8 and r9
    # more about it. It keeps what Windows needs kept, the xmm registers from 6 on included.
    set w_paint to new_label(a)
    set w_erase to new_label(a)
    set w_close to new_label(a)
    set w_destroy to new_label(a)
    set w_timer to new_label(a)
    set w_key to new_label(a)
    set w_char to new_label(a)
    set w_down to new_label(a)
    set w_move to new_label(a)
    set w_up to new_label(a)
    set w_zero to new_label(a)
    set w_back to new_label(a)
    set w_redraw to new_label(a)
    mark(a, "rt_wndproc")
    push_r(a, rbp)
    mov_rr(a, rbp, rsp)
    for each r in list of rbx, rsi, rdi, r12, r13, r14, r15
        push_r(a, r)
    end
    alui(a, "sub", rsp, 168)
    for each k from 6 to 15
        movdqu_store(a, mem(rsp, 16 * (k - 6)), k)
    end
    mov_rr(a, rbx, rcx)
    mov_rr(a, r12, rdx)
    mov_rr(a, r13, r8)
    mov_rr(a, r14, r9)
    for each pair in list of (list of 0x000F, w_paint), (list of 0x0014, w_erase), (list of 0x0010, w_close),
        (list of 0x0002, w_destroy), (list of 0x0113, w_timer), (list of 0x0100, w_key), (list of 0x0102, w_char),
        (list of 0x0201, w_down), (list of 0x0200, w_move), (list of 0x0202, w_up)
        alui(a, "cmp", r12, item 1 of pair)
        jcc(a, cc_e, item 2 of pair)
    end
    win_enter(a) # anything else, as Windows does it
    mov_rr(a, rcx, rbx)
    mov_rr(a, rdx, r12)
    mov_rr(a, r8, r13)
    mov_rr(a, r9, r14)
    w_call(a, "DefWindowProcW")
    win_leave(a)
    jmp_to(a, w_back)
    mark(a, w_paint)
    mov_rr(a, rcx, rbx)
    call_to(a, "rt_paint")
    jmp_to(a, w_zero)
    mark(a, w_erase) # never wiped first: it's drawn whole
    movi(a, rax, 1)
    jmp_to(a, w_back)
    mark(a, w_close) # the pad, closed: no answer; the picture, closed: gone
    set close_picture to new_label(a)
    load(a, rax, rip("gui_mode"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, close_picture)
    storei(a, rip("gui_done"), 2)
    jmp_to(a, w_zero)
    mark(a, close_picture)
    win_enter(a)
    mov_rr(a, rcx, rbx)
    w_call(a, "DestroyWindow")
    win_leave(a)
    jmp_to(a, w_zero)
    mark(a, w_destroy)
    load(a, rax, rip("gui_mode"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, w_zero)
    storei(a, rip("gui_done"), 1)
    win_enter(a)
    movi(a, rcx, 0)
    w_call(a, "PostQuitMessage")
    win_leave(a)
    jmp_to(a, w_zero)
    mark(a, w_timer) # its handler: the timer's number is one more than its place
    mov_rr(a, r12, rbx)
    mov_rr(a, rbx, r13)
    dec_r(a, rbx)
    shifti(a, "shl", rbx, 5)
    alu_load(a, "add", rbx, rip("app_items"))
    call_to(a, "rt_app_call")
    mov_rr(a, rbx, r12)
    jmp_to(a, w_redraw)
    mark(a, w_key)
    set key_app to new_label(a)
    set key_found to new_label(a)
    set key_none to new_label(a)
    set key_names_loop to new_label(a)
    load(a, rax, rip("gui_mode"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, key_app)
    alui(a, "cmp", r13, 0x0D) # the pad: Enter answers, Escape wipes it
    set pad_not_enter to new_label(a)
    jcc(a, cc_ne, pad_not_enter)
    storei(a, rip("gui_done"), 1)
    jmp_to(a, w_zero)
    mark(a, pad_not_enter)
    alui(a, "cmp", r13, 0x1B)
    jcc(a, cc_ne, w_zero)
    storei(a, rip("pad_n"), 0)
    storei(a, rip("pad_down"), 0) # and a stroke going on stops, as the playground's does
    jmp_to(a, w_redraw)
    mark(a, key_app)
    win_enter(a) # not with Ctrl or Alt, as the playground has it
    movi(a, rcx, 0x11)
    w_call(a, "GetKeyState")
    win_leave(a)
    alui(a, "and", rax, 0x8000)
    jcc(a, cc_ne, w_zero)
    lea(a, rsi, rip("gui_keys"))
    movi(a, rcx, length of gui_key_names / 2)
    mark(a, key_names_loop)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, key_none)
    alu_load(a, "cmp", r13, mem(rsi, 0))
    jcc(a, cc_e, key_found)
    alui(a, "add", rsi, 16)
    dec_r(a, rcx)
    jmp_to(a, key_names_loop)
    mark(a, key_found)
    load(a, rax, rip("app_n"))
    test_rr(a, rax, rax)
    set key_send to new_label(a)
    jcc(a, cc_ne, key_send)
    alui(a, "cmp", r13, 0x1B) # a picture, not an app: Escape closes it
    jcc(a, cc_ne, w_zero)
    jmp_to(a, close_picture)
    mark(a, key_send)
    load(a, rax, mem(rsi, 8))
    movi64(a, rcx, tag_text)
    alu(a, "or", rax, rcx)
    store(a, rip("ev_a"), rax)
    movi(a, rcx, 0)
    call_to(a, "rt_app_send")
    jmp_to(a, w_redraw)
    mark(a, key_none)
    jmp_to(a, w_zero)
    mark(a, w_char) # a character: lower case, unless it's one of those above, or with Ctrl
    load(a, rax, rip("gui_mode"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, w_zero)
    alui(a, "cmp", r13, 0x20)
    jcc(a, cc_be, w_zero)
    alui(a, "cmp", r13, 0x7F)
    jcc(a, cc_e, w_zero)
    mov_rr(a, rax, r13)
    alui(a, "and", rax, 0xF800)
    alui(a, "cmp", rax, 0xD800)
    jcc(a, cc_e, w_zero)
    win_enter(a)
    movi(a, rcx, 0x11)
    w_call(a, "GetKeyState")
    win_leave(a)
    alui(a, "and", rax, 0x8000)
    jcc(a, cc_ne, w_zero)
    win_enter(a)
    mov_rr(a, rcx, r13)
    w_call(a, "CharLowerW")
    win_leave(a)
    alui(a, "and", rax, 0xFFFF)
    call_to(a, "rt_b_reset")
    call_to(a, "rt_b_code")
    call_to(a, "rt_b_text")
    store(a, rip("ev_a"), rax)
    movi(a, rcx, 0)
    call_to(a, "rt_app_send")
    jmp_to(a, w_redraw)
    mark(a, w_down)
    win_enter(a)
    mov_rr(a, rcx, rbx)
    w_call(a, "SetCapture")
    win_leave(a)
    movsx16(a, rcx, r14)
    mov_rr(a, rdx, r14)
    shifti(a, "shr", rdx, 16)
    movsx16(a, rdx, rdx)
    load(a, rax, rip("gui_mode"))
    test_rr(a, rax, rax)
    set down_app to new_label(a)
    jcc(a, cc_e, down_app)
    storei(a, rip("pad_down"), 1)
    movi(a, r8, 1)
    call_to(a, "rt_pad_point")
    jmp_to(a, w_redraw)
    mark(a, down_app)
    call_to(a, "rt_ev_spot")
    movi(a, rcx, 1)
    call_to(a, "rt_app_send")
    jmp_to(a, w_redraw)
    mark(a, w_move) # with the button down: a drag, or more of a stroke
    mov_rr(a, rax, r13)
    alui(a, "and", rax, 1)
    jcc(a, cc_e, w_zero)
    movsx16(a, rcx, r14)
    mov_rr(a, rdx, r14)
    shifti(a, "shr", rdx, 16)
    movsx16(a, rdx, rdx)
    load(a, rax, rip("gui_mode"))
    test_rr(a, rax, rax)
    set move_app to new_label(a)
    jcc(a, cc_e, move_app)
    load(a, rax, rip("pad_down"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, w_zero)
    movi(a, r8, 0)
    call_to(a, "rt_pad_point")
    jmp_to(a, w_redraw)
    mark(a, move_app)
    call_to(a, "rt_ev_spot")
    movi(a, rcx, 2)
    call_to(a, "rt_app_send")
    jmp_to(a, w_redraw)
    mark(a, w_up)
    storei(a, rip("pad_down"), 0)
    win_enter(a)
    w_call(a, "ReleaseCapture")
    win_leave(a)
    jmp_to(a, w_zero)
    mark(a, w_redraw) # what happened may have drawn something: the window, drawn again
    win_enter(a)
    mov_rr(a, rcx, rbx)
    movi(a, rdx, 0)
    movi(a, r8, 0)
    w_call(a, "InvalidateRect")
    win_leave(a)
    mark(a, w_zero)
    movi(a, rax, 0)
    mark(a, w_back)
    for each k from 6 to 15
        movdqu_load(a, k, mem(rsp, 16 * (k - 6)))
    end
    alui(a, "add", rsp, 168)
    for each r in list of r15, r14, r13, r12, rdi, rsi, rbx
        pop_r(a, r)
    end
    pop_r(a, rbp)
    ret(a)

    # rt_headless: MOTH_PICTURE named a file: the events MOTH_EVENTS lists, then the picture, into that file
    # as a BMP, 500 by 500
    set ev_loop to new_label(a)
    set ev_done to new_label(a)
    set ev_click to new_label(a)
    set ev_drag to new_label(a)
    set ev_tick to new_label(a)
    set ev_key to new_label(a)
    set ev_skip to new_label(a)
    mark(a, "rt_headless")
    for each r in list of rbx, r12, r13, r14, r15
        push_r(a, r)
    end
    call_to(a, "rt_gui_start")
    win_enter(a)
    lea(a, rcx, rip(events_env))
    lea(a, rdx, rip("gui_events"))
    movi(a, r8, 4096)
    w_call(a, "GetEnvironmentVariableW")
    win_leave(a)
    mov32_rr(a, r13, rax) # how many UTF-16 units: each, taken as a byte; none if too many to fit
    set events_fit to new_label(a)
    alui(a, "cmp", r13, 4096)
    jcc(a, cc_b, events_fit)
    movi(a, r13, 0)
    mark(a, events_fit)
    lea(a, r12, rip("gui_events"))
    alu(a, "add", r13, r13)
    alu(a, "add", r13, r12)
    mark(a, ev_loop)
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, ev_done)
    load16(a, rax, mem(r12, 0))
    alui(a, "cmp", rax, 32)
    jcc(a, cc_e, ev_skip)
    alui(a, "cmp", rax, 59)
    jcc(a, cc_e, ev_skip)
    mov_rr(a, r15, rax) # what it is, by its first letter: k, c, d or t
    mark(a, "rt_ev_word")
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, ev_done)
    load16(a, rax, mem(r12, 0))
    alui(a, "cmp", rax, 32)
    set word_over to new_label(a)
    jcc(a, cc_e, word_over)
    alui(a, "add", r12, 2)
    jmp_to(a, "rt_ev_word")
    mark(a, word_over)
    alui(a, "add", r12, 2)
    alui(a, "cmp", r15, 107) # k
    jcc(a, cc_e, ev_key)
    call_to(a, "rt_ev_int")
    mov_rr(a, r14, rax)
    alui(a, "cmp", r15, 116) # t
    jcc(a, cc_e, ev_tick)
    call_to(a, "rt_ev_int")
    mov_rr(a, rdx, rax)
    mov_rr(a, rcx, r14)
    alui(a, "add", rcx, 250) # the numbers are the picture's own: as a point in the window
    movi(a, rax, 250)
    alu(a, "sub", rax, rdx)
    mov_rr(a, rdx, rax)
    call_to(a, "rt_ev_spot")
    movi(a, rcx, 1)
    alui(a, "cmp", r15, 99) # c
    jcc(a, cc_e, ev_click)
    movi(a, rcx, 2)
    mark(a, ev_click)
    call_to(a, "rt_app_send")
    jmp_to(a, ev_loop)
    mark(a, ev_tick)
    mov_rr(a, rcx, r14)
    call_to(a, "rt_app_tick")
    jmp_to(a, ev_loop)
    mark(a, ev_key) # the key's name, up to the next ;
    call_to(a, "rt_b_reset")
    set key_chars to new_label(a)
    set key_over to new_label(a)
    mark(a, key_chars)
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, key_over)
    load16(a, rax, mem(r12, 0))
    alui(a, "cmp", rax, 59)
    jcc(a, cc_e, key_over)
    call_to(a, "rt_b_byte")
    alui(a, "add", r12, 2)
    jmp_to(a, key_chars)
    mark(a, key_over)
    call_to(a, "rt_b_text")
    store(a, rip("ev_a"), rax)
    movi(a, rcx, 0)
    call_to(a, "rt_app_send")
    jmp_to(a, ev_loop)
    mark(a, ev_skip)
    alui(a, "add", r12, 2)
    jmp_to(a, ev_loop)
    mark(a, ev_done)
    win_enter(a) # the picture, drawn into memory
    movi(a, rcx, 0)
    w_call(a, "CreateCompatibleDC")
    mov_rr(a, r12, rax)
    storei(a, rip("gui_bmi"), 40)
    movi(a, rax, 500)
    store32(a, rip_plus("gui_bmi", 4), rax)
    movi(a, rax, -500) # from the top down
    store32(a, rip_plus("gui_bmi", 8), rax)
    movi(a, rax, 0x00200001) # one plane, 32 bits a pixel
    store32(a, rip_plus("gui_bmi", 12), rax)
    mov_rr(a, rcx, r12)
    lea(a, rdx, rip("gui_bmi"))
    movi(a, r8, 0)
    lea(a, r9, rip("gui_bits"))
    storei(a, arg_at(5), 0)
    storei(a, arg_at(6), 0)
    w_call(a, "CreateDIBSection")
    mov_rr(a, r13, rax)
    mov_rr(a, rcx, r12)
    mov_rr(a, rdx, r13)
    w_call(a, "SelectObject")
    mov_rr(a, rcx, r12)
    lea(a, rdx, rip("gui_graphics"))
    w_call(a, "GdipCreateFromHDC")
    storei(a, rip("gui_mode"), 0)
    storei(a, rip("gui_size"), 500)
    load(a, rcx, rip("gui_graphics"))
    call_to(a, "rt_render_picture")
    load(a, rcx, rip("gui_graphics"))
    w_call(a, "GdipDeleteGraphics")
    w_call(a, "GdiFlush")
    lea(a, rcx, rip("gui_path")) # and into the file
    movi(a, rdx, 0x40000000)
    movi(a, r8, 0)
    movi(a, r9, 0)
    storei(a, arg_at(5), 2)
    storei(a, arg_at(6), 0x80)
    storei(a, arg_at(7), 0)
    w_call(a, "CreateFileW")
    mov_rr(a, r14, rax)
    movi(a, rax, 0x4D42) # BM, its size, and where the pixels start
    store(a, rip("gui_head"), rax)
    movi(a, rax, 54 + 1000000)
    store32(a, rip_plus("gui_head", 2), rax)
    storei(a, rip_plus("gui_head", 6), 0)
    movi(a, rax, 54)
    store32(a, rip_plus("gui_head", 10), rax)
    for each part in list of (list of "gui_head", 14), (list of "gui_bmi", 40), (list of "", 1000000)
        mov_rr(a, rcx, r14)
        if item 1 of part is ""
            load(a, rdx, rip("gui_bits"))
        else
            lea(a, rdx, rip(item 1 of part))
        end
        movi(a, r8, item 2 of part)
        lea(a, r9, rip("gui_t0"))
        storei(a, arg_at(5), 0)
        w_call(a, "WriteFile")
    end
    mov_rr(a, rcx, r14)
    w_call(a, "CloseHandle")
    win_leave(a)
    for each r in list of r15, r14, r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_ev_int: a whole number, maybe with a minus, from r12 (UTF-16) on, up to a space or ;: in rax
    set int_loop to new_label(a)
    set int_done to new_label(a)
    set int_plus to new_label(a)
    mark(a, "rt_ev_int")
    movi(a, rax, 0)
    movi(a, rcx, 0)
    load16(a, rdx, mem(r12, 0))
    alui(a, "cmp", rdx, 45)
    jcc(a, cc_ne, int_loop)
    movi(a, rcx, 1)
    alui(a, "add", r12, 2)
    mark(a, int_loop)
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, int_done)
    load16(a, rdx, mem(r12, 0))
    alui(a, "sub", rdx, 48)
    alui(a, "cmp", rdx, 9)
    jcc(a, cc_a, int_done)
    imul_ri(a, rax, rax, 10)
    alu(a, "add", rax, rdx)
    alui(a, "add", r12, 2)
    jmp_to(a, int_loop)
    mark(a, int_done)
    alui(a, "add", r12, 2)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, int_plus)
    unary(a, "neg", rax)
    mark(a, int_plus)
    ret(a)

    # rt_gui_finish: the program has ended: MOTH_PICTURE, or at a terminal a window for what it drew or the
    # app it set up, until it's closed
    set finished to new_label(a)
    set timers_loop to new_label(a)
    set timers_next to new_label(a)
    set timers_done to new_label(a)
    set faster to new_label(a)
    mark(a, "rt_gui_finish")
    for each r in list of rbx, r12
        push_r(a, r)
    end
    win_enter(a)
    lea(a, rcx, rip(picture_env))
    lea(a, rdx, rip("gui_path"))
    movi(a, r8, 1024)
    w_call(a, "GetEnvironmentVariableW")
    win_leave(a)
    mov32_rr(a, rax, rax)
    test_rr(a, rax, rax)
    set no_file to new_label(a)
    jcc(a, cc_e, no_file)
    alui(a, "cmp", rax, 1024)
    jcc(a, cc_ae, no_file)
    call_to(a, "rt_headless")
    jmp_to(a, finished)
    mark(a, no_file)
    load32(a, rax, rip("out_tty"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, finished)
    load(a, rax, rip("pic_n"))
    alu_load(a, "or", rax, rip("app_n"))
    jcc(a, cc_e, finished)
    movi(a, rcx, 0)
    movi(a, rdx, 500)
    lea(a, r8, rip(picture_title))
    call_to(a, "rt_window_open")
    movi(a, r12, 0) # each timer, every so many milliseconds, 10 at the fastest
    mark(a, timers_loop)
    alu_load(a, "cmp", r12, rip("app_n"))
    jcc(a, cc_ae, timers_done)
    mov_rr(a, rbx, r12)
    shifti(a, "shl", rbx, 5)
    alu_load(a, "add", rbx, rip("app_items"))
    load(a, rax, mem(rbx, 0))
    alui(a, "cmp", rax, 3)
    jcc(a, cc_ne, timers_next)
    movsd_load(a, xmm0, mem(rbx, 24))
    cvttsd2si(a, r8, xmm0)
    alui(a, "cmp", r8, 10)
    jcc(a, cc_ge, faster)
    movi(a, r8, 10)
    mark(a, faster)
    win_enter(a)
    load(a, rcx, rip("gui_hwnd"))
    lea(a, rdx, mem(r12, 1))
    movi(a, r9, 0)
    w_call(a, "SetTimer")
    win_leave(a)
    mark(a, timers_next)
    inc_r(a, r12)
    jmp_to(a, timers_loop)
    mark(a, timers_done)
    call_to(a, "rt_gui_loop")
    mark(a, finished)
    for each r in list of r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_pad_hook: xmm0 a question: if it starts with "Draw" and a person at a terminal is asked, the pad,
    # with rax 1 and the drawing in xmm0, as text; else rax 0 and nothing changes
    set not_pad to new_label(a)
    set skip_spaces to new_label(a)
    set spaced to new_label(a)
    set word_end to new_label(a)
    set is_pad to new_label(a)
    mark(a, "rt_pad_hook")
    movq_rx(a, rax, xmm0)
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 48)
    alui(a, "cmp", rcx, kind_text)
    jcc(a, cc_ne, not_pad)
    untag(a, rax)
    load(a, rsi, mem(rax, 16))
    load(a, rcx, mem(rax, 0))
    mark(a, skip_spaces)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, not_pad)
    load8(a, rax, mem(rsi, 0))
    alui(a, "cmp", rax, 32)
    jcc(a, cc_e, spaced)
    alui(a, "sub", rax, 9) # a tab to a carriage return
    alui(a, "cmp", rax, 4)
    jcc(a, cc_a, word_end)
    mark(a, spaced)
    inc_r(a, rsi)
    dec_r(a, rcx)
    jmp_to(a, skip_spaces)
    mark(a, word_end) # "draw", in any case, then not a letter, a digit or _
    alui(a, "cmp", rcx, 4)
    jcc(a, cc_b, not_pad)
    for each k from 0 to 3
        load8(a, rax, mem(rsi, k))
        alui(a, "or", rax, 32)
        alui(a, "cmp", rax, item (k + 1) of (list of 100, 114, 97, 119))
        jcc(a, cc_ne, not_pad)
    end
    alui(a, "cmp", rcx, 4)
    jcc(a, cc_e, is_pad)
    load8(a, rax, mem(rsi, 4))
    alui(a, "cmp", rax, 95)
    jcc(a, cc_e, not_pad)
    alui(a, "cmp", rax, 128)
    jcc(a, cc_ae, is_pad)
    set letter_test to new_label(a)
    mov_rr(a, rdx, rax)
    alui(a, "sub", rdx, 48)
    alui(a, "cmp", rdx, 9)
    jcc(a, cc_be, not_pad)
    alui(a, "or", rax, 32)
    alui(a, "sub", rax, 97)
    alui(a, "cmp", rax, 25)
    jcc(a, cc_be, not_pad)
    mark(a, is_pad)
    movsd_store(a, rip("pad_q"), xmm0)
    call_to(a, "rt_in_setup")
    set no_person to new_label(a)
    load(a, rax, rip("in_tty"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, no_person)
    push_r(a, rbx)
    call_to(a, "rt_b_reset") # the question, and a space, as asking shows it
    load(a, rax, rip("pad_q"))
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    movi(a, rax, 32)
    call_to(a, "rt_b_byte")
    load(a, rsi, rip("b_ptr"))
    load(a, rcx, rip("b_len"))
    call_to(a, "rt_out_text")
    call_to(a, "rt_flush_out")
    win_enter(a) # the question, without the space, as the pad's title
    movi(a, rcx, 65001)
    movi(a, rdx, 0)
    load(a, r8, rip("b_ptr"))
    load(a, r9, rip("b_len"))
    dec_r(a, r9)
    lea(a, rax, rip("gui_title"))
    store(a, arg_at(5), rax)
    storei(a, arg_at(6), 1023)
    w_call(a, "MultiByteToWideChar")
    win_leave(a)
    lea(a, rcx, rip("gui_title"))
    mov32_rr(a, rax, rax)
    alu(a, "add", rax, rax)
    alu(a, "add", rcx, rax)
    storei(a, mem(rcx, 0), 0)
    storei(a, rip("pad_n"), 0)
    storei(a, rip("pad_down"), 0)
    movi(a, rcx, 1)
    movi(a, rdx, 440)
    lea(a, r8, rip("gui_title"))
    call_to(a, "rt_window_open")
    call_to(a, "rt_gui_loop")
    load(a, rax, rip("gui_done"))
    alui(a, "cmp", rax, 1)
    set pad_answered to new_label(a)
    jcc(a, cc_e, pad_answered)
    call_to(a, "rt_out_line") # closed: the program ends
    call_to(a, "rt_flush_out")
    movi(a, rcx, 0)
    jmp_to(a, "rt_exit")
    mark(a, pad_answered)
    call_to(a, "rt_pad_text")
    mov_rr(a, rbx, rax)
    win_enter(a)
    load(a, rcx, rip("gui_hwnd"))
    w_call(a, "DestroyWindow")
    win_leave(a)
    point_at_text(a, "(a drawing)")
    call_to(a, "rt_out_text")
    call_to(a, "rt_out_line")
    movq_xr(a, xmm0, rbx)
    pop_r(a, rbx)
    movi(a, rax, 1)
    ret(a)
    mark(a, no_person) # input from a file or a pipe: asked as any question is
    movsd_load(a, xmm0, rip("pad_q"))
    mark(a, not_pad)
    movi(a, rax, 0)
    ret(a)
end

# the names keys have, by their codes, as a table: each code, then its name as a value
to emit_gui_keys with a
    set ro to rodata of a
    set labels to empty list
    set k to 2
    repeat while k is at most length of gui_key_names
        add text_object(a, item k of gui_key_names) to labels
        set k to k + 2
    end
    pad_to(ro, 8)
    rodata_here(a, "gui_keys")
    set k to 1
    set j to 1
    repeat while k is at most length of gui_key_names
        put64(ro, item k of gui_key_names)
        absolute(a, "rodata", length of ro, item j of labels, 0)
        put64(ro, 0)
        set k to k + 2
        add 1 to j
    end
end

# whether a question asks for a drawing, as the playground decides it: "draw" first, after any spaces, in any
# case, and as a word of its own
to asks_drawing with question
    set k to 1
    repeat while k is at most length of question
        set c to code_point(item k of question)
        if c is not 32 and (c is less than 9 or c is greater than 13)
            stop
        end
        set k to k + 1
    end
    for each wanted in list of 100, 114, 97, 119
        if k is greater than length of question
            return no
        end
        set c to code_point(item k of question)
        if c is at least 65 and c is at most 90
            set c to c + 32
        end
        if c is not wanted
            return no
        end
        set k to k + 1
    end
    if k is greater than length of question
        return yes
    end
    set c to code_point(item k of question)
    if c is 95 or (c is at least 48 and c is at most 57)
        return no
    end
    if (c is at least 97 and c is at most 122) or (c is at least 65 and c is at most 90)
        return no
    end
    return yes
end

# ---------- the runtime: the system ----------
# rt_write (rdi: 1 for the output, 2 for mistakes; rsi and rdx: the bytes) and rt_exit (rcx: the exit
# code), and where the program starts: on Windows through kernel32.dll, on Linux by system calls.

to emit_windows with a
    mark(a, "start")
    alui(a, "sub", rsp, 40)
    movi(a, rcx, -11)
    call_import(a, "imp_GetStdHandle")
    store(a, rip("out_handle"), rax)
    mov_rr(a, rcx, rax)
    lea(a, rdx, rip("scratch"))
    call_import(a, "imp_GetConsoleMode")
    store32(a, rip("out_tty"), rax)
    movi(a, rcx, -12)
    call_import(a, "imp_GetStdHandle")
    store(a, rip("err_handle"), rax)
    mov_rr(a, rcx, rax)
    lea(a, rdx, rip("scratch"))
    call_import(a, "imp_GetConsoleMode")
    store32(a, rip("err_tty"), rax)
    alui(a, "add", rsp, 40)
    jmp_to(a, "rt_begin")

    mark(a, "rt_exit")
    alui(a, "and", rsp, -16)
    alui(a, "sub", rsp, 32)
    call_import(a, "imp_ExitProcess")

    set chosen to new_label(a)
    set files to new_label(a)
    set console to new_label(a)
    set piece to new_label(a)
    set back to new_label(a)
    set whole_piece to new_label(a)
    set units to new_label(a)
    set next_piece to new_label(a)
    set done to new_label(a)
    mark(a, "rt_write")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    push_r(a, rsi)
    push_r(a, rdi)
    push_r(a, rbp)
    mov_rr(a, rbp, rsp)
    alui(a, "and", rsp, -16)
    alui(a, "sub", rsp, 64)
    mov_rr(a, r12, rsi)
    mov_rr(a, r13, rdx)
    load(a, rbx, rip("out_handle"))
    load32(a, r14, rip("out_tty"))
    alui(a, "cmp", rdi, 1)
    jcc(a, cc_e, chosen)
    load(a, rbx, rip("err_handle"))
    load32(a, r14, rip("err_tty"))
    mark(a, chosen)
    test_rr(a, r14, r14)
    jcc(a, cc_ne, console)
    mark(a, files) # a file or a pipe: the bytes as they are
    test_rr(a, r13, r13)
    jcc(a, cc_e, done)
    mov_rr(a, rcx, rbx)
    mov_rr(a, rdx, r12)
    mov_rr(a, r8, r13)
    lea(a, r9, mem(rsp, 48))
    storei(a, mem(rsp, 32), 0)
    call_import(a, "imp_WriteFile")
    test32(a, rax)
    jcc(a, cc_e, done)
    load32(a, rax, mem(rsp, 48))
    test_rr(a, rax, rax)
    jcc(a, cc_e, done)
    alu(a, "add", r12, rax)
    alu(a, "sub", r13, rax)
    jmp_to(a, files)
    mark(a, console) # a console: as UTF-16, so every character shows, 8 KB at a time
    mark(a, piece)
    test_rr(a, r13, r13)
    jcc(a, cc_e, done)
    mov_rr(a, r14, r13)
    alui(a, "cmp", r14, 8192)
    jcc(a, cc_be, whole_piece)
    movi(a, r14, 8192)
    mark(a, back) # not in the middle of a character
    mov_rr(a, rax, r12)
    alu(a, "add", rax, r14)
    load8(a, rax, mem(rax, 0))
    alui(a, "and", rax, 0xC0)
    alui(a, "cmp", rax, 0x80)
    jcc(a, cc_ne, whole_piece)
    dec_r(a, r14)
    jmp_to(a, back)
    mark(a, whole_piece)
    movi(a, rcx, 65001)
    movi(a, rdx, 0)
    mov_rr(a, r8, r12)
    mov_rr(a, r9, r14)
    lea(a, rax, rip("wbuf"))
    store(a, mem(rsp, 32), rax)
    storei(a, mem(rsp, 40), wide_cap)
    call_import(a, "imp_MultiByteToWideChar")
    mov32_rr(a, rdi, rax)
    lea(a, rsi, rip("wbuf"))
    mark(a, units)
    test_rr(a, rdi, rdi)
    jcc(a, cc_e, next_piece)
    mov_rr(a, rcx, rbx)
    mov_rr(a, rdx, rsi)
    mov_rr(a, r8, rdi)
    lea(a, r9, mem(rsp, 48))
    storei(a, mem(rsp, 32), 0)
    call_import(a, "imp_WriteConsoleW")
    test32(a, rax)
    jcc(a, cc_e, done)
    load32(a, rax, mem(rsp, 48))
    test_rr(a, rax, rax)
    jcc(a, cc_e, done)
    alu(a, "sub", rdi, rax)
    alu(a, "add", rax, rax)
    alu(a, "add", rsi, rax)
    jmp_to(a, units)
    mark(a, next_piece)
    alu(a, "add", r12, r14)
    alu(a, "sub", r13, r14)
    jmp_to(a, piece)
    mark(a, done)
    mov_rr(a, rsp, rbp)
    pop_r(a, rbp)
    pop_r(a, rdi)
    pop_r(a, rsi)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
end

to emit_linux with a
    mark(a, "start")
    load(a, rcx, mem(rsp, 0)) # what it was started with, for `arguments`, and its environment, for `run program`
    store(a, rip("arg_count"), rcx)
    lea(a, rax, mem(rsp, 8))
    store(a, rip("arg_vector"), rax)
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rax, rcx)
    alui(a, "add", rax, 8)
    store(a, rip("env_vector"), rax)
    lea(a, rsp, rip_plus("stack", stack_size))
    for each stream in list of 1, 2 # a terminal answers TCGETS
        movi(a, rdi, stream)
        movi(a, rsi, 0x5401)
        lea(a, rdx, rip("scratch"))
        movi(a, rax, 16)
        raw(a, list of 0x0F, 0x05)
        test_rr(a, rax, rax)
        setcc(a, cc_e, rax)
        movzx8(a, rax, rax)
        if stream is 1
            store(a, rip("out_tty"), rax)
        else
            store(a, rip("err_tty"), rax)
        end
    end
    jmp_to(a, "rt_begin")

    mark(a, "rt_exit")
    mov_rr(a, rdi, rcx)
    movi(a, rax, 231)
    raw(a, list of 0x0F, 0x05)

    set again to new_label(a)
    set failed to new_label(a)
    set done to new_label(a)
    mark(a, "rt_write")
    mark(a, again)
    test_rr(a, rdx, rdx)
    jcc(a, cc_e, done)
    movi(a, rax, 1)
    raw(a, list of 0x0F, 0x05)
    test_rr(a, rax, rax)
    jcc(a, cc_s, failed)
    alu(a, "add", rsi, rax)
    alu(a, "sub", rdx, rax)
    jmp_to(a, again)
    mark(a, failed)
    alui(a, "cmp", rax, -4) # interrupted, or an output that can't take more just now: again
    jcc(a, cc_e, again)
    alui(a, "cmp", rax, -11)
    jcc(a, cc_e, again)
    mark(a, done)
    ret(a)
end

to emit_runtime with st
    set a to a of st
    set windowed to no
    if target of st is "windows"
        set windowed to uses_drawing of st or uses_app of st or uses_pad of st
    end
    set pad of a to windowed and uses_pad of st
    mark(a, "rt_begin")
    call_to(a, "rt_gc_init")
    if uses_drawing of st or uses_app of st
        call_to(a, "rt_turtle_init")
    end
    store(a, rip("stack_top"), rsp)
    movi(a, r15, 0)
    call_to(a, "moth_main")
    movi(a, rcx, 0)
    mark(a, "rt_finish") # rcx: the number the program ends with, once what it said and drew has gone out
    push_r(a, rcx)
    call_to(a, "rt_flush_out")
    if windowed
        call_to(a, "rt_gui_finish")
        call_to(a, "rt_flush_out")
    end
    pop_r(a, rcx)
    jmp_to(a, "rt_exit")
    emit_output(a)
    emit_numbers(a)
    emit_bignums(a)
    emit_compares(a)
    emit_mistakes(a)
    emit_memory(a, target of st)
    emit_builder(a)
    emit_sequences(a)
    emit_records(a)
    emit_builtins(a)
    emit_functions(a)
    emit_files(a, target of st, allowed of st)
    emit_gc_tables(a)
    if uses_case of st or windowed
        emit_cases(a)
    end
    if uses_drawing of st or uses_app of st
        emit_turtle(a)
    end
    if uses_app of st
        emit_app_setup(a)
    end
    if windowed
        emit_gui(a, name of st)
        emit_gui_keys(a)
        set more_imports of a to gui_imports
    end
    set ro to rodata of a # 10^0 to 10^22, which doubles hold exactly
    pad_to(ro, 8)
    rodata_here(a, "pow10")
    set power to 1
    repeat 23 times
        put_all(ro, double_bytes(power))
        set power to power * 10
    end
    if target of st is "windows"
        emit_windows(a)
        reserve(a, "wbuf", 2 * wide_cap, 16)
    else
        emit_linux(a)
        reserve(a, "stack", stack_size, 16)
    end
    reserve(a, "out_buf", out_cap, 16)
    for each name in list of "gc_base", "gc_abits", "gc_mbits", "gc_info", "gc_marks", "gc_marks_end", "gc_pages",
        "gc_committed", "gc_since", "gc_threshold", "gc_live", "gc_runs", "stack_top"
        reserve(a, name, 8, 8)
    end
    reserve(a, "gc_free", 16 * length of gc_sizes, 8)
    if windowed # the window's own, which are never values
        for each name in list of "gui_scale", "gui_argb", "gui_last", "gui_brush", "gui_pen", "gui_half", "gui_t0",
            "gui_t1", "gui_font", "gui_family", "gui_units", "gui_ascent", "gui_format", "gui_started", "gui_token",
            "gui_hinst", "gui_mode", "gui_size", "gui_done", "gui_hwnd", "gui_old", "gui_graphics", "gui_bits",
            "pad_n", "pad_cap", "pad_down"
            reserve(a, name, 8, 8)
        end
        for each pair in list of (list of "gui_input", 24), (list of "gui_rectf", 16), (list of "gui_wc", 80),
            (list of "gui_rect", 16), (list of "gui_msg", 48), (list of "gui_ps", 72), (list of "gui_bmi", 48),
            (list of "gui_head", 16), (list of "gui_events", 8200), (list of "gui_path", 2056), (list of "gui_title", 2056)
            reserve(a, item 1 of pair, item 2 of pair, 16)
        end
    end
    reserve(a, "gc_roots_from", 0, 8) # where the collector looks for values among the runtime's own
    for each name in list of "t_x", "t_y", "t_nx", "t_ny", "t_heading", "t_pen", "t_color", "t_width", "t_steps", "t_angle",
        "t_cos", "t_sin", "t_list", "tn0", "tn1", "tn2", "tn3", "pi_kind", "pi_a", "pi_b", "pi_c", "pi_d", "pi_w", "pi_text",
        "pic_items", "pic_n", "pic_cap", "app_items", "app_n", "app_cap", "ev_ms"
        reserve(a, name, 8, 8)
    end
    if windowed
        for each name in list of "ev_a", "ev_b", "pad_q", "pad_pts"
            reserve(a, name, 8, 8)
        end
    end
    for each name in list of "out_len", "out_tty", "err_tty", "out_handle", "err_handle", "err_site", "err_a", "err_b",
        "err_why", "err_len", "o_a", "o_b", "o_ma", "o_na", "t_prev",
        "b_ptr", "b_len", "b_cap", "showing", "comparing", "j_a", "j_b", "keep", "err_field", "seq_writing",
        "found_entry", "keep2", "try_top", "fail_has", "fail_val", "reason_at", "err_what", "split_list", "pn_start", "pn_e10", "pn_digits", "x87_cw",
        "x87_tmp", "err_got", "err_kind", "t_prev_fn", "cd_x", "cl_a", "cl_b", "cl_n", "cl_m", "cl_w", "cl_d",
        "err_file", "err_reason", "asked"
        reserve(a, name, 8, 8)
    end
    reserve(a, "scratch", 64, 16)
    reserve(a, "gc_roots_to", 0, 8)
    reserve(a, "dbuf", 64, 16)
    for each name in list of "big_r", "big_s", "big_mp", "big_mm", "big_t", "big_n"
        reserve(a, name, 8 * limbs, 16)
    end
    # where each call is, each function's name and its description, and what an input can say it is: texts
    # first, then tables of where they are
    set call_texts to empty list
    for each c in calls of st
        add text_object(a, c) to call_texts
    end
    set fn_texts to empty list
    set param_texts to empty list
    for each f in all_fns of st
        add text_object(a, name of f) to fn_texts
        set names to empty list
        for each p in params of f
            add text_object(a, p) to names
        end
        add names to param_texts
    end
    set phrases to empty list
    for each phrase in kind_names
        add text_object(a, phrase) to phrases
    end
    set ro to rodata of a
    pad_to(ro, 8)
    table_of_texts(a, "site_table", call_texts)
    table_of_texts(a, "fn_names", fn_texts)
    table_of_texts(a, "kind_phrase_table", phrases)
    rodata_here(a, "kind_tag_table")
    for each tag in kind_tags
        put64(ro, tag)
    end
    set k to 0
    for each f in all_fns of st # how many inputs, the name, then for each input what it is and its name
        add 1 to k
        rodata_here(a, info of f)
        put64(ro, length of params of f)
        absolute(a, "rodata", length of ro, item k of fn_texts, 0)
        put64(ro, 0)
        set i to 0
        for each p in params of f
            add 1 to i
            set kind to -1
            if i is at most length of kinds of f
                set kind to item i of kinds of f
            end
            set eight to empty list
            put32(eight, kind)
            set high to 0
            if kind is less than 0
                set high to -1
            end
            put32(eight, high)
            put_all(ro, eight)
            absolute(a, "rodata", length of ro, item i of item k of param_texts, 0)
            put64(ro, 0)
        end
    end
end

# a table, called `name`, of where these texts are
to table_of_texts with a, name, labels
    set ro to rodata of a
    rodata_here(a, name)
    for each label in labels
        absolute(a, "rodata", length of ro, label, 0)
        put64(ro, 0)
    end
end

# ---------- the runtime: files, arguments and asking ----------
# `read`, `write`, `ask` and `arguments`, as a program `moth-native build --exe` made has them (moth-native was
# Moth's Rust engine, until 1.5: what it did is kept here, down to its words). A file is read
# or written, or a site read, only once the program may: the --allow flags it was built with say what it may
# do without asking (allow_all: 1 to read, 2 to write and 4 to go online, added up), and otherwise a person at
# a terminal is asked, once for each file or site, or for all of them with 'a'; anywhere else the answer is
# no. Machine code can't go online yet, so a site it may read can't be reached. The input comes a line at a
# time through in_buf, which keeps what came after a line for the next one. What went wrong is in err_why,
# with the file's name in err_file and why in err_reason, both as text.

set file_imports to list of "ReadFile", "ReadConsoleW", "CreateFileW", "CloseHandle", "GetLastError", "GetFileAttributesW",
    "GetCommandLineW", "WideCharToMultiByte", "FormatMessageW", "GetFullPathNameW",
    "GetFinalPathNameByHandleW", "DeleteFileW", "CreateProcessW", "WaitForSingleObject", "GetExitCodeProcess"
set in_size to 4096 # bytes of input read at a time
# for each kind of thing a program may do (read a file, write one, go online, start a program): how a
# question puts it, and how a refusal puts it
set permission_words to list of (list of "read", "this program isn't allowed to read files (start it with --allow-read)"),
    (list of "write", "this program isn't allowed to write files (start it with --allow-write)"),
    (list of "go online to", "this program isn't allowed to go online (start it with --allow-net)"),
    (list of "run", "this program isn't allowed to start programs (start it with --allow-run)")
# what Linux's error numbers mean, as glibc's strerror, and so Rust's io::Error, says it
set errno_words to list of (list of 1, "Operation not permitted"), (list of 2, "No such file or directory"),
    (list of 4, "Interrupted system call"), (list of 5, "Input/output error"), (list of 6, "No such device or address"),
    (list of 9, "Bad file descriptor"), (list of 11, "Resource temporarily unavailable"), (list of 12, "Cannot allocate memory"),
    (list of 13, "Permission denied"), (list of 16, "Device or resource busy"), (list of 17, "File exists"),
    (list of 19, "No such device"), (list of 20, "Not a directory"), (list of 21, "Is a directory"), (list of 22, "Invalid argument"),
    (list of 23, "Too many open files in system"), (list of 24, "Too many open files"), (list of 26, "Text file busy"),
    (list of 27, "File too large"), (list of 28, "No space left on device"), (list of 30, "Read-only file system"),
    (list of 36, "File name too long"), (list of 40, "Too many levels of symbolic links"), (list of 122, "Disk quota exceeded")

# What the --allow flags a program is built with let it do without asking, as moth-native's add_allow read
# them: `bits` what it may do to everything (1 to read, 2 to write, 4 to go online and 8 to start a
# program, added up), and `names`, for each of those four, the files, folders or sites it may (a site's in
# lowercase, as it's matched). --allow-run names nothing: a program may start any program, or none.
to allowed_of with flags
    set made_bits to 0
    set named to list of (empty list), (empty list), (empty list), (empty list)
    for each flag in flags
        set head to ""
        set flag_word to ""
        set listed to nothing
        set seen to 0
        for each c in flag
            add 1 to seen
            if seen is at most 8
                add c to head
            else if listed is nothing and c is "="
                set listed to ""
            else if listed is nothing
                add c to flag_word
            else
                add c to listed
            end
        end
        set kind_nums to empty list
        if head is "--allow-"
            if flag_word is "read"
                set kind_nums to list of 1
            else if flag_word is "write"
                set kind_nums to list of 2
            else if flag_word is "net"
                set kind_nums to list of 3
            else if flag_word is "run" and listed is nothing
                set kind_nums to list of 4
            else if flag_word is "all" and listed is nothing
                set kind_nums to list of 1, 2, 3, 4
            end
        end
        if length of kind_nums is 0
            fail with front's problem(front's place(1, 1, ""), "'" + flag + "' isn't an --allow flag")
        end
        for each k in kind_nums
            if listed is nothing
                set made_bits to made_bits bit or (item k of (list of 1, 2, 4, 8))
            else
                set these to item k of named
                for each one in split listed by ","
                    if one is not "" and k is 3
                        add ascii_lowered(one) to these
                    else if one is not ""
                        add one to these
                    end
                end
            end
        end
    end
    return record with bits made_bits, names named
end

# A to Z as a to z, and nothing else changed, as Rust's to_ascii_lowercase has it
to ascii_lowered with t
    set made to ""
    for each c in t
        set at_upper to position of c in "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        if at_upper is greater than 0
            add item at_upper of "abcdefghijklmnopqrstuvwxyz" to made
        else
            add c to made
        end
    end
    return made
end

# a call into kernel32 from the runtime: a frame of its own, 16-aligned, with the shadow space a call needs
# and room for more inputs and answers from rsp + 32 up to rsp + 96
to win_enter with a
    push_r(a, rbp)
    mov_rr(a, rbp, rsp)
    alui(a, "and", rsp, -16)
    alui(a, "sub", rsp, 96)
end

to win_leave with a
    mov_rr(a, rsp, rbp)
    pop_r(a, rbp)
end

# a Linux system call: its inputs in rdi, rsi, rdx, r10, r8 and r9, and what it gives in rax; rcx and r11 change
to sys_call with a, n
    movi(a, rax, n)
    raw(a, list of 0x0F, 0x05)
end

# 16 bits from memory, made 64
to load16 with a, dst, at
    enc(a, empty list, no, (list of 0x0F, 0xB7), dst, at, empty list)
end

# 16 bits into memory
to store16i with a, at, v
    set two to empty list
    put16(two, v)
    enc(a, (list of 0x66), no, (list of 0xC7), 0, at, two)
end

# jumps to `label` if the UTF-16 units from register base on are `wanted`; uses rax
to units_jump with a, base, wanted, label
    set differ to new_label(a)
    set k to 0
    for each u in wanted
        load16(a, rax, mem(base, 2 * k))
        alui(a, "cmp", rax, u)
        jcc(a, cc_ne, differ)
        add 1 to k
    end
    jmp_to(a, label)
    mark(a, differ)
end

# jumps to `label` if the UTF-16 unit in register r is \ or /
to sep_jump with a, r, label
    alui(a, "cmp", r, 92)
    jcc(a, cc_e, label)
    alui(a, "cmp", r, 47)
    jcc(a, cc_e, label)
end

# jumps to `differ` unless the bytes at rsi start with `word`, its letters (written in lowercase) in either
# case; uses rax
to ascii_prefix with a, word, differ
    set k to 0
    for each c in word
        set got to c as bytes
        set want to byte 1 of got
        load8(a, rax, mem(rsi, k))
        if want is at least 97 and want is at most 122
            alui(a, "or", rax, 32)
        end
        alui(a, "cmp", rax, want)
        jcc(a, cc_ne, differ)
        add 1 to k
    end
end

# jumps to `label` if the byte in register r is a tab, a line break or a space; changes r
to ascii_space_jump with a, r, label
    alui(a, "cmp", r, 32)
    jcc(a, cc_e, label)
    alui(a, "sub", r, 9)
    alui(a, "cmp", r, 4)
    jcc(a, cc_be, label)
end

# jumps to `missing` if the system's code in rdx means there is no such file, as Rust's NotFound has it
to missing_jump with a, target, missing
    alui(a, "cmp", rdx, 2)
    jcc(a, cc_e, missing)
    if target is "windows"
        alui(a, "cmp", rdx, 3)
        jcc(a, cc_e, missing)
    end
end

# jumps to `denied` if the system's code in rdx means the program may not, as Rust's PermissionDenied has it
to denied_jump with a, target, denied
    if target is "windows"
        alui(a, "cmp", rdx, 5)
        jcc(a, cc_e, denied)
    else
        alui(a, "cmp", rdx, 13)
        jcc(a, cc_e, denied)
        alui(a, "cmp", rdx, 1)
        jcc(a, cc_e, denied)
    end
end

# err_file's bytes into the builder
to file_name_text with a
    load(a, rax, rip("err_file"))
    untag(a, rax)
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    call_to(a, "rt_b_bytes")
end

# err_reason's bytes into the builder
to reason_text with a
    load(a, rax, rip("err_reason"))
    untag(a, rax)
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    call_to(a, "rt_b_bytes")
end

# err_reason: what Rust says of a file's name with a 0 in it
to nul_reason with a, target
    call_to(a, "rt_b_reset")
    if target is "windows"
        b_text(a, "strings passed to WinAPI cannot contain NULs")
    else
        b_text(a, "file name contained an unexpected NUL byte")
    end
    call_to(a, "rt_b_text")
    store(a, rip("err_reason"), rax)
end

to emit_files with a, target, allowed
    pad_to(data of a, 8)
    data_here(a, "allow_all")
    put64(data of a, bits of allowed)
    set tables to empty list # for each kind, the names the flags allow it for: how many, then where each is
    for each these in names of allowed
        set objects to empty list
        for each one in these
            add text_object(a, one) to objects
        end
        add objects to tables
    end
    set ro to rodata of a
    pad_to(ro, 8)
    set k to 0
    for each objects in tables
        rodata_here(a, "allow_names_" + k)
        put64(ro, length of objects)
        for each label in objects
            absolute(a, "rodata", length of ro, label, 0)
            put64(ro, 0)
        end
        add 1 to k
    end
    for each slot_name in list of "in_ready", "in_tty", "in_handle", "in_at", "in_end", "arg_count", "arg_vector", "f_room", "f_used",
        "host_len", "host_name_len"
        reserve(a, slot_name, 8, 8)
    end
    reserve(a, "in_buf", in_size, 16)
    reserve(a, "real_a", 65536, 16)
    reserve(a, "real_b", 65536, 16)
    reserve(a, "host_buf", 4096, 16)
    reserve(a, "proc_buf", 32, 16)
    reserve(a, "stat_buf", 256, 16)
    if target is "windows"
        reserve(a, "in_wide", 2048, 16)
        reserve(a, "msg_wide", 4096, 16)
        reserve(a, "msg_utf8", 6144, 16)
    end
    emit_input(a, target)
    emit_permits(a)
    emit_file_io(a, target)
    emit_named(a, target)
    emit_reading(a, target)
    emit_writing(a, target)
    emit_arguments(a, target)
    emit_run(a, target)
    emit_file_why(a)
end

to emit_input with a, target
    # rt_in_setup: in_handle, and in_tty, whether the input is a terminal, found the first time; uses rax,
    # rcx, rdx, rsi, rdi and r8 to r11
    set ready to new_label(a)
    mark(a, "rt_in_setup")
    load(a, rax, rip("in_ready"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, ready)
    storei(a, rip("in_ready"), 1)
    if target is "windows"
        win_enter(a)
        movi(a, rcx, -10)
        call_import(a, "imp_GetStdHandle")
        store(a, rip("in_handle"), rax)
        mov_rr(a, rcx, rax)
        lea(a, rdx, rip("scratch"))
        call_import(a, "imp_GetConsoleMode")
        test32(a, rax)
        setcc(a, cc_ne, rax)
        movzx8(a, rax, rax)
        store(a, rip("in_tty"), rax)
        win_leave(a)
    else
        movi(a, rdi, 0) # a terminal answers TCGETS
        movi(a, rsi, 0x5401)
        lea(a, rdx, rip("scratch"))
        sys_call(a, 16)
        test_rr(a, rax, rax)
        setcc(a, cc_e, rax)
        movzx8(a, rax, rax)
        store(a, rip("in_tty"), rax)
    end
    mark(a, ready)
    ret(a)

    # rt_in_fill: more of the input, into in_buf from its start: rax how many bytes came, 0 at its end
    set filled to new_label(a)
    set nothing_more to new_label(a)
    mark(a, "rt_in_fill")
    storei(a, rip("in_at"), 0)
    storei(a, rip("in_end"), 0)
    if target is "windows"
        set console to new_label(a)
        set kept to new_label(a)
        win_enter(a)
        load(a, rax, rip("in_tty"))
        test_rr(a, rax, rax)
        jcc(a, cc_ne, console)
        load(a, rcx, rip("in_handle"))
        lea(a, rdx, rip("in_buf"))
        movi(a, r8, in_size)
        lea(a, r9, mem(rsp, 48))
        storei(a, mem(rsp, 48), 0)
        storei(a, mem(rsp, 32), 0)
        call_import(a, "imp_ReadFile")
        test32(a, rax)
        jcc(a, cc_e, nothing_more) # a pipe whose other end has closed, or no input at all
        load32(a, rax, mem(rsp, 48))
        jmp_to(a, filled)
        mark(a, console) # a console's characters, as UTF-8; a Ctrl-Z ends what's typed, as it does for Rust
        load(a, rcx, rip("in_handle"))
        lea(a, rdx, rip("in_wide"))
        movi(a, r8, 1024)
        lea(a, r9, mem(rsp, 48))
        storei(a, mem(rsp, 48), 0)
        lea(a, rax, mem(rsp, 64))
        store(a, mem(rsp, 32), rax)
        storei(a, mem(rsp, 64), 16) # how big this is, and no characters typed already
        movi(a, rax, 67108864) # a Ctrl-Z (26) ends a read, and no keys are held
        store(a, mem(rsp, 72), rax)
        call_import(a, "imp_ReadConsoleW")
        test32(a, rax)
        jcc(a, cc_e, nothing_more)
        load32(a, r9, mem(rsp, 48))
        test_rr(a, r9, r9)
        jcc(a, cc_e, nothing_more)
        mov_rr(a, rax, r9)
        alu(a, "add", rax, rax)
        lea(a, rdx, rip("in_wide"))
        alu(a, "add", rax, rdx)
        load16(a, rax, mem(rax, -2))
        alui(a, "cmp", rax, 26)
        jcc(a, cc_ne, kept)
        dec_r(a, r9)
        jcc(a, cc_e, nothing_more)
        mark(a, kept)
        movi(a, rcx, 65001)
        movi(a, rdx, 0)
        lea(a, r8, rip("in_wide"))
        lea(a, rax, rip("in_buf"))
        store(a, mem(rsp, 32), rax)
        storei(a, mem(rsp, 40), in_size)
        storei(a, mem(rsp, 48), 0)
        storei(a, mem(rsp, 56), 0)
        call_import(a, "imp_WideCharToMultiByte")
        mov32_rr(a, rax, rax)
        mark(a, filled)
        win_leave(a)
        store(a, rip("in_end"), rax)
        ret(a)
        mark(a, nothing_more)
        win_leave(a)
        movi(a, rax, 0)
        ret(a)
    else
        set again to new_label(a)
        mark(a, again)
        movi(a, rdi, 0)
        lea(a, rsi, rip("in_buf"))
        movi(a, rdx, in_size)
        sys_call(a, 0)
        alui(a, "cmp", rax, -4) # interrupted: again
        jcc(a, cc_e, again)
        test_rr(a, rax, rax)
        jcc(a, cc_le, nothing_more)
        store(a, rip("in_end"), rax)
        ret(a)
        mark(a, nothing_more)
        movi(a, rax, 0)
        ret(a)
    end

    # rt_read_line: the next line of the input, without the "\n" or "\r\n" that ends it, as text in rax; rax 0
    # at the end of the input. What isn't UTF-8 in it becomes U+FFFD. Uses the builder; keeps rbx and r12 to r15.
    set scan to new_label(a)
    set fresh to new_label(a)
    set seek to new_label(a)
    set got_line to new_label(a)
    set put_line to new_label(a)
    set no_newline to new_label(a)
    set put_rest to new_label(a)
    set more to new_label(a)
    set ended to new_label(a)
    set none_left to new_label(a)
    set as_text to new_label(a)
    set held_cr to new_label(a)
    mark(a, "rt_read_line")
    push_r(a, rbx)
    push_r(a, r12)
    call_to(a, "rt_in_setup")
    call_to(a, "rt_b_reset")
    movi(a, rbx, 0) # 1 while a "\r" that came last waits to see whether a "\n" follows it
    mark(a, scan)
    load(a, rcx, rip("in_at"))
    alu_load(a, "cmp", rcx, rip("in_end"))
    jcc(a, cc_ae, more)
    test_rr(a, rbx, rbx)
    jcc(a, cc_e, fresh)
    movi(a, rbx, 0)
    lea(a, rax, rip("in_buf"))
    alu(a, "add", rax, rcx)
    load8(a, rax, mem(rax, 0))
    alui(a, "cmp", rax, 10)
    jcc(a, cc_ne, held_cr)
    inc_r(a, rcx) # "\r\n": the line ends
    store(a, rip("in_at"), rcx)
    jmp_to(a, as_text)
    mark(a, held_cr) # just a "\r", which is the line's own
    movi(a, rax, 13)
    call_to(a, "rt_b_byte")
    load(a, rcx, rip("in_at"))
    mark(a, fresh) # a "\n" from rcx on?
    mov_rr(a, r12, rcx)
    mark(a, seek)
    alu_load(a, "cmp", r12, rip("in_end"))
    jcc(a, cc_ae, no_newline)
    lea(a, rax, rip("in_buf"))
    alu(a, "add", rax, r12)
    load8(a, rax, mem(rax, 0))
    alui(a, "cmp", rax, 10)
    jcc(a, cc_e, got_line)
    inc_r(a, r12)
    jmp_to(a, seek)
    mark(a, got_line) # the bytes before it, but for a "\r" just before it
    lea(a, rsi, rip("in_buf"))
    alu(a, "add", rsi, rcx)
    mov_rr(a, rax, r12)
    alu(a, "sub", rax, rcx)
    mov_rr(a, rcx, rax)
    lea(a, rax, mem(r12, 1))
    store(a, rip("in_at"), rax)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, put_line)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, rcx)
    load8(a, rax, mem(rax, -1))
    alui(a, "cmp", rax, 13)
    jcc(a, cc_ne, put_line)
    dec_r(a, rcx)
    mark(a, put_line)
    call_to(a, "rt_b_bytes")
    jmp_to(a, as_text)
    mark(a, no_newline) # all of it, but for a "\r" at its end, which waits
    lea(a, rsi, rip("in_buf"))
    alu(a, "add", rsi, rcx)
    load(a, rax, rip("in_end"))
    store(a, rip("in_at"), rax)
    alu(a, "sub", rax, rcx)
    mov_rr(a, rcx, rax)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, more)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, rcx)
    load8(a, rax, mem(rax, -1))
    alui(a, "cmp", rax, 13)
    jcc(a, cc_ne, put_rest)
    dec_r(a, rcx)
    movi(a, rbx, 1)
    mark(a, put_rest)
    call_to(a, "rt_b_bytes")
    mark(a, more)
    call_to(a, "rt_in_fill")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, scan)
    test_rr(a, rbx, rbx) # the end of the input: a "\r" that waited is the line's own
    jcc(a, cc_e, ended)
    movi(a, rax, 13)
    call_to(a, "rt_b_byte")
    mark(a, ended)
    load(a, rax, rip("b_len"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, none_left)
    mark(a, as_text)
    call_to(a, "rt_b_utf8_text")
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
    mark(a, none_left)
    movi(a, rax, 0)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_b_utf8_text: what the builder holds, read as UTF-8 (U+FFFD for what isn't), as a new text in rax
    set check_byte to new_label(a)
    set all_ascii to new_label(a)
    set not_ascii to new_label(a)
    mark(a, "rt_b_utf8_text")
    load(a, rsi, rip("b_ptr"))
    load(a, rcx, rip("b_len"))
    mark(a, check_byte)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, all_ascii)
    load8(a, rax, mem(rsi, 0))
    alui(a, "cmp", rax, 0x80)
    jcc(a, cc_ae, not_ascii)
    inc_r(a, rsi)
    dec_r(a, rcx)
    jmp_to(a, check_byte)
    mark(a, all_ascii)
    jmp_to(a, "rt_b_text")
    mark(a, not_ascii) # a copy, read back into the builder
    load(a, rcx, rip("b_len"))
    call_to(a, "rt_alloc_raw")
    mov_rr(a, rdi, rax)
    load(a, rsi, rip("b_ptr"))
    load(a, rcx, rip("b_len"))
    push_r(a, rax)
    push_r(a, rcx)
    rep_movsb(a)
    pop_r(a, rcx)
    pop_r(a, rsi)
    call_to(a, "rt_decode_bytes")
    jmp_to(a, "rt_b_text")

    # rt_ask: xmm0, a question, shown as `say` shows it with a space after it, then a line of the input: the
    # answer, as text, into xmm0 with rax 0; or rax 2 (err_why 26) at the end of the input. An answer piped in
    # is shown after its question, as if it were typed.
    set answered to new_label(a)
    set typed to new_label(a)
    mark(a, "rt_ask")
    if pad of a
        set not_drawn to new_label(a)
        call_to(a, "rt_pad_hook")
        test_rr(a, rax, rax)
        jcc(a, cc_e, not_drawn)
        movi(a, rax, 0)
        ret(a)
        mark(a, not_drawn)
    end
    push_r(a, rbx)
    call_to(a, "rt_b_reset")
    movq_rx(a, rax, xmm0)
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    movi(a, rax, 32)
    call_to(a, "rt_b_byte")
    load(a, rsi, rip("b_ptr"))
    load(a, rcx, rip("b_len"))
    call_to(a, "rt_out_text")
    call_to(a, "rt_flush_out")
    call_to(a, "rt_read_line")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, answered)
    call_to(a, "rt_out_line") # no answer: the mistake starts on a line of its own
    storei(a, rip("err_why"), 26)
    movi(a, rax, 2)
    pop_r(a, rbx)
    ret(a)
    mark(a, answered)
    mov_rr(a, rbx, rax)
    load(a, rcx, rip("in_tty"))
    test_rr(a, rcx, rcx)
    jcc(a, cc_ne, typed)
    untag(a, rax)
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    call_to(a, "rt_out_text")
    call_to(a, "rt_out_line")
    mark(a, typed)
    movq_xr(a, xmm0, rbx)
    movi(a, rax, 0)
    pop_r(a, rbx)
    ret(a)
end

to emit_permits with a
    # rt_permit: rcx what the program would do (0 read a file, 1 write one, 2 go online), err_file to which file
    # or site: rax 0 if it may, or 1 if it may not, with err_reason why. What a person answers is kept in
    # `asked`, by what it was and to what.
    set allowed to new_label(a)
    set refused to new_label(a)
    set have_asked to new_label(a)
    set ask_person to new_label(a)
    set worded to new_label(a)
    set not_all to new_label(a)
    set put_answer to new_label(a)
    set said to new_label(a)
    set decided to new_label(a)
    mark(a, "rt_permit")
    push_r(a, rbx)
    push_r(a, r12)
    mov_rr(a, rbx, rcx)
    load(a, rax, rip("allow_all"))
    shift_cl(a, "shr", rax)
    alui(a, "and", rax, 1)
    jcc(a, cc_ne, allowed)
    mov_rr(a, rcx, rbx)
    call_to(a, "rt_named_allows")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, allowed)
    call_to(a, "rt_b_reset") # what it would do, and to what: a key of `asked`
    lea(a, rax, mem(rbx, 48))
    call_to(a, "rt_b_byte")
    file_name_text(a)
    call_to(a, "rt_b_text")
    mov_rr(a, r12, rax)
    load(a, rax, rip("asked"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, have_asked)
    call_to(a, "rt_dict_new")
    movi64(a, rcx, tag_dict)
    alu(a, "or", rax, rcx)
    store(a, rip("asked"), rax)
    mark(a, have_asked)
    mov_rr(a, rax, r12)
    call_to(a, "rt_key")
    load(a, rax, rip("asked"))
    untag(a, rax)
    call_to(a, "rt_dict_find")
    test_rr(a, rax, rax)
    jcc(a, cc_e, ask_person)
    load(a, rax, mem(rax, 8)) # asked already: what the person said then
    movi64(a, rcx, bits_yes)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, allowed)
    jmp_to(a, refused)
    mark(a, ask_person) # only a person at a terminal is asked
    call_to(a, "rt_in_setup")
    load(a, rax, rip("in_tty"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, refused)
    load32(a, rax, rip("err_tty"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, refused)
    call_to(a, "rt_flush_out")
    call_to(a, "rt_b_reset")
    b_text(a, "moth: let this program ")
    set k to 0
    for each words in permission_words
        set other to new_label(a)
        alui(a, "cmp", rbx, k)
        jcc(a, cc_ne, other)
        b_text(a, item 1 of words)
        jmp_to(a, worded)
        mark(a, other)
        add 1 to k
    end
    mark(a, worded)
    b_text(a, " '")
    load(a, rax, rip("err_file"))
    call_to(a, "rt_b_shown_name")
    b_text(a, "'? (y = yes, a = yes to all, n = no) ")
    movi(a, rdi, 2)
    load(a, rsi, rip("b_ptr"))
    load(a, rdx, rip("b_len"))
    call_to(a, "rt_write")
    call_to(a, "rt_read_line")
    call_to(a, "rt_answer")
    push_r(a, rax)
    alui(a, "cmp", rax, 2)
    jcc(a, cc_ne, not_all)
    movi(a, rax, 1) # yes to all of this kind
    mov_rr(a, rcx, rbx)
    shift_cl(a, "shl", rax)
    alu_store(a, "or", rip("allow_all"), rax)
    mark(a, not_all)
    mov_rr(a, rax, r12)
    call_to(a, "rt_key")
    load(a, rcx, mem(rsp, 0))
    movi64(a, r10, bits_no)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, put_answer)
    movi64(a, r10, bits_yes)
    mark(a, put_answer)
    load(a, rax, rip("asked"))
    untag(a, rax)
    call_to(a, "rt_dict_set")
    pop_r(a, rax)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, allowed)
    mark(a, refused)
    call_to(a, "rt_b_reset")
    set k to 0
    for each words in permission_words
        set other to new_label(a)
        alui(a, "cmp", rbx, k)
        jcc(a, cc_ne, other)
        b_text(a, item 2 of words)
        jmp_to(a, said)
        mark(a, other)
        add 1 to k
    end
    mark(a, said)
    call_to(a, "rt_b_text")
    store(a, rip("err_reason"), rax)
    movi(a, rax, 1)
    jmp_to(a, decided)
    mark(a, allowed)
    movi(a, rax, 0)
    mark(a, decided)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_answer: rax a line typed (or 0): rax 1 if it says yes ("y" or "yes"), 2 if yes to all ("a" or
    # "all"), else 0; letters in either case, with space around them or not
    set trim_front to new_label(a)
    set front_space to new_label(a)
    set trim_back to new_label(a)
    set back_space to new_label(a)
    set trimmed to new_label(a)
    set three to new_label(a)
    set not_y to new_label(a)
    set not_yes to new_label(a)
    set say_no to new_label(a)
    set say_yes to new_label(a)
    set say_all to new_label(a)
    mark(a, "rt_answer")
    test_rr(a, rax, rax)
    jcc(a, cc_e, say_no)
    untag(a, rax)
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    mark(a, trim_front)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, say_no)
    load8(a, rdx, mem(rsi, 0))
    ascii_space_jump(a, rdx, front_space)
    jmp_to(a, trim_back)
    mark(a, front_space)
    inc_r(a, rsi)
    dec_r(a, rcx)
    jmp_to(a, trim_front)
    mark(a, trim_back)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, rcx)
    load8(a, rdx, mem(rax, -1))
    ascii_space_jump(a, rdx, back_space)
    jmp_to(a, trimmed)
    mark(a, back_space)
    dec_r(a, rcx)
    jmp_to(a, trim_back)
    mark(a, trimmed)
    alui(a, "cmp", rcx, 1)
    jcc(a, cc_ne, three)
    ascii_prefix(a, "y", not_y)
    jmp_to(a, say_yes)
    mark(a, not_y)
    ascii_prefix(a, "a", say_no)
    jmp_to(a, say_all)
    mark(a, three)
    alui(a, "cmp", rcx, 3)
    jcc(a, cc_ne, say_no)
    ascii_prefix(a, "yes", not_yes)
    jmp_to(a, say_yes)
    mark(a, not_yes)
    ascii_prefix(a, "all", say_no)
    mark(a, say_all)
    movi(a, rax, 2)
    ret(a)
    mark(a, say_yes)
    movi(a, rax, 1)
    ret(a)
    mark(a, say_no)
    movi(a, rax, 0)
    ret(a)

    # rt_b_shown_name: rax a file's or site's name: into the builder as a question shows it, with ? for each
    # character that could move the cursor or turn the text around (control characters, zero-width ones and
    # those that change the text's direction)
    set each_char to new_label(a)
    set hidden to new_label(a)
    set names_done to new_label(a)
    mark(a, "rt_b_shown_name")
    push_r(a, rbx)
    push_r(a, r12)
    untag(a, rax)
    load(a, rbx, mem(rax, 16))
    load(a, r12, mem(rax, 0))
    alu(a, "add", r12, rbx)
    mark(a, each_char)
    alu(a, "cmp", rbx, r12)
    jcc(a, cc_ae, names_done)
    mov_rr(a, rsi, rbx)
    char_size(a)
    push_r(a, rdx)
    call_to(a, "rt_decode")
    pop_r(a, rdx)
    for each span in list of (list of 0, 0x1F), (list of 0x7F, 0x9F), (list of 0x200B, 0x200F), (list of 0x2028, 0x202E),
        (list of 0x2066, 0x2069)
        mov_rr(a, rcx, rax)
        alui(a, "sub", rcx, item 1 of span)
        alui(a, "cmp", rcx, (item 2 of span) - (item 1 of span))
        jcc(a, cc_be, hidden)
    end
    mov_rr(a, rsi, rbx)
    mov_rr(a, rcx, rdx)
    alu(a, "add", rbx, rdx)
    call_to(a, "rt_b_bytes")
    jmp_to(a, each_char)
    mark(a, hidden)
    alu(a, "add", rbx, rdx)
    movi(a, rax, 63)
    call_to(a, "rt_b_byte")
    jmp_to(a, each_char)
    mark(a, names_done)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
end

to emit_file_io with a, target
    # rt_file_path: err_file as the system takes a file's name, in memory of its own, in rax: UTF-16 on
    # Windows and UTF-8 on Linux, with a 0 after it. On Windows it is the path Rust's std::fs opens: a name
    # that isn't already a whole path from a drive, or one starting \\, is made one by GetFullPathNameW, with
    # \\?\ before it (maybe_verbatim in Rust's library), so a name ending in / or a dot means what it does there.
    mark(a, "rt_file_path")
    load(a, rax, rip("err_file"))
    mark(a, "rt_path_of") # rax a text: the same for it
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    untag(a, rax)
    load(a, r12, mem(rax, 16))
    load(a, r13, mem(rax, 0))
    if target is "windows"
        set sized to new_label(a)
        set converted to new_label(a)
        movi(a, rbx, 0)
        test_rr(a, r13, r13)
        jcc(a, cc_e, sized)
        win_enter(a)
        movi(a, rcx, 65001)
        movi(a, rdx, 0)
        mov_rr(a, r8, r12)
        mov_rr(a, r9, r13)
        storei(a, mem(rsp, 32), 0)
        storei(a, mem(rsp, 40), 0)
        call_import(a, "imp_MultiByteToWideChar")
        mov32_rr(a, rbx, rax)
        win_leave(a)
        mark(a, sized)
        mov_rr(a, rcx, rbx)
        alu(a, "add", rcx, rcx)
        alui(a, "add", rcx, 2)
        call_to(a, "rt_alloc_raw")
        test_rr(a, rbx, rbx)
        jcc(a, cc_e, converted)
        push_r(a, rax)
        win_enter(a)
        store(a, mem(rsp, 32), rax)
        store(a, mem(rsp, 40), rbx)
        movi(a, rcx, 65001)
        movi(a, rdx, 0)
        mov_rr(a, r8, r12)
        mov_rr(a, r9, r13)
        call_import(a, "imp_MultiByteToWideChar")
        win_leave(a)
        pop_r(a, rax)
        mark(a, converted)
        set as_is to new_label(a)
        set not_prefixed to new_label(a)
        set not_drive to new_label(a)
        set first_sep to new_label(a)
        set full to new_label(a)
        set drive_full to new_label(a)
        set not_drive_full to new_label(a)
        set device_path to new_label(a)
        set unc_path to new_label(a)
        set prefixed to new_label(a)
        mov_rr(a, r12, rax) # its units, rbx of them
        test_rr(a, rbx, rbx)
        jcc(a, cc_e, as_is)
        alui(a, "cmp", rbx, 4) # \\?\ or \??\ already
        jcc(a, cc_b, not_prefixed)
        units_jump(a, r12, (list of 92, 92, 63, 92), as_is)
        units_jump(a, r12, (list of 92, 63, 63, 92), as_is)
        mark(a, not_prefixed)
        alui(a, "cmp", rbx, 247) # short, and whole already: from a drive, or starting \\
        jcc(a, cc_ae, full)
        alui(a, "cmp", rbx, 2)
        jcc(a, cc_b, full)
        load16(a, rax, mem(r12, 2))
        alui(a, "cmp", rax, 58)
        jcc(a, cc_ne, not_drive)
        load16(a, rax, mem(r12, 0))
        sep_jump(a, rax, not_drive)
        alui(a, "cmp", rbx, 2)
        jcc(a, cc_e, as_is)
        load16(a, rax, mem(r12, 4))
        sep_jump(a, rax, as_is)
        jmp_to(a, full)
        mark(a, not_drive)
        load16(a, rax, mem(r12, 0))
        sep_jump(a, rax, first_sep)
        jmp_to(a, full)
        mark(a, first_sep)
        load16(a, rax, mem(r12, 2))
        sep_jump(a, rax, as_is)
        mark(a, full) # how much room the whole path takes, then the path, after room for a prefix
        win_enter(a)
        mov_rr(a, rcx, r12)
        movi(a, rdx, 0)
        movi(a, r8, 0)
        movi(a, r9, 0)
        call_import(a, "imp_GetFullPathNameW")
        mov32_rr(a, rbx, rax)
        win_leave(a)
        test_rr(a, rbx, rbx)
        jcc(a, cc_e, as_is)
        lea(a, rcx, mem(rbx, 8))
        alu(a, "add", rcx, rcx)
        call_to(a, "rt_alloc_raw")
        mov_rr(a, r14, rax)
        win_enter(a)
        mov_rr(a, rcx, r12)
        mov_rr(a, rdx, rbx)
        lea(a, r8, mem(r14, 16))
        movi(a, r9, 0)
        call_import(a, "imp_GetFullPathNameW")
        mov32_rr(a, r13, rax)
        win_leave(a)
        test_rr(a, r13, r13)
        jcc(a, cc_e, as_is)
        alu(a, "cmp", r13, rbx)
        jcc(a, cc_ae, as_is)
        lea(a, rsi, mem(r14, 16)) # rsi where it starts, r13 how long: C:\ becomes \\?\C:\
        alui(a, "cmp", r13, 3)
        jcc(a, cc_b, drive_full)
        load16(a, rax, mem(r14, 18))
        alui(a, "cmp", rax, 58)
        jcc(a, cc_ne, drive_full)
        load16(a, rax, mem(r14, 20))
        alui(a, "cmp", rax, 92)
        jcc(a, cc_ne, drive_full)
        lea(a, rsi, mem(r14, 8))
        store16i(a, mem(rsi, 0), 92)
        store16i(a, mem(rsi, 2), 92)
        store16i(a, mem(rsi, 4), 63)
        store16i(a, mem(rsi, 6), 92)
        alui(a, "add", r13, 4)
        jmp_to(a, prefixed)
        mark(a, drive_full) # \\?\ and \??\ stay, \\.\ becomes \\?\, and \\server becomes \\?\UNC\server
        alui(a, "cmp", r13, 4)
        jcc(a, cc_b, not_drive_full)
        units_jump(a, rsi, (list of 92, 92, 63, 92), prefixed)
        units_jump(a, rsi, (list of 92, 63, 63, 92), prefixed)
        units_jump(a, rsi, (list of 92, 92, 46, 92), device_path)
        mark(a, not_drive_full)
        alui(a, "cmp", r13, 2)
        jcc(a, cc_b, prefixed)
        units_jump(a, rsi, (list of 92, 92), unc_path)
        jmp_to(a, prefixed)
        mark(a, device_path)
        store16i(a, mem(rsi, 4), 63)
        jmp_to(a, prefixed)
        mark(a, unc_path)
        lea(a, rsi, mem(r14, 4))
        set k to 0
        for each u in list of 92, 92, 63, 92, 85, 78, 67, 92
            store16i(a, mem(rsi, 2 * k), u)
            add 1 to k
        end
        alui(a, "add", r13, 6)
        mark(a, prefixed) # then to the start of its memory, with the 0 after it
        mov_rr(a, rdi, r14)
        lea(a, rcx, mem(r13, 1))
        raw(a, list of 0x66, 0xF3, 0xA5)
        mov_rr(a, r12, r14)
        mark(a, as_is)
        mov_rr(a, rax, r12)
    else
        lea(a, rcx, mem(r13, 1))
        call_to(a, "rt_alloc_raw")
        mov_rr(a, rdi, rax)
        mov_rr(a, rsi, r12)
        mov_rr(a, rcx, r13)
        rep_movsb(a)
    end
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_file_open_read, rt_file_open_write: rax a path from rt_file_path: rax a handle, or -1 with the
    # system's code for what went wrong in rdx. A file opened to write is made, or emptied first.
    if target is "windows"
        for each way in list of (list of "rt_file_open_read", 0x80000000, 3), (list of "rt_file_open_write", 0x40000000, 2)
            set opened to new_label(a)
            mark(a, item 1 of way)
            win_enter(a)
            mov_rr(a, rcx, rax)
            movi(a, rdx, item 2 of way)
            movi(a, r8, 7) # others may read, write and delete it meanwhile, as Rust lets them
            movi(a, r9, 0)
            storei(a, mem(rsp, 32), item 3 of way)
            storei(a, mem(rsp, 40), 0x80)
            storei(a, mem(rsp, 48), 0)
            call_import(a, "imp_CreateFileW")
            alui(a, "cmp", rax, -1)
            jcc(a, cc_ne, opened)
            call_import(a, "imp_GetLastError")
            mov32_rr(a, rdx, rax)
            movi(a, rax, -1)
            mark(a, opened)
            win_leave(a)
            ret(a)
        end
    else
        for each way in list of (list of "rt_file_open_read", 0x80000), (list of "rt_file_open_write", 0x80241)
            set again to new_label(a)
            set opened to new_label(a)
            mark(a, item 1 of way)
            mov_rr(a, rdi, rax)
            mark(a, again)
            movi(a, rsi, item 2 of way)
            if item 1 of way is "rt_file_open_read"
                movi(a, rdx, 438) # 0o666, less the umask
            else
                mov_rr(a, rdx, r8) # as the writer says, less the umask
            end
            sys_call(a, 2)
            alui(a, "cmp", rax, -4)
            jcc(a, cc_e, again)
            test_rr(a, rax, rax)
            jcc(a, cc_ns, opened)
            unary(a, "neg", rax)
            mov_rr(a, rdx, rax)
            movi(a, rax, -1)
            mark(a, opened)
            ret(a)
        end
    end

    # rt_file_read_some, rt_file_write_some: rax a handle, rsi where the bytes go or come from, rcx how many at
    # most: rax how many did, 0 at the end, or -1 with the system's code in rdx
    if target is "windows"
        for each way in list of (list of "rt_file_read_some", "imp_ReadFile"), (list of "rt_file_write_some", "imp_WriteFile")
            set capped to new_label(a)
            set worked to new_label(a)
            set finished to new_label(a)
            mark(a, item 1 of way)
            win_enter(a)
            mov_rr(a, r8, rcx)
            movi(a, rcx, 1073741824)
            alu(a, "cmp", r8, rcx)
            jcc(a, cc_be, capped)
            mov_rr(a, r8, rcx)
            mark(a, capped)
            mov_rr(a, rcx, rax)
            mov_rr(a, rdx, rsi)
            lea(a, r9, mem(rsp, 48))
            storei(a, mem(rsp, 48), 0)
            storei(a, mem(rsp, 32), 0)
            call_import(a, item 2 of way)
            test32(a, rax)
            jcc(a, cc_ne, worked)
            call_import(a, "imp_GetLastError")
            mov32_rr(a, rdx, rax)
            movi(a, rax, -1)
            alui(a, "cmp", rdx, 109) # a pipe whose other end has closed: the end
            jcc(a, cc_ne, finished)
            movi(a, rax, 0)
            jmp_to(a, finished)
            mark(a, worked)
            load32(a, rax, mem(rsp, 48))
            mark(a, finished)
            win_leave(a)
            ret(a)
        end
    else
        for each way in list of (list of "rt_file_read_some", 0), (list of "rt_file_write_some", 1)
            set again to new_label(a)
            set worked to new_label(a)
            mark(a, item 1 of way)
            mov_rr(a, rdi, rax)
            mov_rr(a, rdx, rcx)
            mark(a, again)
            sys_call(a, item 2 of way)
            alui(a, "cmp", rax, -4)
            jcc(a, cc_e, again)
            test_rr(a, rax, rax)
            jcc(a, cc_ns, worked)
            unary(a, "neg", rax)
            mov_rr(a, rdx, rax)
            movi(a, rax, -1)
            mark(a, worked)
            ret(a)
        end
    end

    # rt_file_close: rax a handle
    mark(a, "rt_file_close")
    if target is "windows"
        win_enter(a)
        mov_rr(a, rcx, rax)
        call_import(a, "imp_CloseHandle")
        win_leave(a)
    else
        mov_rr(a, rdi, rax)
        sys_call(a, 3)
    end
    ret(a)

    # rt_file_is_dir: rax a path: rax 1 if it is a folder, else 0
    set not_dir to new_label(a)
    mark(a, "rt_file_is_dir")
    if target is "windows"
        win_enter(a)
        mov_rr(a, rcx, rax)
        call_import(a, "imp_GetFileAttributesW")
        win_leave(a)
        mov32_rr(a, rax, rax)
        movi(a, rcx, 4294967295)
        alu(a, "cmp", rax, rcx)
        jcc(a, cc_e, not_dir)
        alui(a, "and", rax, 16)
        shifti(a, "shr", rax, 4)
        ret(a)
    else
        mov_rr(a, rdi, rax)
        lea(a, rsi, rip("stat_buf"))
        sys_call(a, 4)
        test_rr(a, rax, rax)
        jcc(a, cc_ne, not_dir)
        load32(a, rax, rip_plus("stat_buf", 24))
        alui(a, "and", rax, 0xF000)
        alui(a, "cmp", rax, 0x4000)
        setcc(a, cc_e, rax)
        movzx8(a, rax, rax)
        ret(a)
    end
    mark(a, not_dir)
    movi(a, rax, 0)
    ret(a)

    # rt_os_text: rdx a code the system gave: what it means, as Rust's io::Error says it, into the builder
    set os_number to new_label(a)
    mark(a, "rt_os_text")
    push_r(a, rbx)
    push_r(a, r12)
    mov_rr(a, rbx, rdx)
    if target is "windows"
        set got_words to new_label(a)
        set trim to new_label(a)
        set trimmed to new_label(a)
        set drop to new_label(a)
        win_enter(a)
        movi(a, rcx, 0x1200) # from the system, with no inserts
        movi(a, rdx, 0)
        mov_rr(a, r8, rbx)
        movi(a, r9, 0)
        lea(a, rax, rip("msg_wide"))
        store(a, mem(rsp, 32), rax)
        storei(a, mem(rsp, 40), 2048)
        storei(a, mem(rsp, 48), 0)
        call_import(a, "imp_FormatMessageW")
        mov32_rr(a, r12, rax)
        test_rr(a, r12, r12)
        jcc(a, cc_ne, got_words)
        call_import(a, "imp_GetLastError")
        mov32_rr(a, r12, rax)
        win_leave(a)
        b_text(a, "OS Error ")
        mov_rr(a, rax, rbx)
        call_to(a, "rt_e_plain")
        b_text(a, " (FormatMessageW() returned error ")
        mov_rr(a, rax, r12)
        call_to(a, "rt_e_plain")
        b_text(a, ")")
        jmp_to(a, os_number)
        mark(a, got_words) # as UTF-8, without the line break at its end
        movi(a, rcx, 65001)
        movi(a, rdx, 0)
        lea(a, r8, rip("msg_wide"))
        mov_rr(a, r9, r12)
        lea(a, rax, rip("msg_utf8"))
        store(a, mem(rsp, 32), rax)
        storei(a, mem(rsp, 40), 6144)
        storei(a, mem(rsp, 48), 0)
        storei(a, mem(rsp, 56), 0)
        call_import(a, "imp_WideCharToMultiByte")
        mov32_rr(a, rcx, rax)
        win_leave(a)
        mark(a, trim)
        test_rr(a, rcx, rcx)
        jcc(a, cc_e, trimmed)
        lea(a, rax, rip("msg_utf8"))
        alu(a, "add", rax, rcx)
        load8(a, rax, mem(rax, -1))
        ascii_space_jump(a, rax, drop)
        jmp_to(a, trimmed)
        mark(a, drop)
        dec_r(a, rcx)
        jmp_to(a, trim)
        mark(a, trimmed)
        lea(a, rsi, rip("msg_utf8"))
        call_to(a, "rt_b_bytes")
    else
        set worded to new_label(a)
        for each pair in errno_words
            set other to new_label(a)
            alui(a, "cmp", rbx, item 1 of pair)
            jcc(a, cc_ne, other)
            b_text(a, item 2 of pair)
            jmp_to(a, worded)
            mark(a, other)
        end
        b_text(a, "Unknown error ")
        mov_rr(a, rax, rbx)
        call_to(a, "rt_e_plain")
        mark(a, worded)
    end
    mark(a, os_number)
    b_text(a, " (os error ")
    mov_rr(a, rax, rbx)
    call_to(a, "rt_e_plain")
    b_text(a, ")")
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_file_reason: rax the path of a file that went wrong, rdx the system's code for how, rcx 0 if it was
    # being read or 1 written: as moth-native says it, in Node's words for a folder, a missing file and one the
    # program may not have, as text in err_reason
    set a_file to new_label(a)
    set dir_open to new_label(a)
    set missing to new_label(a)
    set denied to new_label(a)
    set reasoned to new_label(a)
    mark(a, "rt_file_reason")
    push_r(a, rbx)
    push_r(a, r12)
    mov_rr(a, rbx, rdx)
    mov_rr(a, r12, rcx)
    call_to(a, "rt_file_is_dir")
    push_r(a, rax)
    call_to(a, "rt_b_reset")
    pop_r(a, rax)
    test_rr(a, rax, rax)
    jcc(a, cc_e, a_file)
    b_text(a, "EISDIR: illegal operation on a directory, ")
    test_rr(a, r12, r12)
    jcc(a, cc_ne, dir_open)
    b_text(a, "read")
    jmp_to(a, reasoned)
    mark(a, dir_open)
    b_text(a, "open '")
    file_name_text(a)
    b_text(a, "'")
    jmp_to(a, reasoned)
    mark(a, a_file)
    mov_rr(a, rdx, rbx)
    missing_jump(a, target, missing)
    denied_jump(a, target, denied)
    call_to(a, "rt_os_text")
    jmp_to(a, reasoned)
    mark(a, missing)
    b_text(a, "ENOENT: no such file or directory, open '")
    file_name_text(a)
    b_text(a, "'")
    jmp_to(a, reasoned)
    mark(a, denied)
    b_text(a, "EACCES: permission denied, open '")
    file_name_text(a)
    b_text(a, "'")
    mark(a, reasoned)
    call_to(a, "rt_b_text")
    store(a, rip("err_reason"), rax)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_is_site: rax 1 if err_file is a site's address, starting http:// or https:// in either case
    set site_no to new_label(a)
    set site_yes to new_label(a)
    set not_http to new_label(a)
    mark(a, "rt_is_site")
    load(a, rax, rip("err_file"))
    untag(a, rax)
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    alui(a, "cmp", rcx, 7)
    jcc(a, cc_b, site_no)
    ascii_prefix(a, "http://", not_http)
    jmp_to(a, site_yes)
    mark(a, not_http)
    alui(a, "cmp", rcx, 8)
    jcc(a, cc_b, site_no)
    ascii_prefix(a, "https://", site_no)
    mark(a, site_yes)
    movi(a, rax, 1)
    ret(a)
    mark(a, site_no)
    movi(a, rax, 0)
    ret(a)

    # rt_name_nul: rax 1 if err_file has a 0 in it, which no file's name can
    set nul_seek to new_label(a)
    set nul_found to new_label(a)
    set nul_none to new_label(a)
    mark(a, "rt_name_nul")
    load(a, rax, rip("err_file"))
    untag(a, rax)
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    mark(a, nul_seek)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, nul_none)
    load8(a, rax, mem(rsi, 0))
    test_rr(a, rax, rax)
    jcc(a, cc_e, nul_found)
    inc_r(a, rsi)
    dec_r(a, rcx)
    jmp_to(a, nul_seek)
    mark(a, nul_found)
    movi(a, rax, 1)
    ret(a)
    mark(a, nul_none)
    movi(a, rax, 0)
    ret(a)
end

to emit_named with a, target
    # rt_named_allows: rcx what the program would do (0 read, 1 write, 2 go online): rax 1 if a name the --allow
    # flags give for it covers err_file, as moth-native's Permits::allows has it: a file that is the file or
    # folder named, or anywhere inside it, once each is where it really is; or a site whose host is the one
    # named, with its port or without it
    set files to new_label(a)
    set each_site to new_label(a)
    set try_name to new_label(a)
    set next_site to new_label(a)
    set each_file to new_label(a)
    set named_yes to new_label(a)
    set named_no to new_label(a)
    set named_out to new_label(a)
    mark(a, "rt_named_allows")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    mov_rr(a, rbx, rcx)
    for each k from 0 to 3
        set other to new_label(a)
        alui(a, "cmp", rbx, k)
        jcc(a, cc_ne, other)
        lea(a, r12, rip("allow_names_" + k))
        mark(a, other)
    end
    load(a, r13, mem(r12, 0))
    alui(a, "add", r12, 8)
    test_rr(a, r13, r13)
    jcc(a, cc_e, named_no)
    alui(a, "cmp", rbx, 2)
    jcc(a, cc_ne, files)
    load(a, rax, rip("err_file"))
    call_to(a, "rt_host_of")
    test_rr(a, rax, rax)
    jcc(a, cc_e, named_no)
    mark(a, each_site)
    test_rr(a, r13, r13)
    jcc(a, cc_e, named_no)
    load(a, rax, mem(r12, 0))
    load(a, rcx, mem(rax, 0))
    alu_load(a, "cmp", rcx, rip("host_len"))
    jcc(a, cc_ne, try_name)
    load(a, rsi, mem(rax, 16))
    lea(a, rdi, rip("host_buf"))
    raw(a, list of 0xF3, 0xA6)
    jcc(a, cc_e, named_yes)
    mark(a, try_name)
    load(a, rax, mem(r12, 0))
    load(a, rcx, mem(rax, 0))
    alu_load(a, "cmp", rcx, rip("host_name_len"))
    jcc(a, cc_ne, next_site)
    load(a, rsi, mem(rax, 16))
    lea(a, rdi, rip("host_buf"))
    raw(a, list of 0xF3, 0xA6)
    jcc(a, cc_e, named_yes)
    mark(a, next_site)
    alui(a, "add", r12, 8)
    dec_r(a, r13)
    jmp_to(a, each_site)
    mark(a, files)
    mark(a, each_file)
    test_rr(a, r13, r13)
    jcc(a, cc_e, named_no)
    load(a, rax, mem(r12, 0))
    load(a, rdx, rip("err_file"))
    call_to(a, "rt_within")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, named_yes)
    alui(a, "add", r12, 8)
    dec_r(a, r13)
    jmp_to(a, each_file)
    mark(a, named_yes)
    movi(a, rax, 1)
    jmp_to(a, named_out)
    mark(a, named_no)
    movi(a, rax, 0)
    mark(a, named_out)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_within: rax a file or folder's name, rdx a file's: rax 1 if the file is that file or folder, or
    # anywhere inside it, once each is where it really is (moth-native's within)
    set within_no to new_label(a)
    set within_yes to new_label(a)
    set within_out to new_label(a)
    mark(a, "rt_within")
    push_r(a, rbx)
    push_r(a, r12)
    mov_rr(a, rbx, rdx)
    lea(a, rdi, rip("real_a"))
    call_to(a, "rt_real_of")
    mov_rr(a, r12, rax)
    test_rr(a, r12, r12)
    jcc(a, cc_s, within_no)
    mov_rr(a, rax, rbx)
    lea(a, rdi, rip("real_b"))
    call_to(a, "rt_real_of")
    test_rr(a, rax, rax)
    jcc(a, cc_s, within_no)
    alu(a, "cmp", rax, r12)
    jcc(a, cc_b, within_no)
    lea(a, rsi, rip("real_a"))
    lea(a, rdi, rip("real_b"))
    mov_rr(a, rcx, r12)
    if target is "windows"
        raw(a, list of 0x66, 0xF3, 0xA7) # the same units
    else
        raw(a, list of 0xF3, 0xA6)
    end
    jcc(a, cc_ne, within_no)
    alu(a, "cmp", rax, r12) # the same, or what follows starts with a separator, or it ends with one
    jcc(a, cc_e, within_yes)
    if target is "windows"
        lea(a, rcx, rip("real_b"))
        mov_rr(a, rdx, r12)
        alu(a, "add", rdx, rdx)
        alu(a, "add", rcx, rdx)
        load16(a, rdx, mem(rcx, 0))
        alui(a, "cmp", rdx, 92)
        jcc(a, cc_e, within_yes)
        lea(a, rcx, rip("real_a"))
        mov_rr(a, rdx, r12)
        alu(a, "add", rdx, rdx)
        alu(a, "add", rcx, rdx)
        load16(a, rdx, mem(rcx, -2))
        alui(a, "cmp", rdx, 92)
        jcc(a, cc_e, within_yes)
    else
        lea(a, rcx, rip("real_b"))
        alu(a, "add", rcx, r12)
        load8(a, rdx, mem(rcx, 0))
        alui(a, "cmp", rdx, 47)
        jcc(a, cc_e, within_yes)
        lea(a, rcx, rip("real_a"))
        alu(a, "add", rcx, r12)
        load8(a, rdx, mem(rcx, -1))
        alui(a, "cmp", rdx, 47)
        jcc(a, cc_e, within_yes)
    end
    mark(a, within_no)
    movi(a, rax, 0)
    jmp_to(a, within_out)
    mark(a, within_yes)
    movi(a, rax, 1)
    mark(a, within_out)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_real_of: rax a file's name, rdi where its real path goes: rax how long it is (in UTF-16 units on
    # Windows, bytes on Linux), or -1 if it has none. One that's there is where its links lead; one that isn't
    # is in the folder it would be in, which must be there (moth-native's real_of)
    set real_out to new_label(a)
    set missing to new_label(a)
    set strip to new_label(a)
    set sep_end to new_label(a)
    set stripped to new_label(a)
    set seek_sep to new_label(a)
    set found_sep to new_label(a)
    set no_sep to new_label(a)
    set last_ok to new_label(a)
    set has_folder to new_label(a)
    set trim_folder to new_label(a)
    set folder_ok to new_label(a)
    set folder_made to new_label(a)
    set joined to new_label(a)
    set real_none to new_label(a)
    mark(a, "rt_real_of")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    mov_rr(a, rbx, rax)
    mov_rr(a, r12, rdi)
    call_to(a, "rt_path_of")
    mov_rr(a, r13, rax)
    call_to(a, "rt_exists")
    test_rr(a, rax, rax)
    jcc(a, cc_e, missing)
    mov_rr(a, rax, r13)
    mov_rr(a, rdi, r12)
    call_to(a, "rt_canonical")
    jmp_to(a, real_out)
    mark(a, missing) # its last part, without separators or a "." after it
    mov_rr(a, rax, rbx)
    untag(a, rax)
    load(a, r13, mem(rax, 16))
    load(a, r14, mem(rax, 0))
    mark(a, strip)
    test_rr(a, r14, r14)
    jcc(a, cc_e, real_none)
    mov_rr(a, rax, r13)
    alu(a, "add", rax, r14)
    load8(a, rax, mem(rax, -1))
    sep_byte_jump(a, target, rax, sep_end, stripped)
    mark(a, sep_end) # a separator at the end, but for one that is all of it
    alui(a, "cmp", r14, 1)
    jcc(a, cc_e, stripped)
    dec_r(a, r14)
    jmp_to(a, strip)
    mark(a, stripped)
    mov_rr(a, rax, r13)
    alu(a, "add", rax, r14)
    load8(a, rax, mem(rax, -1))
    alui(a, "cmp", rax, 46)
    set seek_last to new_label(a)
    jcc(a, cc_ne, seek_last)
    alui(a, "cmp", r14, 1) # "." alone has no name
    jcc(a, cc_e, real_none)
    mov_rr(a, rax, r13)
    alu(a, "add", rax, r14)
    load8(a, rax, mem(rax, -2))
    set dot_part to new_label(a)
    sep_byte_jump(a, target, rax, dot_part, seek_last)
    mark(a, dot_part) # a "." after a separator says nothing: without it, and on
    dec_r(a, r14)
    jmp_to(a, strip)
    mark(a, seek_last)
    mov_rr(a, rcx, r14)
    mark(a, seek_sep)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, no_sep)
    mov_rr(a, rax, r13)
    alu(a, "add", rax, rcx)
    load8(a, rax, mem(rax, -1))
    set before to new_label(a)
    sep_byte_jump(a, target, rax, found_sep, before)
    mark(a, before)
    dec_r(a, rcx)
    jmp_to(a, seek_sep)
    mark(a, no_sep)
    mark(a, found_sep) # rcx where the last part starts
    mov_rr(a, rdx, r14)
    alu(a, "sub", rdx, rcx)
    test_rr(a, rdx, rdx)
    jcc(a, cc_e, real_none)
    alui(a, "cmp", rdx, 2) # ".." has no name either
    jcc(a, cc_ne, last_ok)
    mov_rr(a, rax, r13)
    alu(a, "add", rax, rcx)
    load8(a, rsi, mem(rax, 0))
    load8(a, rax, mem(rax, 1))
    alui(a, "cmp", rsi, 46)
    jcc(a, cc_ne, last_ok)
    alui(a, "cmp", rax, 46)
    jcc(a, cc_e, real_none)
    mark(a, last_ok)
    push_r(a, rcx) # where the last part starts and how long it is
    push_r(a, rdx)
    lea(a, rax, rip(text_object(a, ".")))
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, folder_made)
    mark(a, has_folder) # the folder: up to the separator, without more separators before it
    dec_r(a, rcx)
    mark(a, trim_folder)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, folder_ok)
    mov_rr(a, rax, r13)
    alu(a, "add", rax, rcx)
    load8(a, rax, mem(rax, -1))
    set more_sep to new_label(a)
    sep_byte_jump(a, target, rax, more_sep, folder_ok)
    mark(a, more_sep)
    dec_r(a, rcx)
    jmp_to(a, trim_folder)
    mark(a, folder_ok)
    set not_root to new_label(a)
    test_rr(a, rcx, rcx) # the root, if that's all there was
    jcc(a, cc_ne, not_root)
    movi(a, rcx, 1)
    mark(a, not_root)
    if target is "windows" # C:\ for C:
        set not_drive to new_label(a)
        alui(a, "cmp", rcx, 2)
        jcc(a, cc_ne, not_drive)
        load8(a, rax, mem(r13, 1))
        alui(a, "cmp", rax, 58)
        jcc(a, cc_ne, not_drive)
        movi(a, rcx, 3)
        mark(a, not_drive)
    end
    mov_rr(a, rsi, r13)
    call_to(a, "rt_text_from")
    mark(a, folder_made) # its real path, then a separator, then the last part
    push_r(a, rax)
    call_to(a, "rt_path_of")
    mov_rr(a, rdi, r12)
    call_to(a, "rt_canonical")
    pop_r(a, rcx)
    pop_r(a, rdx)
    pop_r(a, rcx)
    test_rr(a, rax, rax)
    jcc(a, cc_s, real_none)
    mov_rr(a, r14, rax)
    if target is "windows"
        mov_rr(a, rax, r14)
        alu(a, "add", rax, rax)
        alu(a, "add", rax, r12)
        load16(a, rax, mem(rax, -2))
        alui(a, "cmp", rax, 92)
        jcc(a, cc_e, joined)
        mov_rr(a, rax, r14)
        alu(a, "add", rax, rax)
        alu(a, "add", rax, r12)
        store16i(a, mem(rax, 0), 92)
        inc_r(a, r14)
        mark(a, joined)
        push_r(a, rcx)
        push_r(a, rdx)
        win_enter(a)
        mov_rr(a, r8, r13)
        alu(a, "add", r8, rcx)
        mov_rr(a, r9, rdx)
        mov_rr(a, rax, r14)
        alu(a, "add", rax, rax)
        alu(a, "add", rax, r12)
        store(a, mem(rsp, 32), rax)
        movi(a, rax, 32767)
        alu(a, "sub", rax, r14)
        store(a, mem(rsp, 40), rax)
        movi(a, rcx, 65001)
        movi(a, rdx, 0)
        call_import(a, "imp_MultiByteToWideChar")
        win_leave(a)
        pop_r(a, rdx)
        pop_r(a, rcx)
        mov32_rr(a, rax, rax)
        test_rr(a, rax, rax)
        jcc(a, cc_e, real_none)
        alu(a, "add", r14, rax)
    else
        mov_rr(a, rax, r12)
        alu(a, "add", rax, r14)
        load8(a, rax, mem(rax, -1))
        alui(a, "cmp", rax, 47)
        jcc(a, cc_e, joined)
        mov_rr(a, rax, r12)
        alu(a, "add", rax, r14)
        store8i(a, mem(rax, 0), 47)
        inc_r(a, r14)
        mark(a, joined)
        mov_rr(a, rax, r14)
        alu(a, "add", rax, rdx)
        alui(a, "cmp", rax, 4096)
        jcc(a, cc_ae, real_none)
        mov_rr(a, rdi, r12)
        alu(a, "add", rdi, r14)
        mov_rr(a, rsi, r13)
        alu(a, "add", rsi, rcx)
        alu(a, "add", r14, rdx)
        mov_rr(a, rcx, rdx)
        rep_movsb(a)
    end
    mov_rr(a, rax, r14)
    jmp_to(a, real_out)
    mark(a, real_none)
    movi(a, rax, -1)
    mark(a, real_out)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_exists: rax a path from rt_path_of: rax 1 if there's something there, a link that leads nowhere too
    mark(a, "rt_exists")
    if target is "windows"
        win_enter(a)
        mov_rr(a, rcx, rax)
        call_import(a, "imp_GetFileAttributesW")
        win_leave(a)
        mov32_rr(a, rax, rax)
        movi(a, rcx, 4294967295)
        alu(a, "cmp", rax, rcx)
        setcc(a, cc_ne, rax)
        movzx8(a, rax, rax)
    else
        mov_rr(a, rdi, rax)
        lea(a, rsi, rip("stat_buf"))
        sys_call(a, 6) # lstat
        test_rr(a, rax, rax)
        setcc(a, cc_e, rax)
        movzx8(a, rax, rax)
    end
    ret(a)

    # rt_canonical: rax a path from rt_path_of, rdi where to put it: where it really is, its links followed, as
    # Rust's canonicalize has it; rax how long that is, or -1 if it can't be found
    set canon_none to new_label(a)
    set canon_out to new_label(a)
    mark(a, "rt_canonical")
    push_r(a, rbx)
    push_r(a, r12)
    mov_rr(a, r12, rdi)
    if target is "windows"
        win_enter(a)
        mov_rr(a, rcx, rax)
        movi(a, rdx, 0)
        movi(a, r8, 7)
        movi(a, r9, 0)
        storei(a, mem(rsp, 32), 3)
        storei(a, mem(rsp, 40), 0x02000000) # a folder can be opened too
        storei(a, mem(rsp, 48), 0)
        call_import(a, "imp_CreateFileW")
        win_leave(a)
        alui(a, "cmp", rax, -1)
        jcc(a, cc_e, canon_none)
        mov_rr(a, rbx, rax)
        win_enter(a)
        mov_rr(a, rcx, rbx)
        mov_rr(a, rdx, r12)
        movi(a, r8, 32768)
        movi(a, r9, 0)
        call_import(a, "imp_GetFinalPathNameByHandleW")
        mov32_rr(a, rdi, rax)
        mov_rr(a, rcx, rbx)
        call_import(a, "imp_CloseHandle")
        win_leave(a)
        mov_rr(a, rax, rdi)
        test_rr(a, rax, rax)
        jcc(a, cc_e, canon_none)
        alui(a, "cmp", rax, 32768)
        jcc(a, cc_ae, canon_none)
    else
        mov_rr(a, rdi, rax)
        movi(a, rsi, 0x280000) # O_PATH: only to find where it is
        movi(a, rdx, 0)
        sys_call(a, 2)
        test_rr(a, rax, rax)
        jcc(a, cc_s, canon_none)
        mov_rr(a, rbx, rax)
        point_at_text(a, "/proc/self/fd/") # then the link the system keeps for it, which says where it is
        lea(a, rdi, rip("proc_buf"))
        rep_movsb(a)
        push_r(a, rdi)
        mov_rr(a, rax, rbx)
        call_to(a, "rt_digits")
        pop_r(a, rdi)
        lea(a, rsi, rip("dbuf"))
        rep_movsb(a)
        store8i(a, mem(rdi, 0), 0)
        lea(a, rdi, rip("proc_buf"))
        mov_rr(a, rsi, r12)
        movi(a, rdx, 4096)
        sys_call(a, 89) # readlink
        push_r(a, rax)
        mov_rr(a, rdi, rbx)
        sys_call(a, 3)
        pop_r(a, rax)
        test_rr(a, rax, rax)
        jcc(a, cc_le, canon_none)
        alui(a, "cmp", rax, 4096)
        jcc(a, cc_ae, canon_none)
    end
    jmp_to(a, canon_out)
    mark(a, canon_none)
    movi(a, rax, -1)
    mark(a, canon_out)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_host_of: rax a site's address: rax 1 with its host (example.com:8080) in host_buf, in lowercase, how
    # long it is in host_len and how much of it is the name without the port in host_name_len; or rax 0 if
    # the address is written in any odd way, so a name given to --allow-net can't match it by mistake
    set host_none to new_label(a)
    set not_http to new_label(a)
    set schemed to new_label(a)
    set copy_host to new_label(a)
    set host_copied to new_label(a)
    set as_is to new_label(a)
    set bracket to new_label(a)
    set name_loop to new_label(a)
    set name_end to new_label(a)
    set name_char to new_label(a)
    set inner_loop to new_label(a)
    set inner_char to new_label(a)
    set inner_end to new_label(a)
    set port to new_label(a)
    set port_digits to new_label(a)
    set host_good to new_label(a)
    mark(a, "rt_host_of")
    untag(a, rax)
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    alui(a, "cmp", rcx, 7)
    jcc(a, cc_b, host_none)
    ascii_prefix(a, "http://", not_http)
    alui(a, "add", rsi, 7)
    alui(a, "sub", rcx, 7)
    jmp_to(a, schemed)
    mark(a, not_http)
    alui(a, "cmp", rcx, 8)
    jcc(a, cc_b, host_none)
    ascii_prefix(a, "https://", host_none)
    alui(a, "add", rsi, 8)
    alui(a, "sub", rcx, 8)
    mark(a, schemed) # the host, up to a /, ?, # or \, in lowercase
    lea(a, r9, rip("host_buf"))
    movi(a, rdx, 0)
    mark(a, copy_host)
    alu(a, "cmp", rdx, rcx)
    jcc(a, cc_ae, host_copied)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, rdx)
    load8(a, rax, mem(rax, 0))
    for each stop_at in list of 47, 63, 35, 92
        alui(a, "cmp", rax, stop_at)
        jcc(a, cc_e, host_copied)
    end
    mov_rr(a, r8, rax)
    alui(a, "sub", r8, 65)
    alui(a, "cmp", r8, 25)
    jcc(a, cc_a, as_is)
    alui(a, "add", rax, 32)
    mark(a, as_is)
    alui(a, "cmp", rdx, 4096)
    jcc(a, cc_ae, host_none)
    mov_rr(a, r8, r9)
    alu(a, "add", r8, rdx)
    store8(a, mem(r8, 0), rax)
    inc_r(a, rdx)
    jmp_to(a, copy_host)
    mark(a, host_copied)
    store(a, rip("host_len"), rdx)
    test_rr(a, rdx, rdx)
    jcc(a, cc_e, host_none)
    load8(a, rax, mem(r9, 0))
    alui(a, "cmp", rax, 91)
    jcc(a, cc_e, bracket)
    movi(a, r8, 0) # a name of a to z, digits, dots and dashes, up to a :
    mark(a, name_loop)
    alu(a, "cmp", r8, rdx)
    jcc(a, cc_ae, name_end)
    mov_rr(a, rax, r9)
    alu(a, "add", rax, r8)
    load8(a, rax, mem(rax, 0))
    alui(a, "cmp", rax, 58)
    jcc(a, cc_e, name_end)
    alui(a, "cmp", rax, 46)
    jcc(a, cc_e, name_char)
    alui(a, "cmp", rax, 45)
    jcc(a, cc_e, name_char)
    mov_rr(a, rcx, rax)
    alui(a, "sub", rcx, 97)
    alui(a, "cmp", rcx, 25)
    jcc(a, cc_be, name_char)
    alui(a, "sub", rax, 48)
    alui(a, "cmp", rax, 9)
    jcc(a, cc_a, host_none)
    mark(a, name_char)
    inc_r(a, r8)
    jmp_to(a, name_loop)
    mark(a, name_end)
    test_rr(a, r8, r8)
    jcc(a, cc_e, host_none)
    jmp_to(a, port)
    mark(a, bracket) # [ then hex digits, colons and dots, then ]
    movi(a, r8, 1)
    mark(a, inner_loop)
    alu(a, "cmp", r8, rdx)
    jcc(a, cc_ae, host_none)
    mov_rr(a, rax, r9)
    alu(a, "add", rax, r8)
    load8(a, rax, mem(rax, 0))
    alui(a, "cmp", rax, 93)
    jcc(a, cc_e, inner_end)
    alui(a, "cmp", rax, 58)
    jcc(a, cc_e, inner_char)
    alui(a, "cmp", rax, 46)
    jcc(a, cc_e, inner_char)
    mov_rr(a, rcx, rax)
    alui(a, "sub", rcx, 97)
    alui(a, "cmp", rcx, 5)
    jcc(a, cc_be, inner_char)
    alui(a, "sub", rax, 48)
    alui(a, "cmp", rax, 9)
    jcc(a, cc_a, host_none)
    mark(a, inner_char)
    inc_r(a, r8)
    jmp_to(a, inner_loop)
    mark(a, inner_end)
    alui(a, "cmp", r8, 1)
    jcc(a, cc_e, host_none)
    inc_r(a, r8)
    mark(a, port) # then nothing, or a : and digits
    store(a, rip("host_name_len"), r8)
    alu(a, "cmp", r8, rdx)
    jcc(a, cc_e, host_good)
    mov_rr(a, rax, r9)
    alu(a, "add", rax, r8)
    load8(a, rax, mem(rax, 0))
    alui(a, "cmp", rax, 58)
    jcc(a, cc_ne, host_none)
    inc_r(a, r8)
    alu(a, "cmp", r8, rdx)
    jcc(a, cc_e, host_none)
    mark(a, port_digits)
    alu(a, "cmp", r8, rdx)
    jcc(a, cc_ae, host_good)
    mov_rr(a, rax, r9)
    alu(a, "add", rax, r8)
    load8(a, rax, mem(rax, 0))
    alui(a, "sub", rax, 48)
    alui(a, "cmp", rax, 9)
    jcc(a, cc_a, host_none)
    inc_r(a, r8)
    jmp_to(a, port_digits)
    mark(a, host_good)
    movi(a, rax, 1)
    ret(a)
    mark(a, host_none)
    movi(a, rax, 0)
    ret(a)
end

# jumps to `is_sep` if the byte in register r separates a path's parts (/, and \ on Windows), else to
# `not_sep`
to sep_byte_jump with a, target, r, is_sep, not_sep
    alui(a, "cmp", r, 47)
    jcc(a, cc_e, is_sep)
    if target is "windows"
        alui(a, "cmp", r, 92)
        jcc(a, cc_e, is_sep)
    end
    jmp_to(a, not_sep)
end

to emit_reading with a, target
    # rt_read: xmm0 a file's name (or a site's), rdx 1 for its bytes or 0 for its text: what it holds, into
    # xmm0 with rax 0; or rax 2 with err_why 20 (the name isn't text), 21 (it can't be read), 22 (there is no
    # such file) or 27 (it's too long a text)
    set not_text to new_label(a)
    set refused to new_label(a)
    set offline to new_label(a)
    set nul_name to new_label(a)
    set open_failed to new_label(a)
    set no_file to new_label(a)
    set more to new_label(a)
    set room_left to new_label(a)
    set read_failed to new_label(a)
    set all_read to new_label(a)
    set as_text to new_label(a)
    set too_long to new_label(a)
    set failed to new_label(a)
    set gave_up to new_label(a)
    set read_out to new_label(a)
    mark(a, "rt_read")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    mov_rr(a, r12, rdx)
    movq_rx(a, rax, xmm0)
    store(a, rip("err_file"), rax)
    store(a, rip("err_a"), rax)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_ne, not_text)
    call_to(a, "rt_is_site")
    mov_rr(a, r13, rax)
    mov_rr(a, rcx, rax)
    alu(a, "add", rcx, rcx)
    call_to(a, "rt_permit")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, refused)
    test_rr(a, r13, r13)
    jcc(a, cc_ne, offline)
    call_to(a, "rt_name_nul")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, nul_name)
    call_to(a, "rt_file_path")
    mov_rr(a, rbx, rax)
    call_to(a, "rt_file_open_read")
    alui(a, "cmp", rax, -1)
    jcc(a, cc_e, open_failed)
    mov_rr(a, r13, rax)
    movi(a, rcx, 65536) # what it holds, in memory that doubles as it fills
    store(a, rip("f_room"), rcx)
    storei(a, rip("f_used"), 0)
    call_to(a, "rt_alloc_raw")
    mov_rr(a, r14, rax)
    mark(a, more)
    load(a, rcx, rip("f_room"))
    alu_load(a, "sub", rcx, rip("f_used"))
    jcc(a, cc_ne, room_left)
    load(a, rcx, rip("f_room"))
    alu(a, "add", rcx, rcx)
    store(a, rip("f_room"), rcx)
    call_to(a, "rt_alloc_raw")
    mov_rr(a, rdi, rax)
    mov_rr(a, rsi, r14)
    load(a, rcx, rip("f_used"))
    rep_movsb(a)
    mov_rr(a, r14, rax)
    load(a, rcx, rip("f_room"))
    alu_load(a, "sub", rcx, rip("f_used"))
    mark(a, room_left)
    mov_rr(a, rax, r13)
    mov_rr(a, rsi, r14)
    alu_load(a, "add", rsi, rip("f_used"))
    call_to(a, "rt_file_read_some")
    alui(a, "cmp", rax, -1)
    jcc(a, cc_e, read_failed)
    test_rr(a, rax, rax)
    jcc(a, cc_e, all_read)
    alu_store(a, "add", rip("f_used"), rax)
    jmp_to(a, more)
    mark(a, all_read)
    mov_rr(a, rax, r13)
    call_to(a, "rt_file_close")
    test_rr(a, r12, r12)
    jcc(a, cc_e, as_text)
    load(a, rcx, rip("f_used")) # its bytes
    call_to(a, "rt_bytes_new")
    mov_rr(a, rbx, rax)
    load(a, rdi, mem(rax, 8))
    mov_rr(a, rsi, r14)
    load(a, rcx, rip("f_used"))
    rep_movsb(a)
    mov_rr(a, rax, rbx)
    movi64(a, rcx, tag_bytes)
    alu(a, "or", rax, rcx)
    movq_xr(a, xmm0, rax)
    movi(a, rax, 0)
    jmp_to(a, read_out)
    mark(a, as_text) # its text, which keeps a byte order mark, as Rust's from_utf8_lossy and Node's toString do
    mov_rr(a, rsi, r14)
    load(a, rcx, rip("f_used"))
    call_to(a, "rt_decode_bytes")
    call_to(a, "rt_b_fits")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, too_long)
    call_to(a, "rt_b_text")
    movq_xr(a, xmm0, rax)
    movi(a, rax, 0)
    jmp_to(a, read_out)
    mark(a, read_failed)
    push_r(a, rdx)
    mov_rr(a, rax, r13)
    call_to(a, "rt_file_close")
    pop_r(a, rdx)
    jmp_to(a, failed)
    mark(a, open_failed) # no such file is a mistake of its own
    missing_jump(a, target, no_file)
    mark(a, failed) # rdx the system's code, rbx the path
    mov_rr(a, rax, rbx)
    movi(a, rcx, 0)
    call_to(a, "rt_file_reason")
    storei(a, rip("err_why"), 21)
    jmp_to(a, gave_up)
    mark(a, no_file)
    storei(a, rip("err_why"), 22)
    jmp_to(a, gave_up)
    mark(a, not_text)
    storei(a, rip("err_why"), 20)
    jmp_to(a, gave_up)
    mark(a, refused) # err_reason says why
    storei(a, rip("err_why"), 21)
    jmp_to(a, gave_up)
    mark(a, offline)
    call_to(a, "rt_b_reset")
    b_text(a, "couldn't reach it (a program in machine code can't go online yet)")
    call_to(a, "rt_b_text")
    store(a, rip("err_reason"), rax)
    storei(a, rip("err_why"), 21)
    jmp_to(a, gave_up)
    mark(a, nul_name)
    nul_reason(a, target)
    storei(a, rip("err_why"), 21)
    jmp_to(a, gave_up)
    mark(a, too_long)
    storei(a, rip("err_why"), 27)
    mark(a, gave_up)
    movi(a, rax, 2)
    mark(a, read_out)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
end

to emit_writing with a, target
    # rt_write_file: xmm0 a value, xmm1 a file's name: the file gets bytes as they are, anything else as `say`
    # shows it; rax 0, or 2 with err_why 20 (the name isn't text), 23 (it can't be written) or 27 (too long a
    # text). What it is is shown before the program is let write, as the engines show it, and again after.
    set not_text to new_label(a)
    set shown_fits to new_label(a)
    set refused to new_label(a)
    set nul_name to new_label(a)
    set as_bytes to new_label(a)
    set as_text to new_label(a)
    set have_bytes to new_label(a)
    set more to new_label(a)
    set all_written to new_label(a)
    set write_failed to new_label(a)
    set failed to new_label(a)
    set too_long to new_label(a)
    set gave_up to new_label(a)
    set write_out to new_label(a)
    mark(a, "rt_write_file")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    movq_rx(a, r12, xmm0)
    movq_rx(a, rax, xmm1)
    store(a, rip("err_file"), rax)
    store(a, rip("err_a"), rax)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_ne, not_text)
    mov_rr(a, rax, r12)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_e, shown_fits)
    alui(a, "cmp", rax, kind_bytes)
    jcc(a, cc_e, shown_fits)
    call_to(a, "rt_b_reset") # anything else as `say` shows it, which mustn't be too long a text
    mov_rr(a, rax, r12)
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    call_to(a, "rt_b_fits")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, too_long)
    mark(a, shown_fits)
    movi(a, rcx, 1)
    call_to(a, "rt_permit")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, refused)
    call_to(a, "rt_name_nul")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, nul_name)
    call_to(a, "rt_file_path")
    mov_rr(a, rbx, rax)
    if target is "linux" # bytes that are a Linux program can run, as moth build --exe makes them: 0o777, else 0o666
        set plain_file to new_label(a)
        movi(a, r8, 438)
        mov_rr(a, rcx, r12)
        shifti(a, "shr", rcx, 48)
        alui(a, "cmp", rcx, kind_bytes)
        jcc(a, cc_ne, plain_file)
        mov_rr(a, rcx, r12)
        untag(a, rcx)
        load(a, rdx, mem(rcx, 0))
        alui(a, "cmp", rdx, 4)
        jcc(a, cc_b, plain_file)
        load(a, rdx, mem(rcx, 8))
        load32(a, rdx, mem(rdx, 0))
        alui(a, "cmp", rdx, 0x464C457F) # 0x7F, then "ELF"
        jcc(a, cc_ne, plain_file)
        movi(a, r8, 511)
        mark(a, plain_file)
    end
    call_to(a, "rt_file_open_write")
    alui(a, "cmp", rax, -1)
    jcc(a, cc_e, failed)
    mov_rr(a, r13, rax)
    mov_rr(a, rax, r12) # where its bytes are, in r14, and how many
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_bytes)
    jcc(a, cc_e, as_bytes)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_e, as_text)
    call_to(a, "rt_b_reset")
    mov_rr(a, rax, r12)
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    load(a, r14, rip("b_ptr"))
    load(a, rcx, rip("b_len"))
    jmp_to(a, have_bytes)
    mark(a, as_bytes)
    mov_rr(a, rax, r12)
    untag(a, rax)
    load(a, rcx, mem(rax, 0))
    load(a, r14, mem(rax, 8))
    jmp_to(a, have_bytes)
    mark(a, as_text)
    mov_rr(a, rax, r12)
    untag(a, rax)
    load(a, rcx, mem(rax, 0))
    load(a, r14, mem(rax, 16))
    mark(a, have_bytes)
    store(a, rip("f_used"), rcx)
    mark(a, more)
    load(a, rcx, rip("f_used"))
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, all_written)
    mov_rr(a, rax, r13)
    mov_rr(a, rsi, r14)
    call_to(a, "rt_file_write_some")
    alui(a, "cmp", rax, -1)
    jcc(a, cc_e, write_failed)
    test_rr(a, rax, rax)
    jcc(a, cc_e, all_written)
    alu(a, "add", r14, rax)
    alu_store(a, "sub", rip("f_used"), rax)
    jmp_to(a, more)
    mark(a, all_written)
    mov_rr(a, rax, r13)
    call_to(a, "rt_file_close")
    movi(a, rax, 0)
    jmp_to(a, write_out)
    mark(a, write_failed)
    push_r(a, rdx)
    mov_rr(a, rax, r13)
    call_to(a, "rt_file_close")
    pop_r(a, rdx)
    mark(a, failed) # rdx the system's code, rbx the path
    mov_rr(a, rax, rbx)
    movi(a, rcx, 1)
    call_to(a, "rt_file_reason")
    storei(a, rip("err_why"), 23)
    jmp_to(a, gave_up)
    mark(a, not_text)
    storei(a, rip("err_why"), 20)
    jmp_to(a, gave_up)
    mark(a, refused) # err_reason says why
    storei(a, rip("err_why"), 23)
    jmp_to(a, gave_up)
    mark(a, nul_name)
    nul_reason(a, target)
    storei(a, rip("err_why"), 23)
    jmp_to(a, gave_up)
    mark(a, too_long)
    storei(a, rip("err_why"), 27)
    mark(a, gave_up)
    movi(a, rax, 2)
    mark(a, write_out)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
end

to emit_arguments with a, target
    # rt_arguments: what the program was started with after its own name, as a new list of text, into xmm0,
    # with rax 0. On Windows the command line is split as Rust's std::env::args splits it.
    mark(a, "rt_arguments")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    movi(a, rsi, 0)
    movi(a, rcx, 0)
    call_to(a, "rt_list_make")
    mov_rr(a, rbx, rax)
    set done to new_label(a)
    if target is "windows"
        set name_loop to new_label(a)
        set name_other to new_label(a)
        set name_char to new_label(a)
        set skip_space to new_label(a)
        set arg_start to new_label(a)
        set arg_loop to new_label(a)
        set plain to new_label(a)
        set not_space to new_label(a)
        set backslashes to new_label(a)
        set counted to new_label(a)
        set halved to new_label(a)
        set literal to new_label(a)
        set put_them to new_label(a)
        set quote_mark to new_label(a)
        set not_double to new_label(a)
        set open_quote to new_label(a)
        set line_end to new_label(a)
        set push_last to new_label(a)
        set between to new_label(a)
        win_enter(a) # the command line, as UTF-8 in memory of its own
        call_import(a, "imp_GetCommandLineW")
        mov_rr(a, r12, rax)
        movi(a, rcx, 65001)
        movi(a, rdx, 0)
        mov_rr(a, r8, r12)
        movi(a, r9, -1)
        storei(a, mem(rsp, 32), 0)
        storei(a, mem(rsp, 40), 0)
        storei(a, mem(rsp, 48), 0)
        storei(a, mem(rsp, 56), 0)
        call_import(a, "imp_WideCharToMultiByte")
        mov32_rr(a, r13, rax)
        win_leave(a)
        lea(a, rcx, mem(r13, 1))
        call_to(a, "rt_alloc_raw")
        mov_rr(a, r14, rax)
        win_enter(a)
        movi(a, rcx, 65001)
        movi(a, rdx, 0)
        mov_rr(a, r8, r12)
        movi(a, r9, -1)
        store(a, mem(rsp, 32), r14)
        store(a, mem(rsp, 40), r13)
        storei(a, mem(rsp, 48), 0)
        storei(a, mem(rsp, 56), 0)
        call_import(a, "imp_WideCharToMultiByte")
        win_leave(a)
        mov_rr(a, r12, r14) # r12 goes through it
        movi(a, r13, 0) # first the program's own name: to a space or tab outside quotes, which only toggle
        mark(a, name_loop)
        load8(a, rax, mem(r12, 0))
        test_rr(a, rax, rax)
        jcc(a, cc_e, done)
        alui(a, "cmp", rax, 34)
        jcc(a, cc_ne, name_other)
        alui(a, "xor", r13, 1)
        inc_r(a, r12)
        jmp_to(a, name_loop)
        mark(a, name_other)
        test_rr(a, r13, r13)
        jcc(a, cc_ne, name_char)
        alui(a, "cmp", rax, 32)
        jcc(a, cc_e, skip_space)
        alui(a, "cmp", rax, 9)
        jcc(a, cc_e, skip_space)
        mark(a, name_char)
        inc_r(a, r12)
        jmp_to(a, name_loop)
        mark(a, skip_space) # then each argument after spaces and tabs
        load8(a, rax, mem(r12, 0))
        alui(a, "cmp", rax, 32)
        jcc(a, cc_e, between)
        alui(a, "cmp", rax, 9)
        jcc(a, cc_ne, arg_start)
        mark(a, between)
        inc_r(a, r12)
        jmp_to(a, skip_space)
        mark(a, arg_start)
        test_rr(a, rax, rax)
        jcc(a, cc_e, done)
        call_to(a, "rt_b_reset")
        movi(a, r13, 0) # 1 inside quotes
        mark(a, arg_loop)
        load8(a, rax, mem(r12, 0))
        test_rr(a, rax, rax)
        jcc(a, cc_e, line_end)
        alui(a, "cmp", rax, 92)
        jcc(a, cc_e, backslashes)
        alui(a, "cmp", rax, 34)
        jcc(a, cc_e, quote_mark)
        alui(a, "cmp", rax, 32)
        jcc(a, cc_e, not_space)
        alui(a, "cmp", rax, 9)
        jcc(a, cc_ne, plain)
        mark(a, not_space) # a space or tab: inside quotes it's the argument's own, else it ends it
        test_rr(a, r13, r13)
        jcc(a, cc_ne, plain)
        call_to(a, "rt_b_text")
        mov_rr(a, rdx, rax)
        mov_rr(a, rax, rbx)
        call_to(a, "rt_list_push")
        jmp_to(a, skip_space)
        mark(a, plain)
        call_to(a, "rt_b_byte")
        inc_r(a, r12)
        jmp_to(a, arg_loop)
        mark(a, backslashes) # backslashes: halved before a quote, which an odd number of them makes a quote
        movi(a, r14, 0)
        mark(a, counted)
        load8(a, rax, mem(r12, 0))
        alui(a, "cmp", rax, 92)
        jcc(a, cc_ne, halved)
        inc_r(a, r14)
        inc_r(a, r12)
        jmp_to(a, counted)
        mark(a, halved)
        alui(a, "cmp", rax, 34)
        jcc(a, cc_ne, literal)
        mov_rr(a, rax, r14)
        alui(a, "and", rax, 1)
        push_r(a, rax)
        shifti(a, "shr", r14, 1)
        call_to(a, put_them)
        pop_r(a, rax)
        test_rr(a, rax, rax)
        jcc(a, cc_e, arg_loop)
        movi(a, rax, 34)
        call_to(a, "rt_b_byte")
        inc_r(a, r12)
        jmp_to(a, arg_loop)
        mark(a, literal)
        call_to(a, put_them)
        jmp_to(a, arg_loop)
        mark(a, quote_mark)
        test_rr(a, r13, r13)
        jcc(a, cc_e, open_quote)
        load8(a, rax, mem(r12, 1)) # inside quotes: "" is a quote, the end of the line leaves it open
        alui(a, "cmp", rax, 34)
        jcc(a, cc_ne, not_double)
        call_to(a, "rt_b_byte")
        alui(a, "add", r12, 2)
        jmp_to(a, arg_loop)
        mark(a, not_double)
        inc_r(a, r12)
        test_rr(a, rax, rax)
        jcc(a, cc_e, arg_loop)
        movi(a, r13, 0)
        jmp_to(a, arg_loop)
        mark(a, open_quote)
        movi(a, r13, 1)
        inc_r(a, r12)
        jmp_to(a, arg_loop)
        mark(a, line_end) # the last argument, if anything was in it or quotes were open
        load(a, rax, rip("b_len"))
        test_rr(a, rax, rax)
        jcc(a, cc_ne, push_last)
        test_rr(a, r13, r13)
        jcc(a, cc_e, done)
        mark(a, push_last)
        call_to(a, "rt_b_text")
        mov_rr(a, rdx, rax)
        mov_rr(a, rax, rbx)
        call_to(a, "rt_list_push")
        jmp_to(a, done)
        set again to new_label(a) # put_them: r14 backslashes into the builder
        set put_done to new_label(a)
        mark(a, put_them)
        mark(a, again)
        test_rr(a, r14, r14)
        jcc(a, cc_e, put_done)
        movi(a, rax, 92)
        call_to(a, "rt_b_byte")
        dec_r(a, r14)
        jmp_to(a, again)
        mark(a, put_done)
        ret(a)
    else
        set each_arg to new_label(a)
        set measure to new_label(a)
        set measured to new_label(a)
        movi(a, r12, 1) # argv[1] on, from the stack the program started with
        mark(a, each_arg)
        alu_load(a, "cmp", r12, rip("arg_count"))
        jcc(a, cc_ae, done)
        load(a, rax, rip("arg_vector"))
        mov_rr(a, rcx, r12)
        shifti(a, "shl", rcx, 3)
        alu(a, "add", rax, rcx)
        load(a, rsi, mem(rax, 0))
        movi(a, rcx, 0)
        mark(a, measure)
        mov_rr(a, rax, rsi)
        alu(a, "add", rax, rcx)
        load8(a, rax, mem(rax, 0))
        test_rr(a, rax, rax)
        jcc(a, cc_e, measured)
        inc_r(a, rcx)
        jmp_to(a, measure)
        mark(a, measured)
        call_to(a, "rt_decode_bytes")
        call_to(a, "rt_b_text")
        mov_rr(a, rdx, rax)
        mov_rr(a, rax, rbx)
        call_to(a, "rt_list_push")
        inc_r(a, r12)
        jmp_to(a, each_arg)
    end
    mark(a, done)
    movq_xr(a, xmm0, rbx)
    movi(a, rax, 0)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
end

to emit_file_why with a
    # rt_why_file: what went wrong with a file, a site or a question, from err_why, into the builder
    set w21 to new_label(a)
    set w22 to new_label(a)
    set w23 to new_label(a)
    set w24 to new_label(a)
    set w26 to new_label(a)
    set w27 to new_label(a)
    mark(a, "rt_why_file")
    load(a, rax, rip("err_why"))
    for each pair in list of (list of 21, w21), (list of 22, w22), (list of 23, w23), (list of 24, w24), (list of 26, w26),
        (list of 27, w27)
        alui(a, "cmp", rax, item 1 of pair)
        jcc(a, cc_e, item 2 of pair)
    end
    b_text(a, "a file name is text, not ") # 20
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w21)
    b_text(a, "can't read '")
    file_name_text(a)
    b_text(a, "': ")
    reason_text(a)
    ret(a)
    mark(a, w22)
    b_text(a, "there is no file called '")
    file_name_text(a)
    b_text(a, "'")
    ret(a)
    mark(a, w23)
    b_text(a, "can't write '")
    file_name_text(a)
    b_text(a, "': ")
    reason_text(a)
    ret(a)
    mark(a, w24)
    b_text(a, "can't remove '")
    file_name_text(a)
    b_text(a, "': ")
    reason_text(a)
    ret(a)
    mark(a, w26)
    b_text(a, "there was no answer to this question: the input ended")
    ret(a)
    mark(a, w27)
    b_text(a, too_big)
    ret(a)
end

# `read`, `ask` and `arguments`, whose values come from outside the program: into xmm0
to gen_outside with fc, e
    set a to a of fc
    if kind of e is "arguments"
        call_to(a, "rt_arguments")
        return nothing
    end
    if kind of e is "read"
        gen_expr(fc, subject of e)
        movi(a, rdx, 0)
        if binary of e
            movi(a, rdx, 1)
        end
        call_to(a, "rt_read")
    else
        set question to question of e
        if kind of question is not "value" or type of question is not "string"
            set uses_pad of st of fc to yes
        else if asks_drawing(value of question)
            set uses_pad of st of fc to yes
        end
        gen_expr(fc, question)
        call_to(a, "rt_ask")
    end
    why_stub(fc, at of e, "rt_why_file")
end

# `move forward 10`, `pen color "red"`, `draw box at x, y size w by h` and the rest: the value, if there is
# one, then what to do with it, as vm.js's TURTLE_ACTIONS counts them
to gen_turtle with fc, s
    set a to a of fc
    if action of s is "chart"
        not_yet(at of s, "'draw chart of'")
    end
    set uses_drawing of st of fc to yes
    if value of s is nothing
        load_bits(a, xmm0, bits_nothing)
    else
        gen_expr(fc, value of s)
    end
    movi(a, rcx, slot_of_word(front's turtle_actions, action of s) - 1)
    call_to(a, "rt_turtle")
    why_stub(fc, at of s, "rt_why_turtle")
end

# `when a key is pressed with key` and the rest, and `every 2 seconds`: the handler is a function of its own,
# made here and handed to the runtime, which calls it when that happens
to gen_handler with fc, s
    set a to a of fc
    set uses_app of st of fc to yes
    set handler to new_function(st of fc, fn of s, scope of fc, level of fc + 1)
    set waiting to pending of st of fc
    add handler to waiting
    if kind of s is "every"
        gen_expr(fc, interval of s)
        push_value(fc)
    end
    lea(a, rcx, rip(label of handler))
    movi(a, rdx, 0)
    lea(a, r8, rip(info of handler))
    call_to(a, "rt_closure")
    if kind of s is "every"
        mov_rr(a, r9, rax)
        pop_value(fc, xmm0)
        mov_rr(a, rax, r9)
        movi(a, rcx, unit of s)
        movi(a, rdx, 0)
        call_to(a, "rt_every")
        why_stub(fc, at of s, "rt_why_turtle")
    else
        movi(a, rcx, slot_of_word(front's event_names, event of s) - 1)
        movi(a, rdx, length of params of fn of s)
        call_to(a, "rt_on")
    end
end

# where `w` is in `words`, from 1
to slot_of_word with words, w
    set at_slot to 0
    for each candidate in words
        add 1 to at_slot
        if candidate is w
            return at_slot
        end
    end
    return 0
end

# `write value to name`
to gen_write with fc, s
    gen_pair(fc, value of s, target of s)
    call_to(a of fc, "rt_write_file")
    why_stub(fc, at of s, "rt_why_file")
end

# ---------- the runtime: starting another program, and removing a file ----------
# `run program` starts another program, with the same input and output as this one, waits for it, and gives
# the number it ended with; `remove the file` removes one. A program may only start another if it was built
# with --allow-run, or a person at a terminal says yes, the way reading and writing files are allowed.

to emit_run with a, target
    for each slot_name in list of "run_code", "run_status", "env_vector"
        reserve(a, slot_name, 8, 8)
    end
    if target is "windows"
        reserve(a, "run_si", 112, 16)
        reserve(a, "run_pi", 32, 16)
    end
    if target is "windows"
        emit_command_line(a)
    else
        emit_program_path(a)
    end
    emit_run_program(a, target)
    emit_remove_file(a, target)
    emit_run_why(a)
end

# rt_b_arg: rax a text: into the builder as one argument of a Windows command line, in quotes if it holds a
# space, a tab or a quote, or nothing at all, with the backslashes before a quote doubled, and those at its
# end doubled too, as Rust's std::process writes a command line
to emit_command_line with a
    set look to new_label(a)
    set plainly to new_label(a)
    set quoted to new_label(a)
    set walk to new_label(a)
    set a_slash to new_label(a)
    set a_quote to new_label(a)
    set ended to new_label(a)
    set slashes_out to new_label(a)
    set more_slashes to new_label(a)
    set no_more to new_label(a)
    set arg_done to new_label(a)
    mark(a, "rt_b_arg")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    untag(a, rax)
    load(a, r12, mem(rax, 16))
    load(a, r13, mem(rax, 0))
    test_rr(a, r13, r13)
    jcc(a, cc_e, quoted)
    movi(a, rbx, 0)
    mark(a, look)
    alu(a, "cmp", rbx, r13)
    jcc(a, cc_ae, plainly)
    mov_rr(a, rax, r12)
    alu(a, "add", rax, rbx)
    load8(a, rax, mem(rax, 0))
    for each one in list of 32, 9, 34
        alui(a, "cmp", rax, one)
        jcc(a, cc_e, quoted)
    end
    inc_r(a, rbx)
    jmp_to(a, look)
    mark(a, plainly)
    mov_rr(a, rsi, r12)
    mov_rr(a, rcx, r13)
    call_to(a, "rt_b_bytes")
    jmp_to(a, arg_done)
    mark(a, quoted)
    movi(a, rax, 34)
    call_to(a, "rt_b_byte")
    movi(a, rbx, 0)
    movi(a, r14, 0) # backslashes waiting to go out
    mark(a, walk)
    alu(a, "cmp", rbx, r13)
    jcc(a, cc_ae, ended)
    mov_rr(a, rax, r12)
    alu(a, "add", rax, rbx)
    load8(a, rax, mem(rax, 0))
    inc_r(a, rbx)
    alui(a, "cmp", rax, 92)
    jcc(a, cc_e, a_slash)
    alui(a, "cmp", rax, 34)
    jcc(a, cc_e, a_quote)
    push_r(a, rax)
    call_to(a, slashes_out)
    pop_r(a, rax)
    call_to(a, "rt_b_byte")
    jmp_to(a, walk)
    mark(a, a_slash)
    inc_r(a, r14)
    jmp_to(a, walk)
    mark(a, a_quote) # twice as many backslashes, then \" for the quote itself
    alu(a, "add", r14, r14)
    call_to(a, slashes_out)
    movi(a, rax, 92)
    call_to(a, "rt_b_byte")
    movi(a, rax, 34)
    call_to(a, "rt_b_byte")
    jmp_to(a, walk)
    mark(a, ended) # the ones at its end, twice as many, then the quote that closes it
    alu(a, "add", r14, r14)
    call_to(a, slashes_out)
    movi(a, rax, 34)
    call_to(a, "rt_b_byte")
    jmp_to(a, arg_done)
    mark(a, slashes_out) # r14 backslashes, and none left waiting
    mark(a, more_slashes)
    test_rr(a, r14, r14)
    jcc(a, cc_e, no_more)
    movi(a, rax, 92)
    call_to(a, "rt_b_byte")
    dec_r(a, r14)
    jmp_to(a, more_slashes)
    mark(a, no_more)
    ret(a)
    mark(a, arg_done)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
end

# Linux has no search of its own: rt_run_path: rax a text, a program's name: where its path is, as bytes
# with a 0 after them, in rax, or 0 if there is no program of that name that may be run. A name with a / in
# it is the path; any other is looked for in each of the folders PATH names, in order, as execvp does, with
# an empty one meaning the folder the program runs in.
to emit_program_path with a
    set can_run_no to new_label(a)
    set seek_slash to new_label(a)
    set has_slash to new_label(a)
    set no_slash to new_label(a)
    set each_env to new_label(a)
    set next_env to new_label(a)
    set measure_path to new_label(a)
    set measured_path to new_label(a)
    set each_folder to new_label(a)
    set folder_byte to new_label(a)
    set folder_end to new_label(a)
    set empty_folder to new_label(a)
    set folder_copied to new_label(a)
    set found_it to new_label(a)
    set path_none to new_label(a)
    set path_out to new_label(a)
    mark(a, "rt_can_run") # rdi a path with a 0 after it: rax 1 if there is a program there that may be run
    movi(a, rsi, 1)
    sys_call(a, 21)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, can_run_no)
    movi(a, rax, 1)
    ret(a)
    mark(a, can_run_no)
    movi(a, rax, 0)
    ret(a)

    mark(a, "rt_run_path")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    untag(a, rax)
    load(a, r12, mem(rax, 16))
    load(a, r13, mem(rax, 0))
    movi(a, rbx, 0)
    mark(a, seek_slash)
    alu(a, "cmp", rbx, r13)
    jcc(a, cc_ae, no_slash)
    mov_rr(a, rax, r12)
    alu(a, "add", rax, rbx)
    load8(a, rax, mem(rax, 0))
    alui(a, "cmp", rax, 47)
    jcc(a, cc_e, has_slash)
    inc_r(a, rbx)
    jmp_to(a, seek_slash)
    mark(a, has_slash) # the name itself, if there is a program there
    lea(a, rcx, mem(r13, 1))
    call_to(a, "rt_alloc_raw")
    mov_rr(a, rbx, rax)
    mov_rr(a, rdi, rax)
    mov_rr(a, rsi, r12)
    mov_rr(a, rcx, r13)
    rep_movsb(a)
    mov_rr(a, rdi, rbx)
    call_to(a, "rt_can_run")
    test_rr(a, rax, rax)
    jcc(a, cc_e, path_none)
    mov_rr(a, rax, rbx)
    jmp_to(a, path_out)
    mark(a, no_slash) # PATH, among what the program was started with
    load(a, r14, rip("env_vector"))
    test_rr(a, r14, r14)
    jcc(a, cc_e, path_none)
    mark(a, each_env)
    load(a, rsi, mem(r14, 0))
    test_rr(a, rsi, rsi)
    jcc(a, cc_e, path_none)
    set k to 0
    for each c in "PATH="
        load8(a, rax, mem(rsi, k))
        alui(a, "cmp", rax, byte 1 of (c as bytes))
        jcc(a, cc_ne, next_env)
        add 1 to k
    end
    lea(a, r14, mem(rsi, 5)) # the folders, and room for the longest of them with the name after it
    movi(a, rcx, 0)
    mark(a, measure_path)
    mov_rr(a, rax, r14)
    alu(a, "add", rax, rcx)
    load8(a, rax, mem(rax, 0))
    test_rr(a, rax, rax)
    jcc(a, cc_e, measured_path)
    inc_r(a, rcx)
    jmp_to(a, measure_path)
    mark(a, measured_path)
    alu(a, "add", rcx, r13)
    alui(a, "add", rcx, 3)
    call_to(a, "rt_alloc_raw")
    mov_rr(a, rbx, rax)
    mark(a, each_folder) # this folder, up to the next :, then / and the name
    mov_rr(a, rdi, rbx)
    movi(a, rdx, 0)
    mark(a, folder_byte)
    mov_rr(a, rax, r14)
    alu(a, "add", rax, rdx)
    load8(a, rax, mem(rax, 0))
    test_rr(a, rax, rax)
    jcc(a, cc_e, folder_end)
    alui(a, "cmp", rax, 58)
    jcc(a, cc_e, folder_end)
    inc_r(a, rdx)
    jmp_to(a, folder_byte)
    mark(a, folder_end)
    push_r(a, rdx)
    mov_rr(a, rsi, r14)
    mov_rr(a, rcx, rdx)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, empty_folder)
    rep_movsb(a)
    jmp_to(a, folder_copied)
    mark(a, empty_folder) # nothing: the folder it runs in
    movi(a, rax, 46)
    store8(a, mem(rdi, 0), rax)
    inc_r(a, rdi)
    mark(a, folder_copied)
    movi(a, rax, 47)
    store8(a, mem(rdi, 0), rax)
    inc_r(a, rdi)
    mov_rr(a, rsi, r12)
    mov_rr(a, rcx, r13)
    rep_movsb(a)
    movi(a, rax, 0)
    store8(a, mem(rdi, 0), rax)
    mov_rr(a, rdi, rbx)
    call_to(a, "rt_can_run")
    pop_r(a, rdx)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, found_it)
    alu(a, "add", r14, rdx)
    load8(a, rax, mem(r14, 0))
    test_rr(a, rax, rax)
    jcc(a, cc_e, path_none)
    inc_r(a, r14)
    jmp_to(a, each_folder)
    mark(a, found_it)
    mov_rr(a, rax, rbx)
    jmp_to(a, path_out)
    mark(a, next_env)
    alui(a, "add", r14, 8)
    jmp_to(a, each_env)
    mark(a, path_none)
    movi(a, rax, 0)
    mark(a, path_out)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
end

# rt_run_program: xmm0 a program's name, xmm1 its arguments (a list of text): the number it ended with,
# into xmm0 with rax 0; or rax 2 with err_why 28 (the name isn't text), 29 (the arguments aren't a list),
# 32 (one of them isn't text), 31 (there is no program of that name) or 30 (it can't be run). On Windows
# the system looks for the program, as it does for any command; on Linux rt_run_path does. The program it
# starts gets this program's own input and output, so what it says goes where this program's words go, and
# what has collected here goes out first.
to emit_run_program with a, target
    set not_text to new_label(a)
    set not_list to new_label(a)
    set item_not_text to new_label(a)
    set each_given to new_label(a)
    set given_fine to new_label(a)
    set refused to new_label(a)
    set no_program to new_label(a)
    set cant_run to new_label(a)
    set gave_up to new_label(a)
    set run_out to new_label(a)
    mark(a, "rt_run_program")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    movq_rx(a, rbx, xmm0)
    movq_rx(a, r12, xmm1)
    store(a, rip("err_file"), rbx)
    store(a, rip("err_a"), rbx)
    mov_rr(a, rax, rbx)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_ne, not_text)
    store(a, rip("err_a"), r12)
    mov_rr(a, rax, r12)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_list)
    jcc(a, cc_ne, not_list)
    mov_rr(a, rax, r12) # each argument must be text
    untag(a, rax)
    load(a, r13, mem(rax, 0))
    load(a, r14, mem(rax, 16))
    movi(a, rbx, 0)
    mark(a, each_given)
    alu(a, "cmp", rbx, r13)
    jcc(a, cc_ae, given_fine)
    mov_rr(a, rax, rbx)
    shifti(a, "shl", rax, 3)
    alu(a, "add", rax, r14)
    load(a, rax, mem(rax, 0))
    store(a, rip("err_a"), rax)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_ne, item_not_text)
    inc_r(a, rbx)
    jmp_to(a, each_given)
    mark(a, given_fine)
    movi(a, rcx, 3) # may it?
    call_to(a, "rt_permit")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, refused)
    mov_rr(a, rax, r12) # rt_permit keeps rbx and r12 only
    untag(a, rax)
    load(a, r13, mem(rax, 0))
    load(a, r14, mem(rax, 16))
    call_to(a, "rt_in_setup")
    call_to(a, "rt_flush_out")
    if target is "windows"
        set each_arg to new_label(a)
        set line_made to new_label(a)
        set converted to new_label(a)
        set started to new_label(a)
        call_to(a, "rt_b_reset") # the command line: the program, then each argument, quoted as it needs
        load(a, rax, rip("err_file"))
        call_to(a, "rt_b_arg")
        movi(a, rbx, 0)
        mark(a, each_arg)
        alu(a, "cmp", rbx, r13)
        jcc(a, cc_ae, line_made)
        movi(a, rax, 32)
        call_to(a, "rt_b_byte")
        mov_rr(a, rax, rbx)
        shifti(a, "shl", rax, 3)
        alu(a, "add", rax, r14)
        load(a, rax, mem(rax, 0))
        call_to(a, "rt_b_arg")
        inc_r(a, rbx)
        jmp_to(a, each_arg)
        mark(a, line_made) # as UTF-16, in memory of its own, which CreateProcessW may write in
        win_enter(a)
        movi(a, rcx, 65001)
        movi(a, rdx, 0)
        load(a, r8, rip("b_ptr"))
        load(a, r9, rip("b_len"))
        storei(a, mem(rsp, 32), 0)
        storei(a, mem(rsp, 40), 0)
        call_import(a, "imp_MultiByteToWideChar")
        mov32_rr(a, rbx, rax)
        win_leave(a)
        mov_rr(a, rcx, rbx)
        alu(a, "add", rcx, rcx)
        alui(a, "add", rcx, 2)
        call_to(a, "rt_alloc_raw")
        mov_rr(a, r13, rax)
        test_rr(a, rbx, rbx)
        jcc(a, cc_e, converted)
        win_enter(a)
        movi(a, rcx, 65001)
        movi(a, rdx, 0)
        load(a, r8, rip("b_ptr"))
        load(a, r9, rip("b_len"))
        store(a, mem(rsp, 32), r13)
        store(a, mem(rsp, 40), rbx)
        call_import(a, "imp_MultiByteToWideChar")
        win_leave(a)
        mark(a, converted)
        lea(a, rax, rip("run_si")) # it gets this program's own input and output
        storei(a, mem(rax, 0), 104)
        storei(a, mem(rax, 60), 0x100)
        load(a, rcx, rip("in_handle"))
        store(a, mem(rax, 80), rcx)
        load(a, rcx, rip("out_handle"))
        store(a, mem(rax, 88), rcx)
        load(a, rcx, rip("err_handle"))
        store(a, mem(rax, 96), rcx)
        win_enter(a)
        movi(a, rcx, 0)
        mov_rr(a, rdx, r13)
        movi(a, r8, 0)
        movi(a, r9, 0)
        storei(a, mem(rsp, 32), 1)
        storei(a, mem(rsp, 40), 0)
        storei(a, mem(rsp, 48), 0)
        storei(a, mem(rsp, 56), 0)
        lea(a, rax, rip("run_si"))
        store(a, mem(rsp, 64), rax)
        lea(a, rax, rip("run_pi"))
        store(a, mem(rsp, 72), rax)
        call_import(a, "imp_CreateProcessW")
        test32(a, rax)
        jcc(a, cc_ne, started)
        call_import(a, "imp_GetLastError")
        mov32_rr(a, rdx, rax)
        win_leave(a)
        missing_jump(a, target, no_program)
        jmp_to(a, cant_run)
        mark(a, started) # wait for it, and take the number it ended with
        load(a, rcx, rip("run_pi"))
        movi(a, rdx, -1)
        call_import(a, "imp_WaitForSingleObject")
        load(a, rcx, rip("run_pi"))
        lea(a, rdx, rip("run_code"))
        call_import(a, "imp_GetExitCodeProcess")
        load(a, rcx, rip("run_pi"))
        call_import(a, "imp_CloseHandle")
        load(a, rcx, rip_plus("run_pi", 8))
        call_import(a, "imp_CloseHandle")
        win_leave(a)
        load32(a, rax, rip("run_code"))
    else
        set measure_given to new_label(a)
        set measured_given to new_label(a)
        set copy_given to new_label(a)
        set copied_given to new_label(a)
        set parent to new_label(a)
        set waiting to new_label(a)
        set system_failed to new_label(a)
        set by_signal to new_label(a)
        set coded to new_label(a)
        load(a, rax, rip("err_file"))
        call_to(a, "rt_run_path")
        test_rr(a, rax, rax)
        jcc(a, cc_e, no_program)
        mov_rr(a, r12, rax) # the path, and then the name and the arguments, in one block: the pointers
        movi(a, rdx, 0) # first, then each of them as bytes with a 0 after it
        load(a, rax, rip("err_file"))
        untag(a, rax)
        load(a, rcx, mem(rax, 0))
        alu(a, "add", rdx, rcx)
        inc_r(a, rdx)
        movi(a, rbx, 0)
        mark(a, measure_given)
        alu(a, "cmp", rbx, r13)
        jcc(a, cc_ae, measured_given)
        mov_rr(a, rax, rbx)
        shifti(a, "shl", rax, 3)
        alu(a, "add", rax, r14)
        load(a, rax, mem(rax, 0))
        untag(a, rax)
        load(a, rcx, mem(rax, 0))
        alu(a, "add", rdx, rcx)
        inc_r(a, rdx)
        inc_r(a, rbx)
        jmp_to(a, measure_given)
        mark(a, measured_given)
        mov_rr(a, rcx, r13)
        alui(a, "add", rcx, 2)
        shifti(a, "shl", rcx, 3)
        alu(a, "add", rcx, rdx)
        call_to(a, "rt_alloc_raw")
        push_r(a, rax)
        mov_rr(a, r8, rax)
        mov_rr(a, rdi, rax)
        mov_rr(a, rcx, r13)
        alui(a, "add", rcx, 2)
        shifti(a, "shl", rcx, 3)
        alu(a, "add", rdi, rcx)
        load(a, rax, rip("err_file"))
        untag(a, rax)
        store(a, mem(r8, 0), rdi)
        alui(a, "add", r8, 8)
        load(a, rcx, mem(rax, 0))
        load(a, rsi, mem(rax, 16))
        rep_movsb(a)
        inc_r(a, rdi)
        movi(a, rbx, 0)
        mark(a, copy_given)
        alu(a, "cmp", rbx, r13)
        jcc(a, cc_ae, copied_given)
        mov_rr(a, rax, rbx)
        shifti(a, "shl", rax, 3)
        alu(a, "add", rax, r14)
        load(a, rax, mem(rax, 0))
        untag(a, rax)
        store(a, mem(r8, 0), rdi)
        alui(a, "add", r8, 8)
        load(a, rcx, mem(rax, 0))
        load(a, rsi, mem(rax, 16))
        rep_movsb(a)
        inc_r(a, rdi)
        inc_r(a, rbx)
        jmp_to(a, copy_given)
        mark(a, copied_given)
        pop_r(a, r14) # where the pointers are
        sys_call(a, 57) # fork: the child starts the program, with the same environment
        test_rr(a, rax, rax)
        jcc(a, cc_ne, parent)
        mov_rr(a, rdi, r12)
        mov_rr(a, rsi, r14)
        load(a, rdx, rip("env_vector"))
        sys_call(a, 59)
        movi(a, rdi, 127) # it couldn't be started after all, as a shell ends then
        sys_call(a, 231)
        mark(a, parent)
        test_rr(a, rax, rax)
        jcc(a, cc_s, system_failed)
        mov_rr(a, rbx, rax)
        mark(a, waiting)
        mov_rr(a, rdi, rbx)
        lea(a, rsi, rip("run_status"))
        movi(a, rdx, 0)
        movi(a, r10, 0)
        sys_call(a, 61)
        alui(a, "cmp", rax, -4) # interrupted: wait again
        jcc(a, cc_e, waiting)
        test_rr(a, rax, rax)
        jcc(a, cc_s, system_failed)
        load32(a, rax, rip("run_status"))
        mov_rr(a, rcx, rax)
        alui(a, "and", rcx, 0x7F)
        jcc(a, cc_ne, by_signal)
        shifti(a, "shr", rax, 8)
        alui(a, "and", rax, 0xFF)
        jmp_to(a, coded)
        mark(a, by_signal) # a signal ended it: 128 and the signal's number, as a shell has it
        mov_rr(a, rax, rcx)
        alui(a, "add", rax, 128)
        jmp_to(a, coded)
        mark(a, system_failed)
        unary(a, "neg", rax)
        mov_rr(a, rdx, rax)
        jmp_to(a, cant_run)
        mark(a, coded)
    end
    cvtsi2sd(a, xmm0, rax)
    movi(a, rax, 0)
    jmp_to(a, run_out)
    mark(a, not_text)
    storei(a, rip("err_why"), 28)
    jmp_to(a, gave_up)
    mark(a, not_list)
    storei(a, rip("err_why"), 29)
    jmp_to(a, gave_up)
    mark(a, item_not_text)
    storei(a, rip("err_why"), 32)
    jmp_to(a, gave_up)
    mark(a, refused) # err_reason says why
    storei(a, rip("err_why"), 30)
    jmp_to(a, gave_up)
    mark(a, no_program)
    storei(a, rip("err_why"), 31)
    jmp_to(a, gave_up)
    mark(a, cant_run) # rdx the system's code
    call_to(a, "rt_b_reset")
    call_to(a, "rt_os_text")
    call_to(a, "rt_b_text")
    store(a, rip("err_reason"), rax)
    storei(a, rip("err_why"), 30)
    mark(a, gave_up)
    movi(a, rax, 2)
    mark(a, run_out)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
end

# rt_remove_file: xmm0 a file's name: rax 0 once it is gone; or rax 2 with err_why 20 (the name isn't
# text), 22 (there is no file called that) or 24 (it can't be removed). A program may remove a file only if
# it may write files.
to emit_remove_file with a, target
    set not_text to new_label(a)
    set refused to new_label(a)
    set nul_name to new_label(a)
    set gone to new_label(a)
    set no_file to new_label(a)
    set failed to new_label(a)
    set gave_up to new_label(a)
    set remove_out to new_label(a)
    mark(a, "rt_remove_file")
    movq_rx(a, rax, xmm0)
    store(a, rip("err_file"), rax)
    store(a, rip("err_a"), rax)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_ne, not_text)
    movi(a, rcx, 1)
    call_to(a, "rt_permit")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, refused)
    call_to(a, "rt_name_nul")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, nul_name)
    call_to(a, "rt_file_path")
    if target is "windows"
        win_enter(a)
        mov_rr(a, rcx, rax)
        call_import(a, "imp_DeleteFileW")
        test32(a, rax)
        jcc(a, cc_ne, gone)
        call_import(a, "imp_GetLastError")
        mov32_rr(a, rdx, rax)
        win_leave(a)
        jmp_to(a, failed)
        mark(a, gone)
        win_leave(a)
    else
        mov_rr(a, rdi, rax)
        sys_call(a, 87)
        test_rr(a, rax, rax)
        jcc(a, cc_ns, gone)
        unary(a, "neg", rax)
        mov_rr(a, rdx, rax)
        jmp_to(a, failed)
        mark(a, gone)
    end
    movi(a, rax, 0)
    jmp_to(a, remove_out)
    mark(a, failed) # rdx the system's code: the system's own words for it
    missing_jump(a, target, no_file)
    call_to(a, "rt_b_reset")
    call_to(a, "rt_os_text")
    call_to(a, "rt_b_text")
    store(a, rip("err_reason"), rax)
    storei(a, rip("err_why"), 24)
    jmp_to(a, gave_up)
    mark(a, not_text)
    storei(a, rip("err_why"), 20)
    jmp_to(a, gave_up)
    mark(a, refused) # err_reason says why
    storei(a, rip("err_why"), 24)
    jmp_to(a, gave_up)
    mark(a, nul_name)
    nul_reason(a, target)
    storei(a, rip("err_why"), 24)
    jmp_to(a, gave_up)
    mark(a, no_file)
    storei(a, rip("err_why"), 22)
    mark(a, gave_up)
    movi(a, rax, 2)
    mark(a, remove_out)
    ret(a)
end

# rt_why_run: what was wrong with starting a program, from err_why, into the builder
to emit_run_why with a
    set w29 to new_label(a)
    set w30 to new_label(a)
    set w31 to new_label(a)
    set w32 to new_label(a)
    mark(a, "rt_why_run")
    load(a, rax, rip("err_why"))
    for each pair in list of (list of 29, w29), (list of 30, w30), (list of 31, w31), (list of 32, w32)
        alui(a, "cmp", rax, item 1 of pair)
        jcc(a, cc_e, item 2 of pair)
    end
    b_text(a, "'run program' needs text, not ") # 28
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w29)
    b_text(a, "'run program ... with' needs a list, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w32)
    b_text(a, "'run program ... with' needs text, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w30)
    b_text(a, "can't run '")
    file_name_text(a)
    b_text(a, "': ")
    reason_text(a)
    ret(a)
    mark(a, w31)
    b_text(a, "there is no program called '")
    file_name_text(a)
    b_text(a, "'")
    ret(a)
end

# ---------- what can't become machine code yet ----------

set node_words to dictionary where "list" is "a list", "record" is "a record", "dictionary" is "a dictionary",
    "length" is "'length of'", "item" is "'item'", "field" is "a record's field",
    "random" is "'random number'", "builtin" is "this", "each" is "'for each ... in'",
    "setItem" is "'set item'", "setField" is "setting a field", "when" is "'when'", "every" is "'every'",
    "turtle" is "drawing", "fail" is "'fail with'", "remove" is "'remove'", "expect" is "'expect'"

to not_yet with at, what
    fail with front's problem(at, what + " can't become machine code yet: so far, numbers, yes, no and nothing, text, lists, records, dictionaries, bytes, variables, say, if, loops, functions (as values too, and made inside functions), try, files, ask, arguments and most of the helpers can")
end

to not_yet_node with node
    set what to "'" + kind of node + "'"
    if kind of node is in node_words
        set what to item (kind of node) of node_words
    end
    if kind of node is "builtin"
        set what to "'" + name of node + "'"
    end
    not_yet(at of node, what)
end

# ---------- the program's code ----------
# Main's variables live in `globals`, a function's in its frame: its inputs above where rbp points, where
# the call put them, and its own below, under the number of the call. A value being worked out waits on
# the stack. `fc` is the function being written.

to new_state with a, program_name, files, source, target
    set sources to empty dictionary
    set item "" of sources to source
    for each f in files
        set item (name of f) of sources to text of f
    end
    return record with a a, name program_name, sources sources, lines empty dictionary, sites empty dictionary,
        calls empty list, call_places empty dictionary, functions empty dictionary, fn_slots empty dictionary,
        main_scope nothing, target target, all_fns empty list, pending empty list, fn_records empty dictionary,
        line_entries empty dictionary, uses_case no, allowed nothing, uses_drawing no, uses_app no, uses_pad no
end

to new_fc with st, scope, main, name, inputs, own
    return record with st st, a a of st, scope scope, main main, name name, inputs inputs, own own, hidden 0,
        most_hidden 0, pushed 0, most_pushed 0, loops nothing, done nothing, tries 0, saved_try nothing, level 0,
        env_slot nothing, outer_slot nothing
end

# where a mistake at `at` happened, in the read-only data: "file:line:col: ", then "\n", the line, and a
# ^ under the spot
# Where a mistake can happen, once each: "file:line:col: ", then where its line is, and how many bytes of the
# line's marker go before the ^. The line and its marker are kept once for all the places on it, so a long
# line with many places, as a list of thousands of numbers is, stays the size it is.
to site_of with fc, at
    set st to st of fc
    set a to a of st
    set key to "" + line of at + ":" + col of at + ":" + file of at
    set table to sites of st
    if key is in table
        return item key of table
    end
    set where_name to file of at
    if where_name is ""
        set where_name to name of st
    end
    set head to (where_name + ":" + line of at + ":" + col of at + ": ") as bytes
    set entry to line_entry(st, file of at, line of at)
    set ro to rodata of a
    set label to "S" + length of ro
    rodata_here(a, label)
    put32(ro, length of head)
    put_all(ro, head)
    absolute(a, "rodata", length of ro, label of entry, 0)
    put64(ro, 0)
    set marks to marks of entry
    set upto to col of at - 1
    if upto is less than 0
        set upto to 0
    end
    if upto is greater than length of marks - 1
        set upto to length of marks - 1
    end
    put32(ro, item (upto + 1) of marks)
    set item key of table to label
    return label
end

# vm.js's excerpt: the line, and under it a ^ at the column, with the line's own tabs kept so it lines up
# A line of a file, once each, as vm.js's excerpt shows it: "\n", the line and "\n", then its marker, a space
# for each UTF-16 unit and the line's own tabs and spaces kept, so a ^ after part of it lines up. `marks`
# says, for each number of units into the line, how many of the marker's bytes go before the ^.
to line_entry with st, file, line_no
    set entries to line_entries of st
    set entry_key to file + ":" + line_no
    if entry_key is in entries
        return item entry_key of entries
    end
    set table to lines of st
    if not (file is in table)
        set all to empty list
        for each piece in split item file of sources of st by "\n"
            add without_return(piece) to all
        end
        set item file of table to all
    end
    set all to item file of table
    set line_text to ""
    if line_no is at most length of all
        set line_text to item line_no of all
    end
    set marks to list of 0
    set marker to ""
    set made to 0
    for each c in line_text
        set w to front's width(c)
        if js_space(c)
            add c to marker
            set made to made + length of (c as bytes)
        else if w is 2
            add "  " to marker
            set made to made + 2
        else
            add " " to marker
            set made to made + 1
        end
        repeat w times
            add made to marks
        end
    end
    set a to a of st
    set ro to rodata of a
    set label to "E" + length of ro
    rodata_here(a, label)
    set shown to ("\n" + line_text + "\n") as bytes
    put32(ro, length of shown)
    put_all(ro, shown)
    set marker_bytes to marker as bytes
    put32(ro, length of marker_bytes)
    put_all(ro, marker_bytes)
    set entry to record with label label, marks marks
    set item entry_key of entries to entry
    return entry
end

to code_point with c
    set got to c as bytes
    set lead to byte 1 of got
    if lead is less than 128
        return lead
    end
    set cp to lead bit and 31
    set extra to 1
    if lead is at least 240
        set cp to lead bit and 7
        set extra to 3
    else if lead is at least 224
        set cp to lead bit and 15
        set extra to 2
    end
    for each k from 2 to extra + 1
        set cp to cp * 64 + (byte k of got bit and 63)
    end
    return cp
end

# JavaScript's \s
to js_space with c
    set cp to code_point(c)
    if cp is at least 9 and cp is at most 13
        return yes
    end
    if cp is at least 0x2000 and cp is at most 0x200A
        return yes
    end
    return cp is 32 or cp is 0xA0 or cp is 0x1680 or cp is 0x2028 or cp is 0x2029 or cp is 0x202F or cp is 0x205F or
        cp is 0x3000 or cp is 0xFEFF
end

to without_return with line_text
    set made to ""
    set n to 0
    set total to length of line_text
    for each c in line_text
        add 1 to n
        if n is not total or code_point(c) is not 13
            add c to made
        end
    end
    return made
end

# code that stops with this mistake, in the cold code; gives its label
to fail_stub with fc, at, message
    set a to a of fc
    set site to site_of(fc, at)
    set was to enter_cold(a)
    set over to new_label(a) # made while writing cold code: around it, so that code doesn't run into it
    if was is "cold"
        jmp_to(a, over)
    end
    set label to new_label(a)
    mark(a, label)
    lea(a, rsi, rip(site))
    call_to(a, "rt_e_start")
    point_at_text(a, message)
    call_to(a, "rt_e_text")
    jmp_to(a, "rt_e_end")
    mark(a, over)
    leave_cold(a, was)
    return label
end

# the start of a mistake whose message is put together as it happens: after it, the pieces, then rt_e_end
to stub_start with fc, at
    set a to a of fc
    lea(a, rsi, rip(site_of(fc, at)))
    call_to(a, "rt_e_start")
end

to stub_text with a, t
    point_at_text(a, t)
    call_to(a, "rt_e_text")
end

to stub_kind with a, from
    load(a, rax, rip(from))
    call_to(a, "rt_e_kind")
end

# "before" + what err_a is + "middle" + what err_b is
to two_kinds with fc, at, before, middle
    set a to a of fc
    stub_start(fc, at)
    stub_text(a, before)
    stub_kind(a, "err_a")
    stub_text(a, middle)
    stub_kind(a, "err_b")
    jmp_to(a, "rt_e_end")
end

to push_value with fc
    set a to a of fc
    movq_rx(a, rax, xmm0)
    push_r(a, rax)
    set pushed of fc to pushed of fc + 1
    if pushed of fc is greater than most_pushed of fc
        set most_pushed of fc to pushed of fc
    end
end

to pop_value with fc, x
    set a to a of fc
    pop_r(a, rax)
    movq_xr(a, x, rax)
    set pushed of fc to pushed of fc - 1
end

# a place in the frame for a loop's count or limit
to hidden_place with fc
    set h to hidden of fc
    set hidden of fc to h + 1
    if hidden of fc is greater than most_hidden of fc
        set most_hidden of fc to hidden of fc
    end
    return mem(rbp, -24 - 8 * (own of fc + h))
end

# where a variable resolve() found lives
# where a variable resolve() found lives: main's in `globals`; a function's own in its frame, its inputs above
# where rbp points and the rest below, or in its environment if it makes functions; and a variable of a
# function further out in that function's environment, reached through the environments in between (r11
# holds its address then)
to place_of with fc, found
    set target to level of fc - depth of found
    if target is 0
        return rip_plus("globals", 8 * (slot of found - 1))
    end
    set a to a of fc
    set k to slot of found
    if depth of found is 0
        if env_slot of fc is nothing
            if k is at most inputs of fc
                return mem(rbp, 16 + 8 * (inputs of fc - k))
            end
            return mem(rbp, -24 - 8 * (k - inputs of fc - 1))
        end
        load(a, r11, env_slot of fc)
        return mem(r11, 8 * k)
    end
    load(a, r11, outer_slot of fc)
    repeat depth of found - 1 times
        load(a, r11, mem(r11, 0))
    end
    return mem(r11, 8 * k)
end

# the program's function whose name is in that place, if it is one
# the program's function whose name is in that place, if it is one that is only ever that function: made
# once, at the top level, and its name never set otherwise, so a call to it can go straight to its code
to function_at with fc, found
    if found is nothing
        return nothing
    end
    if level of fc - depth of found is not 0
        return nothing
    end
    set table to fn_slots of st of fc
    if slot of found is in table
        return item (slot of found) of table
    end
    return nothing
end

# For a command line that tidies a file: its code read, and with it `layout`, how deep in blocks each
# statement starts, and `tight`, the pieces written with no space after them (see parse in compiler.moth).
# `files` are the files it uses, each with an empty text, as nothing in them is being tidied.
to read_layout with source, files
    set reading to record with files files, loaded empty list, open empty list, within "",
        layout empty dictionary, tight empty dictionary
    front's parse(front's tokenize(source, ""), reading)
    return reading
end

# the pieces of some code, for checking that tidying changed none of them
to read_tokens with source
    return front's tokenize(source, "")
end

# For a command line that finds problems without running the program: its code read, with the code of
# every file it uses in place, as compiling it would read them
to read_program with source, files
    set reading to record with files files, loaded empty list, open empty list, within "", layout nothing, tight nothing
    return front's parse(front's tokenize(source, ""), reading)
end

# Which variable each name means in one function, or in the whole program (`parent` nothing). `place` is
# the function's own number, as the parser gave it, or 0 for the whole program (see new_scope).
to read_scope with parent, params, body, place
    return front's new_scope(parent, params, body, place)
end

# how many functions out a name lives and which slot it is, or nothing if nothing sets it anywhere
to read_resolve with scope, wanted
    return front's resolve(scope, wanted)
end

# what to say when a name nothing ever sets is used, with the name it most likely meant
to read_undefined with scope, wanted, call, statement
    return front's undefined_message(scope, wanted, call, statement)
end

to compile_machine with source, file_names, file_texts, target, program_name
    return compile_allowing(source, file_names, file_texts, target, program_name, empty list)
end

# compile_machine for a program built with --allow flags, which say what it may do without asking
to compile_allowing with source, file_names, file_texts, target, program_name, flags
    set allowing to allowed_of(flags)
    set files to empty list
    for each i from 1 to length of file_names
        add record with name item i of file_names, text item i of file_texts to files
    end
    set reading to record with files files, loaded empty list, open empty list, within "", layout nothing, tight nothing
    set body to front's parse(front's tokenize(source, ""), reading)
    set a to new_asm()
    set st to new_state(a, program_name, files, source, target)
    set allowed of st to allowing
    gen_program(st, body)
    emit_runtime(st)
    if target is "windows"
        return windows_file(a)
    end
    return linux_file(a)
end

# a function the program makes, at `level` (1 at the top), whose variables' scope sits in `parent`
to new_function with st, s, parent, level
    set all_made to all_fns of st
    set id to length of all_made
    set made to record with name name of s, label "F" + id, id id, info "I" + id, params params of s, kinds kinds of s,
        body body of s, at at of s, parent parent, level level, order order of s
    add made to all_made
    return made
end

# the function's number from the parser, which no other function has: a file used as two names makes two
# functions on the same line of the same file
to define_key with s
    return "" + order of s
end

# the functions made at the top level, and which of them are only ever that function
to collect_functions with st, body, made_count
    for each s in body
        set what to kind of s
        if what is "define"
            set made to new_function(st, s, main_scope of st, 1)
            set records to fn_records of st
            set item define_key(s) of records to made
            set n to 0
            if name of s is in made_count
                set n to item (name of s) of made_count
            end
            set item (name of s) of made_count to n + 1
            set table to functions of st
            set item (name of s) of table to made
        else if what is "if"
            collect_functions(st, then of s, made_count)
            collect_functions(st, otherwise of s, made_count)
        else if what is "while" or what is "repeat" or what is "count" or what is "each"
            collect_functions(st, body of s, made_count)
        else if what is "try"
            collect_functions(st, body of s, made_count)
            collect_functions(st, handler of s, made_count)
        end
    end
end

# every name a statement sets, anywhere in the program
to set_names with body, table
    for each s in body
        set what to kind of s
        if what is "set" or what is "add" or what is "count" or what is "each" or (what is "try" and name of s is not nothing)
            set item (name of s) of table to yes
        end
        if what is "if"
            set_names(then of s, table)
            set_names(otherwise of s, table)
        else if what is "while" or what is "repeat" or what is "count" or what is "each" or what is "define"
            set_names(body of s, table)
        else if what is "try"
            set_names(body of s, table)
            set_names(handler of s, table)
        end
    end
end

# whether a function's code makes a function, not counting the code of the functions it makes
to makes_functions with body
    for each s in body
        set what to kind of s
        if what is "define"
            return yes
        end
        if what is "if"
            if makes_functions(then of s) or makes_functions(otherwise of s)
                return yes
            end
        else if what is "while" or what is "repeat" or what is "count" or what is "each"
            if makes_functions(body of s)
                return yes
            end
        else if what is "try"
            if makes_functions(body of s) or makes_functions(handler of s)
                return yes
            end
        end
    end
    return no
end

to frame_size with a, at
    set code to code of a
    raw(a, list of 0x48, 0x81, 0xEC) # sub rsp, the size of the frame
    set where_at to length of code
    put32(code, 0)
    return where_at
end

to gen_program with st, body
    set a to a of st
    set scope to front's new_scope(nothing, empty list, body, 0)
    set main_scope of st to scope
    set made_count to empty dictionary
    collect_functions(st, body, made_count)
    set assigned to empty dictionary
    set_names(body, assigned)
    set table to functions of st
    for each fn_name in keys of table # a call to one made once, whose name nothing else sets, goes straight to it
        if item fn_name of made_count is 1 and not (fn_name is in assigned)
            set f to item fn_name of table
            set slots to fn_slots of st
            set item (slot of front's resolve(scope, fn_name)) of slots to f
        end
    end
    data_here(a, "globals")
    for each n in names of scope
        put_all(data of a, bits_unset)
    end
    data_here(a, "globals_end")
    mark(a, "moth_main")
    push_r(a, rbp)
    mov_rr(a, rbp, rsp)
    raw(a, list of 0x6A, 0xFF) # push -1: main, where the calls stop
    raw(a, list of 0x6A, 0x00)
    set sized to frame_size(a, nothing)
    set fc to new_fc(st, scope, yes, "main", 0, 0)
    gen_block(fc, body)
    mov_rr(a, rsp, rbp)
    pop_r(a, rbp)
    ret(a)
    patch32(hot of a, sized, 8 * most_hidden of fc)
    set waiting to pending of st
    set k to 1
    repeat while k is at most length of waiting
        gen_function(st, item k of waiting)
        add 1 to k
    end
end

# A function's code: its frame has the number of the call that made it and its own number under where rbp
# points, for a mistake's trail, then its variables, unless it makes functions, when they live in an
# environment of its own. A function made inside another gets the environment it was made in in rdx.
to gen_function with st, f
    set a to a of st
    set scope to front's new_scope(parent of f, params of f, body of f, order of f)
    set n to length of params of f
    set total to length of names of scope
    set with_env to makes_functions(body of f)
    set own to total - n
    if with_env
        set own to 0
    end
    mark(a, label of f)
    push_r(a, rbp)
    mov_rr(a, rbp, rsp)
    push_r(a, rax) # the number of the call
    push_i32(a, id of f)
    set sized to frame_size(a, nothing)
    if own is greater than 0
        movi64(a, rax, bits_unset)
        for each j from 0 to own - 1
            store(a, mem(rbp, -24 - 8 * j), rax)
        end
    end
    set fc to new_fc(st, scope, no, name of f, n, own)
    set level of fc to level of f
    set done of fc to new_label(a)
    if level of f is at least 2
        set outer_slot of fc to hidden_place(fc)
        store(a, outer_slot of fc, rdx)
    end
    if with_env # its variables in memory, its inputs copied there
        set env_slot of fc to hidden_place(fc)
        movi(a, rcx, total)
        movi(a, rdx, 0)
        if outer_slot of fc is not nothing
            load(a, rdx, outer_slot of fc)
        end
        call_to(a, "rt_env_new")
        store(a, env_slot of fc, rax)
        for each i from 1 to n
            load(a, rcx, mem(rbp, 16 + 8 * (n - i)))
            store(a, mem(rax, 8 * i), rcx)
        end
    end
    if has_try(body of f)
        set saved_try of fc to hidden_place(fc)
        load(a, rax, rip("try_top"))
        store(a, saved_try of fc, rax)
    end
    gen_block(fc, body of f)
    load_bits(a, xmm0, bits_nothing)
    mark(a, done of fc)
    if saved_try of fc is not nothing
        load(a, rax, saved_try of fc)
        store(a, rip("try_top"), rax)
    end
    mov_rr(a, rsp, rbp)
    pop_r(a, rbp)
    ret(a)
    patch32(hot of a, sized, 8 * (own + most_hidden of fc))
    if 8 * (4 + n + own + most_hidden of fc + most_pushed of fc) is greater than frame_limit
        not_yet(at of f, "a function this big")
    end
end

to gen_block with fc, body
    for each s in body
        gen_statement(fc, s)
    end
end

to gen_statement with fc, s
    set a to a of fc
    set what to kind of s
    if what is "say"
        gen_say(fc, s)
    else if what is "set"
        gen_expr(fc, value of s)
        store_var(fc, name of s, at of s)
    else if what is "add"
        gen_add(fc, s)
    else if what is "if"
        set otherwise_at to new_label(a)
        set end_at to new_label(a)
        gen_cond(fc, cond of s, otherwise_at, no)
        gen_block(fc, then of s)
        jmp_to(a, end_at)
        mark(a, otherwise_at)
        gen_block(fc, otherwise of s)
        mark(a, end_at)
    else if what is "while"
        set top to new_label(a)
        set exit to new_label(a)
        mark(a, top)
        gen_cond(fc, cond of s, exit, no)
        gen_loop_body(fc, body of s, exit)
        jmp_to(a, top)
        mark(a, exit)
    else if what is "repeat"
        gen_repeat(fc, s)
    else if what is "count"
        gen_count(fc, s)
    else if what is "define" # a function value, in its name's variable; its code comes later
        set f to nothing
        if main of fc
            set f to item define_key(s) of fn_records of st of fc
        else
            set f to new_function(st of fc, s, scope of fc, level of fc + 1)
        end
        set waiting to pending of st of fc
        add f to waiting
        lea(a, rcx, rip(label of f))
        movi(a, rdx, 0)
        if env_slot of fc is not nothing
            load(a, rdx, env_slot of fc)
        end
        lea(a, r8, rip(info of f))
        call_to(a, "rt_closure")
        movq_xr(a, xmm0, rax)
        movsd_store(a, place_of(fc, front's resolve(scope of fc, name of s)), xmm0)
    else if what is "return"
        if value of s is nothing
            load_bits(a, xmm0, bits_nothing)
        else
            gen_expr(fc, value of s)
        end
        jmp_to(a, done of fc)
    else if what is "stop" # leave the tries inside the loop, then go to its end
        set inner to tries of fc - tries of loops of fc
        if inner is greater than 0
            load(a, rax, mem(rsp, 32 * (inner - 1) + 24))
            store(a, rip("try_top"), rax)
            alui(a, "add", rsp, 32 * inner)
        end
        jmp_to(a, exit of loops of fc)
    else if what is "call"
        gen_call(fc, s, yes)
    else if what is "setItem" # checked before the value is worked out, as the engines check it
        set target to target of s
        gen_pair(fc, subject of target, index of target)
        call_to(a, "rt_item_ref")
        why_stub(fc, at of target, "rt_why_item")
        push_value(fc)
        movapd(a, xmm0, xmm1)
        push_value(fc)
        gen_expr(fc, value of s)
        movapd(a, xmm2, xmm0)
        pop_value(fc, xmm1)
        pop_value(fc, xmm0)
        call_to(a, "rt_set_item")
        why_stub(fc, at of target, "rt_why_item")
    else if what is "each"
        gen_each(fc, s)
    else if what is "try"
        gen_try(fc, s)
    else if what is "setField" # checked before the value is worked out, as the engines check it
        gen_expr(fc, target of s)
        lea(a, rdx, rip(text_object(a, name of s)))
        call_to(a, "rt_record_ref")
        why_stub(fc, at of s, "rt_why_field")
        push_value(fc)
        gen_expr(fc, value of s)
        movapd(a, xmm2, xmm0)
        pop_value(fc, xmm0)
        lea(a, rdx, rip(text_object(a, name of s)))
        call_to(a, "rt_set_field")
    else if what is "remove"
        gen_pair(fc, key of s, target of s)
        call_to(a, "rt_remove")
        why_stub(fc, at of s, "rt_why_key")
    else if what is "fail" # the mistake says the value, as `say` shows it
        if is_text(value of s)
            jmp_to(a, fail_stub(fc, at of s, value of value of s))
        else
            gen_expr(fc, value of s)
            movsd_store(a, rip("err_a"), xmm0)
            movsd_store(a, rip("fail_val"), xmm0)
            storei(a, rip("fail_has"), 1)
            stub_start(fc, at of s)
            load(a, rax, rip("err_a"))
            movi(a, rdx, 0)
            call_to(a, "rt_e_shown")
            jmp_to(a, "rt_e_end")
        end
    else if what is "write"
        gen_write(fc, s)
    else if what is "removeFile"
        gen_expr(fc, target of s)
        call_to(a, "rt_remove_file")
        why_stub(fc, at of s, "rt_why_file")
    else if what is "exit"
        gen_exit(fc, s)
    else if what is "turtle"
        gen_turtle(fc, s)
    else if what is "when" or what is "every"
        gen_handler(fc, s)
    else
        not_yet_node(s)
    end
end

# `stop the program with 2`: what the output has waiting goes out, and the program ends with that number, a
# whole number from 0 to 255; no `try` stops it
to gen_exit with fc, s
    set a to a of fc
    if value of s is nothing
        movi(a, rcx, 0)
    else
        gen_expr(fc, value of s)
        movapd(a, xmm2, xmm0)
        call_to(a, "rt_byte")
        set bad to new_label(a)
        test_rr(a, rax, rax)
        jcc(a, cc_ne, bad)
        set was to enter_cold(a)
        mark(a, bad)
        stub_start(fc, at of s)
        stub_text(a, "'stop the program with' needs a whole number from 0 to 255, not ")
        load(a, rax, rip("err_a"))
        call_to(a, "rt_described")
        jmp_to(a, "rt_e_end")
        leave_cold(a, was)
    end
    jmp_to(a, "rt_finish")
end

to gen_loop_body with fc, body, exit
    set loops of fc to record with exit exit, outer loops of fc, tries tries of fc
    gen_block(fc, body)
    set loops of fc to outer of loops of fc
end

to store_var with fc, wanted, at
    set found to front's resolve(scope of fc, wanted)
    movsd_store(a of fc, place_of(fc, found), xmm0)
end

to gen_say with fc, s
    set a to a of fc
    set waiting to 0
    for each part in parts of s
        if not is_text(part)
            gen_expr(fc, part)
            push_value(fc)
            add 1 to waiting
        end
    end
    call_to(a, "rt_b_reset")
    set j to 0
    for each part in parts of s
        if is_text(part)
            if value of part is not ""
                b_text(a, value of part)
            end
        else
            load(a, rax, mem(rsp, 8 * (waiting - 1 - j)))
            movi(a, rdx, 0)
            call_to(a, "rt_b_value")
            add 1 to j
        end
    end
    if errors of s
        call_to(a, "rt_say_error_end")
    else
        call_to(a, "rt_say_end")
    end
    test_rr(a, rax, rax)
    jcc(a, cc_ne, fail_stub(fc, at of s, too_big))
    if waiting is greater than 0
        alui(a, "add", rsp, 8 * waiting)
        set pushed of fc to pushed of fc - waiting
    end
end

to is_text with e
    return kind of e is "value" and type of e is "string"
end

to gen_add with fc, s
    set a to a of fc
    gen_expr(fc, value of s)
    set found to front's resolve(scope of fc, name of s)
    if found is nothing
        jmp_to(a, fail_stub(fc, at of s, front's undefined_message(scope of fc, name of s, no, no)))
        return nothing
    end
    set unset to fail_stub(fc, at of s, front's no_value(name of s))
    set wrong to new_label(a)
    set first_back to new_label(a)
    set second_back to new_label(a)
    set odd_before to new_label(a)
    set odd_after to new_label(a)
    movapd(a, xmm1, xmm0)
    movsd_load(a, xmm0, place_of(fc, found))
    ucomisd(a, xmm0, reg_at(xmm0))
    jcc(a, cc_p, odd_before)
    mark(a, first_back)
    movapd(a, xmm2, xmm0)
    sse_math(a, "+", xmm0, reg_at(xmm1))
    ucomisd(a, xmm0, reg_at(xmm0))
    jcc(a, cc_p, odd_after)
    mark(a, second_back)
    movsd_store(a, place_of(fc, found), xmm0)
    set added to new_label(a)
    mark(a, added)
    set was to enter_cold(a)
    set in_memory to new_label(a)
    set kinds to new_label(a)
    mark(a, odd_before) # the variable is NaN: no value yet, nothing, yes or no, text or a list, or the number NaN
    movq_rx(a, rax, xmm0)
    movi64(a, rcx, bits_unset)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, unset)
    special_jump(a, xmm0, wrong)
    pointer_jump(a, xmm0, in_memory)
    jmp_to(a, first_back)
    mark(a, in_memory) # text grows; a list gets it at its end
    call_to(a, "rt_add_into")
    alui(a, "cmp", rax, 2)
    jcc(a, cc_e, kinds)
    jcc(a, cc_a, fail_stub(fc, at of s, too_big))
    movsd_store(a, place_of(fc, found), xmm0)
    jmp_to(a, added)
    mark(a, odd_after) # the sum is NaN: isn't what's added a number?
    set wrong_after to new_label(a)
    odd_jump(a, xmm1, wrong_after)
    jmp_to(a, second_back)
    mark(a, wrong_after)
    movapd(a, xmm0, xmm2)
    mark(a, wrong)
    movsd_store(a, rip("err_a"), xmm1)
    movsd_store(a, rip("err_b"), xmm0)
    mark(a, kinds)
    two_kinds(fc, at of s, "can't add ", " to ")
    leave_cold(a, was)
end

# `try`: a record of where to go if something fails goes on the stack, linked to the one before it: the
# calls in progress, the frame, the handler, and the try further out. A mistake goes back to it, and on to
# its `if it fails` with what failed.
to gen_try with fc, s
    set a to a of fc
    set handler to new_label(a)
    set finish to new_label(a)
    load(a, rax, rip("try_top"))
    push_r(a, rax)
    lea(a, rax, rip(handler))
    push_r(a, rax)
    push_r(a, rbp)
    push_r(a, r15)
    store(a, rip("try_top"), rsp)
    set pushed of fc to pushed of fc + 4
    if pushed of fc is greater than most_pushed of fc
        set most_pushed of fc to pushed of fc
    end
    set tries of fc to tries of fc + 1
    gen_block(fc, body of s)
    set tries of fc to tries of fc - 1
    load(a, rax, mem(rsp, 24)) # over: the try further out
    store(a, rip("try_top"), rax)
    alui(a, "add", rsp, 32)
    set pushed of fc to pushed of fc - 4
    jmp_to(a, finish)
    mark(a, handler)
    if name of s is not nothing
        store_var(fc, name of s, at of s)
    end
    gen_block(fc, handler of s)
    mark(a, finish)
end

# whether a function's code has a `try` anywhere in it
to has_try with body
    for each s in body
        set what to kind of s
        if what is "try"
            return yes
        end
        if what is "if"
            if has_try(then of s) or has_try(otherwise of s)
                return yes
            end
        end
        if what is "while" or what is "repeat" or what is "count" or what is "each"
            if has_try(body of s)
                return yes
            end
        end
    end
    return no
end

# `for each x in`: a copy of the items, gone through by place
to gen_each with fc, s
    set a to a of fc
    gen_expr(fc, over of s)
    call_to(a, "rt_items")
    kind_stub(fc, at of s, "can only go through a list, text, dictionary or bytes, not ")
    set items_at to hidden_place(fc)
    set count_at to hidden_place(fc)
    set next_at to hidden_place(fc)
    store(a, items_at, rdx)
    store(a, count_at, rcx)
    storei(a, next_at, 0)
    set top to new_label(a)
    set exit to new_label(a)
    mark(a, top)
    load(a, rax, next_at)
    alu_load(a, "cmp", rax, count_at)
    jcc(a, cc_ae, exit)
    load(a, rcx, items_at)
    mov_rr(a, rdx, rax)
    shifti(a, "shl", rdx, 3)
    alu(a, "add", rcx, rdx)
    movsd_load(a, xmm0, mem(rcx, 0))
    inc_r(a, rax)
    store(a, next_at, rax)
    store_var(fc, name of s, at of s)
    gen_loop_body(fc, body of s, exit)
    jmp_to(a, top)
    mark(a, exit)
    set hidden of fc to hidden of fc - 3
end

to gen_repeat with fc, s
    set a to a of fc
    gen_expr(fc, count of s)
    set bad to new_label(a)
    call_to(a, "rt_repeat")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, bad)
    set left to hidden_place(fc)
    movsd_store(a, left, xmm0)
    set top to new_label(a)
    set exit to new_label(a)
    mark(a, top)
    movsd_load(a, xmm0, left)
    ucomisd(a, xmm0, rip(number_place(a, double_bytes(0))))
    jcc(a, cc_be, exit)
    sse_math(a, "-", xmm0, rip(number_place(a, double_bytes(1))))
    movsd_store(a, left, xmm0)
    gen_loop_body(fc, body of s, exit)
    jmp_to(a, top)
    mark(a, exit)
    set hidden of fc to hidden of fc - 1
    set was to enter_cold(a)
    mark(a, bad)
    stub_start(fc, at of s)
    stub_text(a, "repeat needs a whole number of times, not ")
    load(a, rax, rip("err_a"))
    movi(a, rdx, 1)
    call_to(a, "rt_e_shown")
    jmp_to(a, "rt_e_end")
    leave_cold(a, was)
end

to gen_count with fc, s
    set a to a of fc
    gen_expr(fc, start of s)
    push_value(fc)
    gen_expr(fc, limit of s)
    movapd(a, xmm1, xmm0)
    pop_value(fc, xmm0)
    set odd to new_label(a)
    set back to new_label(a)
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_p, odd)
    mark(a, back)
    set from_place to hidden_place(fc)
    set to_place to hidden_place(fc)
    movsd_store(a, from_place, xmm0)
    movsd_store(a, to_place, xmm1)
    set top to new_label(a)
    set close to new_label(a)
    set go to new_label(a)
    set exit to new_label(a)
    mark(a, top)
    movsd_load(a, xmm0, from_place)
    movsd_load(a, xmm1, to_place)
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_p, close)
    jcc(a, cc_be, go)
    mark(a, close) # past the limit, unless the two are the same to 15 digits
    call_to(a, "rt_order")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, exit)
    movsd_load(a, xmm0, from_place)
    mark(a, go)
    store_var(fc, name of s, at of s)
    sse_math(a, "+", xmm0, rip(number_place(a, double_bytes(1))))
    movsd_store(a, from_place, xmm0)
    gen_loop_body(fc, body of s, exit)
    jmp_to(a, top)
    mark(a, exit)
    set hidden of fc to hidden of fc - 2
    set was to enter_cold(a)
    mark(a, odd)
    movapd(a, xmm2, xmm0)
    call_to(a, "rt_any_odd")
    test_rr(a, rax, rax)
    jcc(a, cc_e, back)
    movsd_store(a, rip("err_a"), xmm2)
    movsd_store(a, rip("err_b"), xmm1)
    two_kinds(fc, at of s, "'from' and 'to' need numbers, not ", " and ")
    leave_cold(a, was)
end

# ---------- conditions ----------

set compare_names to dictionary where "is" is "is", "less than" is "lt", "greater than" is "gt", "at least" is "ge",
    "at most" is "le", "divisible by" is "div", "in" is "in"

# jumps to `label` when what `e` is counts as `goal` (only no and nothing count as false)
to gen_cond with fc, e, label, goal
    set a to a of fc
    set what to kind of e
    if what is "compare"
        gen_compare(fc, e)
        set jump_true to goal
        if negate of e
            set jump_true to not goal
        end
        test_rr(a, rax, rax)
        if jump_true
            jcc(a, cc_ne, label)
        else
            jcc(a, cc_e, label)
        end
    else if what is "and"
        if goal
            set skip to new_label(a)
            gen_cond(fc, left of e, skip, no)
            gen_cond(fc, right of e, label, yes)
            mark(a, skip)
        else
            gen_cond(fc, left of e, label, no)
            gen_cond(fc, right of e, label, no)
        end
    else if what is "or"
        if goal
            gen_cond(fc, left of e, label, yes)
            gen_cond(fc, right of e, label, yes)
        else
            set skip to new_label(a)
            gen_cond(fc, left of e, skip, yes)
            gen_cond(fc, right of e, label, no)
            mark(a, skip)
        end
    else if what is "not"
        gen_cond(fc, operand of e, label, not goal)
    else if what is "value" and type of e is not "string"
        set truth to not (type of e is "nothing" or type of e is "no")
        if truth is goal
            jmp_to(a, label)
        end
    else
        gen_expr(fc, e)
        truth_test(a)
        if goal
            jcc(a, cc_ae, label)
        else
            jcc(a, cc_b, label)
        end
    end
end

# flags for xmm0: below means it counts as false
to truth_test with a
    movq_rx(a, rax, xmm0)
    movi64(a, rcx, bits_nothing)
    alu(a, "sub", rax, rcx)
    alui(a, "cmp", rax, 2)
end

# both sides of a comparison, then rt_cmp_...: rax is 1 if it holds, else 0
to gen_compare with fc, e
    set a to a of fc
    set test to item (op of e) of compare_names
    gen_pair(fc, left of e, right of e)
    call_to(a, "rt_cmp_" + test)
    alui(a, "cmp", rax, 1)
    set wrong to new_label(a)
    jcc(a, cc_a, wrong)
    set was to enter_cold(a)
    mark(a, wrong)
    if test is "div"
        set kinds_wrong to new_label(a)
        load(a, rax, rip("err_why"))
        test_rr(a, rax, rax)
        jcc(a, cc_e, kinds_wrong)
        jmp_to(a, fail_stub(fc, at of e, "can't divide by zero"))
        mark(a, kinds_wrong)
    end
    two_kinds(fc, at of e, "can't check if ", " is " + op of e + " ")
    leave_cold(a, was)
end

# xmm0 gets the left value and xmm1 the right
to gen_pair with fc, left, right
    set a to a of fc
    gen_expr(fc, left)
    if kind of right is "value" and type of right is not "string"
        gen_value(fc, right, xmm1)
    else
        push_value(fc)
        gen_expr(fc, right)
        movapd(a, xmm1, xmm0)
        pop_value(fc, xmm0)
    end
end

# ---------- values ----------
# Each leaves what it works out in xmm0.

set builtin_routines to dictionary where "position" is "rt_position", "split" is "rt_split", "join" is "rt_join_list",
    "number" is "rt_number", "bit and" is "rt_bit_and", "bit or" is "rt_bit_or", "bit xor" is "rt_bit_xor",
    "shift left" is "rt_shift_left", "shift right" is "rt_shift_right", "bytes" is "rt_bytes_of",
    "as bytes" is "rt_as_bytes", "as text" is "rt_as_text", "as hex" is "rt_as_hex", "as binary" is "rt_as_binary",
    "uppercase" is "rt_upper", "lowercase" is "rt_lower"

to gen_expr with fc, e
    set a to a of fc
    set what to kind of e
    if what is "value"
        gen_value(fc, e, xmm0)
    else if what is "name"
        gen_name(fc, e)
    else if what is "call"
        gen_call(fc, e, no)
    else if what is "math"
        gen_math(fc, e)
    else if what is "compare"
        gen_compare(fc, e)
        if negate of e
            alui(a, "xor", rax, 1)
        end
        movi64(a, rcx, bits_no)
        alu(a, "add", rcx, rax)
        movq_xr(a, xmm0, rcx)
    else if what is "and" or what is "or"
        set end_at to new_label(a)
        gen_expr(fc, left of e)
        truth_test(a)
        if what is "and"
            jcc(a, cc_b, end_at)
        else
            jcc(a, cc_ae, end_at)
        end
        gen_expr(fc, right of e)
        mark(a, end_at)
    else if what is "not"
        gen_expr(fc, operand of e)
        truth_test(a)
        setcc(a, cc_b, rax)
        movzx8(a, rax, rax)
        movi64(a, rcx, bits_no)
        alu(a, "add", rcx, rax)
        movq_xr(a, xmm0, rcx)
    else if what is "negate"
        gen_negate(fc, e)
    else if what is "list"
        for each part in items of e
            gen_expr(fc, part)
            push_value(fc)
        end
        set n to length of items of e
        movi(a, rcx, n)
        mov_rr(a, rsi, rsp)
        call_to(a, "rt_list_make")
        movq_xr(a, xmm0, rax)
        if n is greater than 0
            alui(a, "add", rsp, 8 * n)
            set pushed of fc to pushed of fc - n
        end
    else if what is "length"
        gen_expr(fc, subject of e)
        call_to(a, "rt_length")
        kind_stub(fc, at of e, "'length of' needs a list, text, dictionary or bytes, not ")
    else if what is "item"
        gen_pair(fc, subject of e, index of e)
        call_to(a, "rt_item")
        why_stub(fc, at of e, "rt_why_item")
    else if what is "record"
        for each part in values of e
            gen_expr(fc, part)
            push_value(fc)
        end
        set n to length of values of e
        set named to empty list # the fields' names: each a text of the program's, then a table of them
        for each field in fields of e
            add text_object(a, field) to named
        end
        set ro to rodata of a
        pad_to(ro, 8)
        set names_at to "R" + length of ro
        rodata_here(a, names_at)
        for each label in named
            absolute(a, "rodata", length of ro, label, 0)
            put64(ro, 0)
        end
        movi(a, rcx, n)
        mov_rr(a, rsi, rsp)
        lea(a, rdx, rip(names_at))
        call_to(a, "rt_record_make")
        movq_xr(a, xmm0, rax)
        if n is greater than 0
            alui(a, "add", rsp, 8 * n)
            set pushed of fc to pushed of fc - n
        end
    else if what is "field"
        gen_expr(fc, subject of e)
        lea(a, rdx, rip(text_object(a, name of e)))
        call_to(a, "rt_field")
        why_stub(fc, at of e, "rt_why_field")
    else if what is "dictionary"
        for each part in items of e
            gen_expr(fc, part)
            push_value(fc)
        end
        set n to length of items of e
        movi(a, rcx, n)
        mov_rr(a, rsi, rsp)
        call_to(a, "rt_dict_make")
        kind_stub(fc, at of e, "a dictionary's keys are text or numbers, not ")
        if n is greater than 0
            alui(a, "add", rsp, 8 * n)
            set pushed of fc to pushed of fc - n
        end
    else if what is "builtin" and name of e is "run program"
        gen_pair(fc, item 1 of args of e, item 2 of args of e)
        call_to(a, "rt_run_program")
        why_stub(fc, at of e, "rt_why_run")
    else if what is "builtin" and name of e is "keys"
        gen_expr(fc, item 1 of args of e)
        call_to(a, "rt_keys")
        kind_stub(fc, at of e, "'keys of' needs a dictionary, not ")
    else if what is "builtin" and name of e is in builtin_routines
        if name of e is "uppercase" or name of e is "lowercase"
            set uses_case of st of fc to yes
        end
        set inputs to args of e
        if length of inputs is 1
            gen_expr(fc, item 1 of inputs)
        else
            gen_pair(fc, item 1 of inputs, item 2 of inputs)
        end
        call_to(a, item (name of e) of builtin_routines)
        why_stub(fc, at of e, "rt_why_builtin")
    else if what is "read" or what is "ask" or what is "arguments"
        gen_outside(fc, e)
    else
        not_yet_node(e)
    end
end

# after a call to the runtime: if rax isn't 0, the mistake is `message` and what kind of value err_a is
to kind_stub with fc, at, message
    set a to a of fc
    set wrong to new_label(a)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, wrong)
    set was to enter_cold(a)
    mark(a, wrong)
    stub_start(fc, at)
    stub_text(a, message)
    stub_kind(a, "err_a")
    jmp_to(a, "rt_e_end")
    leave_cold(a, was)
end

# after a call to the runtime: if rax isn't 0, `why` says what the mistake is
to why_stub with fc, at, why
    set a to a of fc
    set wrong to new_label(a)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, wrong)
    set was to enter_cold(a)
    mark(a, wrong)
    stub_start(fc, at)
    call_to(a, why)
    jmp_to(a, "rt_e_end")
    leave_cold(a, was)
end

to gen_value with fc, e, x
    set a to a of fc
    set type to type of e
    if type is "number"
        load_bits(a, x, literal_bytes(value of e, at of e))
    else if type is "yes"
        load_bits(a, x, bits_yes)
    else if type is "no"
        load_bits(a, x, bits_no)
    else if type is "nothing"
        load_bits(a, x, bits_nothing)
    else
        load_text(a, x, value of e)
    end
end

to gen_name with fc, e
    set a to a of fc
    set found to front's resolve(scope of fc, name of e)
    if found is nothing
        jmp_to(a, fail_stub(fc, at of e, front's undefined_message(scope of fc, name of e, no, no)))
        return nothing
    end
    set unset to fail_stub(fc, at of e, front's no_value(name of e))
    set odd to new_label(a)
    set back to new_label(a)
    movsd_load(a, xmm0, place_of(fc, found))
    ucomisd(a, xmm0, reg_at(xmm0))
    jcc(a, cc_p, odd)
    mark(a, back)
    set was to enter_cold(a)
    mark(a, odd)
    movq_rx(a, rax, xmm0)
    movi64(a, rcx, bits_unset)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, unset)
    jmp_to(a, back)
    leave_cold(a, was)
end

to gen_math with fc, e
    set a to a of fc
    set op to op of e
    gen_pair(fc, left of e, right of e)
    set odd to new_label(a)
    set back to new_label(a)
    set wrong to new_label(a)
    set by_zero to new_label(a)
    if op is "/"
        movq_rx(a, rax, xmm1)
        shifti(a, "shl", rax, 1)
        jcc(a, cc_e, by_zero)
    end
    movapd(a, xmm2, xmm0)
    sse_math(a, op, xmm0, reg_at(xmm1))
    ucomisd(a, xmm0, reg_at(xmm0))
    jcc(a, cc_p, odd)
    mark(a, back)
    set was to enter_cold(a)
    mark(a, odd) # NaN: from something that isn't a number, or just NaN
    call_to(a, "rt_any_odd")
    test_rr(a, rax, rax)
    jcc(a, cc_e, back)
    if op is "+" # text joins
        call_to(a, "rt_plus")
        alui(a, "cmp", rax, 1)
        jcc(a, cc_e, back)
        jcc(a, cc_a, fail_stub(fc, at of e, too_big))
    end
    mark(a, wrong)
    movsd_store(a, rip("err_a"), xmm2)
    movsd_store(a, rip("err_b"), xmm1)
    two_kinds(fc, at of e, "can't use '" + op + "' on ", " and ")
    if op is "/"
        mark(a, by_zero)
        movapd(a, xmm2, xmm0)
        call_to(a, "rt_any_odd")
        test_rr(a, rax, rax)
        jcc(a, cc_ne, wrong)
        jmp_to(a, fail_stub(fc, at of e, "can't divide by zero"))
    end
    leave_cold(a, was)
end

to gen_negate with fc, e
    set a to a of fc
    gen_expr(fc, operand of e)
    set odd to new_label(a)
    set back to new_label(a)
    set wrong to new_label(a)
    ucomisd(a, xmm0, reg_at(xmm0))
    jcc(a, cc_p, odd)
    mark(a, back)
    movq_rx(a, rax, xmm0)
    bit_op(a, "btc", rax, 63)
    movq_xr(a, xmm0, rax)
    set was to enter_cold(a)
    mark(a, odd)
    odd_jump(a, xmm0, wrong)
    jmp_to(a, back)
    mark(a, wrong)
    movsd_store(a, rip("err_a"), xmm0)
    stub_start(fc, at of e)
    stub_text(a, "'-' needs a number, not ")
    stub_kind(a, "err_a")
    jmp_to(a, "rt_e_end")
    leave_cold(a, was)
end

to plural_of with n, word
    if n is 1
        return "1 " + word
    end
    return "" + n + " " + word + "s"
end

# A call: the function must have been made by now, then its inputs are worked out and pushed in order,
# their number and kinds checked, and the calls in progress counted. rax carries the call's number, which
# the function keeps in its frame for the trail a mistake shows.
to gen_call with fc, e, statement
    set a to a of fc
    set callee to name of e
    set found to front's resolve(scope of fc, callee)
    if found is nothing
        jmp_to(a, fail_stub(fc, at of e, front's undefined_message(scope of fc, callee, yes, statement)))
        return nothing
    end
    set f to function_at(fc, found)
    if f is nothing
        gen_value_call(fc, e, found)
        return nothing
    end
    set made_yet to fail_stub(fc, at of e, "there is no function called '" + callee + "'")
    movi64(a, rcx, bits_unset)
    alu_load(a, "cmp", rcx, place_of(fc, found))
    jcc(a, cc_e, made_yet)
    for each arg in args of e
        gen_expr(fc, arg)
        push_value(fc)
    end
    set n to length of args of e
    set wanted to length of params of f
    if n is not wanted
        jmp_to(a, fail_stub(fc, at of e, "'" + callee + "' needs " + plural_of(wanted, "input") + " but got " + n))
    else
        for each i from 1 to n
            set k to item i of kinds of f
            if k is not -1
                check_kind(fc, e, f, i, k, n)
            end
        end
    end
    set deep to fail_stub(fc, at of e, "too much recursion: a function kept calling itself")
    alui(a, "cmp", r15, deepest)
    jcc(a, cc_ae, deep)
    inc_r(a, r15)
    movi(a, rax, call_site(fc, at of e))
    call_to(a, label of f)
    dec_r(a, r15)
    if n is greater than 0
        alui(a, "add", rsp, 8 * n)
        set pushed of fc to pushed of fc - n
    end
end

to check_kind with fc, e, f, i, k, n
    set a to a of fc
    set wrong to new_label(a)
    set fine to new_label(a)
    load(a, rax, mem(rsp, 8 * (n - i)))
    if k is 0
        mov_rr(a, rdx, rax)
        movi64(a, rcx, bits_nothing)
        alu(a, "sub", rdx, rcx)
        alui(a, "cmp", rdx, 3)
        jcc(a, cc_b, wrong)
        mov_rr(a, rdx, rax)
        shifti(a, "shr", rdx, 48)
        alui(a, "cmp", rdx, kind_text)
        jcc(a, cc_ae, wrong)
    else if k is 1 or k is 3 or k is 4 or k is 5 or k is 6 or k is 7
        mov_rr(a, rdx, rax)
        shifti(a, "shr", rdx, 48)
        alui(a, "cmp", rdx, item (k + 1) of kind_tags)
        jcc(a, cc_ne, wrong)
    else if k is 2
        movi64(a, rcx, bits_no)
        alu(a, "cmp", rax, rcx)
        jcc(a, cc_e, fine)
        inc_r(a, rcx)
        alu(a, "cmp", rax, rcx)
        jcc(a, cc_ne, wrong)
    end
    mark(a, fine)
    set was to enter_cold(a)
    mark(a, wrong)
    store(a, rip("err_a"), rax)
    stub_start(fc, at of e)
    stub_text(a, "'" + name of e + "' needs " + item i of params of f + " to be " + item (k + 1) of kind_names + ", not ")
    stub_kind(a, "err_a")
    jmp_to(a, "rt_e_end")
    leave_cold(a, was)
end

# a number for this call, which a mistake's trail turns into "in 'f', called from line 3"; calls from the same
# place to the same function share a key, so a run of them shows as one line
# the number of the place a call is, which a mistake's trail turns into "called from line 3"
to call_site with fc, at
    set st to st of fc
    set key to "" + line of at + ":" + col of at + ":" + file of at
    set known to call_places of st
    if key is in known
        return item key of known
    end
    set from to ""
    if file of at is not ""
        set from to file of at + ", "
    end
    set calls to calls of st
    add "called from " + from + "line " + line of at to calls
    set item key of known to length of calls - 1
    return length of calls - 1
end

# A call through a function value: the name's value must be a function, then the inputs are worked out
# and pushed in order, and the function's description checks them as it runs.
to gen_value_call with fc, e, found
    set a to a of fc
    set callee to name of e
    set none to fail_stub(fc, at of e, "there is no function called '" + callee + "'")
    set wrong to new_label(a)
    set back to new_label(a)
    movsd_load(a, xmm0, place_of(fc, found))
    movq_rx(a, rax, xmm0)
    movi64(a, rcx, bits_unset)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, none)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_function)
    jcc(a, cc_ne, wrong)
    mark(a, back)
    set was to enter_cold(a)
    mark(a, wrong)
    movsd_store(a, rip("err_a"), xmm0)
    stub_start(fc, at of e)
    stub_text(a, "'" + callee + "' is ")
    stub_kind(a, "err_a")
    stub_text(a, ", not a function")
    jmp_to(a, "rt_e_end")
    leave_cold(a, was)
    push_value(fc)
    for each arg in args of e
        gen_expr(fc, arg)
        push_value(fc)
    end
    set n to length of args of e
    load(a, rax, mem(rsp, 8 * n))
    movi(a, rcx, n)
    mov_rr(a, rsi, rsp)
    call_to(a, "rt_check_call")
    set call_wrong to new_label(a)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, call_wrong)
    set was_too to enter_cold(a)
    mark(a, call_wrong)
    stub_start(fc, at of e)
    lea(a, rax, rip(text_object(a, callee)))
    store(a, rip("err_what"), rax)
    call_to(a, "rt_why_call")
    jmp_to(a, "rt_e_end")
    leave_cold(a, was_too)
    set deep to fail_stub(fc, at of e, "too much recursion: a function kept calling itself")
    alui(a, "cmp", r15, deepest)
    jcc(a, cc_ae, deep)
    inc_r(a, r15)
    load(a, rax, mem(rsp, 8 * n))
    untag(a, rax)
    load(a, rdx, mem(rax, 8))
    load(a, rcx, mem(rax, 0))
    movi(a, rax, call_site(fc, at of e))
    call_r(a, rcx)
    dec_r(a, r15)
    alui(a, "add", rsp, 8 * (n + 1))
    set pushed of fc to pushed of fc - n - 1
end

# ---------- the files the system runs ----------

# every label's place, now that each part of the file has its address: `bases` gives each part's
to place_labels with a, bases
    set hot_size to length of hot of a
    set text to empty list
    put_all(text, hot of a)
    put_all(text, cold of a)
    set table to labels of a
    for each fix in fixups of a
        if not (label of fix is in table)
            fail with "machine.moth has no label called " + label of fix
        end
        set target to item (label of fix) of table
        if section of target is "cold"
            set address to item "hot" of bases + hot_size + at of target
        else
            set address to item (section of target) of bases + at of target
        end
        set from to at of fix
        set finish to finish of fix
        if buffer of fix is "cold"
            set from to from + hot_size
            set finish to finish + hot_size
        end
        patch32(text, from, address + addend of fix - (item "hot" of bases + finish))
    end
    return text
end

# where a label is, now that each part of the file has its address
to label_address with a, bases, name
    set table to labels of a
    if not (name is in table)
        fail with "machine.moth has no label called " + name
    end
    set target to item name of table
    if section of target is "cold"
        return item "hot" of bases + length of hot of a + at of target
    end
    return item (section of target) of bases + at of target
end

# the 8-byte addresses absolute() asked for, now that everything has its place
to place_absolutes with a, bases, image_base
    for each fix in absolutes of a
        set out to data of a
        if section of fix is "rodata"
            set out to rodata of a
        end
        set eight to empty list
        put64(eight, image_base + label_address(a, bases, label of fix) + addend of fix)
        for each k from 1 to 8
            set item (at of fix + k) of out to item k of eight
        end
    end
end

to label_offset with a, name
    set target to item name of labels of a
    if section of target is "cold"
        return length of hot of a + at of target
    end
    return at of target
end

to windows_file with a
    set names to list of "GetStdHandle", "GetConsoleMode", "WriteFile", "WriteConsoleW", "MultiByteToWideChar", "ExitProcess",
        "VirtualAlloc"
    for each fn_name in file_imports
        add fn_name to names
    end
    set others to empty list
    for each group in more_imports of a
        if item 1 of group is "KERNEL32.dll"
            for each fn_name in item 2 of group
                add fn_name to names
            end
        else
            add group to others
        end
    end
    set groups to empty list
    add (list of "KERNEL32.dll", names) to groups
    for each group in others
        add group to groups
    end
    set slot_count to 0
    for each group in groups
        set slot_count to slot_count + length of item 2 of group + 1
    end
    set text_size to length of hot of a + length of cold of a
    set text_rva to 4096
    set rdata_rva to align_up(text_rva + text_size, 4096)
    set data_rva to align_up(rdata_rva + length of rodata of a, 4096)
    # the DLLs' functions, at the end of the data: for each DLL, what to look up and where the loader puts each
    # one, then each function's name and each DLL's
    set dat to data of a
    pad_to(dat, 8)
    set descriptors to length of dat
    set lookups to align_up(descriptors + 20 * (length of groups + 1), 8)
    set slots to lookups + 8 * slot_count
    set hints to slots + 8 * slot_count
    set hint_at to empty list
    set spot to hints
    for each group in groups
        for each fn_name in item 2 of group
            add spot to hint_at
            set spot to align_up(spot + 2 + length of fn_name + 1, 2)
        end
    end
    set dll_at to empty list
    for each group in groups
        add spot to dll_at
        set spot to spot + length of item 1 of group + 1
    end
    set first to 0
    set g to 0
    for each group in groups
        add 1 to g
        put32(dat, data_rva + lookups + 8 * first)
        put32(dat, 0)
        put32(dat, 0)
        put32(dat, data_rva + item g of dll_at)
        put32(dat, data_rva + slots + 8 * first)
        set first to first + length of item 2 of group + 1
    end
    repeat 20 times
        add 0 to dat
    end
    set gap to lookups - length of dat
    repeat gap times
        add 0 to dat
    end
    repeat 2 times
        set k to 0
        for each group in groups
            for each fn_name in item 2 of group
                add 1 to k
                put64(dat, data_rva + item k of hint_at)
            end
            put64(dat, 0)
        end
    end
    set table to labels of a
    set k to 0
    for each group in groups
        for each fn_name in item 2 of group
            set item ("imp_" + fn_name) of table to record with section "data", at slots + 8 * k
            add 1 to k
            put16(dat, 0)
            put_all(dat, fn_name as bytes)
            add 0 to dat
            pad_to(dat, 2)
        end
        add 1 to k
    end
    for each group in groups
        put_all(dat, item 1 of group as bytes)
        add 0 to dat
    end
    pad_to(dat, 16)
    set bss_rva to data_rva + length of dat
    set data_virtual to length of dat + bss of a
    set image_size to align_up(data_rva + data_virtual, 4096)
    set bases to dictionary where "hot" is text_rva, "rodata" is rdata_rva, "data" is data_rva, "bss" is bss_rva
    set text to place_labels(a, bases)
    place_absolutes(a, bases, 0x140000000)
    set text_raw to align_up(text_size, 512)
    set rdata_raw to align_up(length of rodata of a, 512)
    set data_raw to align_up(length of dat, 512)
    set out to empty list
    # the MS-DOS header: just "MZ" and where the PE header is
    put16(out, 0x5A4D)
    repeat 58 times
        add 0 to out
    end
    put32(out, 64)
    put32(out, 0x4550) # "PE\0\0"
    put16(out, 0x8664) # x86-64
    put16(out, 3) # sections
    put32(out, 0)
    put32(out, 0)
    put32(out, 0)
    put16(out, 240) # the optional header's size
    put16(out, 0x23) # an executable, with no relocations, that can use addresses past 2 GB
    put16(out, 0x20B) # PE32+
    put16(out, 14)
    put32(out, text_raw)
    put32(out, rdata_raw + data_raw)
    put32(out, 0)
    put32(out, text_rva + label_offset(a, "start"))
    put32(out, text_rva)
    put64(out, 0x140000000) # where it is loaded
    put32(out, 4096)
    put32(out, 512)
    put16(out, 6) # Windows Vista or later
    put16(out, 0)
    put32(out, 0)
    put16(out, 6)
    put16(out, 0)
    put32(out, 0)
    put32(out, image_size)
    put32(out, 1024) # the headers
    put32(out, 0)
    put16(out, 3) # a console program
    put16(out, 0x8100) # NX and terminal-server aware
    put64(out, stack_size)
    put64(out, 65536)
    put64(out, 1048576)
    put64(out, 4096)
    put32(out, 0)
    put32(out, 16)
    for each n from 0 to 15
        if n is 1 # the imports
            put32(out, data_rva + descriptors)
            put32(out, 20 * (length of groups + 1))
        else if n is 12 # the import address table
            put32(out, data_rva + slots)
            put32(out, 8 * slot_count)
        else
            put32(out, 0)
            put32(out, 0)
        end
    end
    section_header(out, ".text", text_size, text_rva, text_raw, 1024, 0x60000020)
    section_header(out, ".rdata", length of rodata of a, rdata_rva, rdata_raw, 1024 + text_raw, 0x40000040)
    section_header(out, ".data", data_virtual, data_rva, data_raw, 1024 + text_raw + rdata_raw, 0xC0000040)
    pad_to_size(out, 1024)
    put_all(out, text)
    pad_to_size(out, 1024 + text_raw)
    put_all(out, rodata of a)
    pad_to_size(out, 1024 + text_raw + rdata_raw)
    put_all(out, dat)
    pad_to_size(out, 1024 + text_raw + rdata_raw + data_raw)
    return out
end

to section_header with out, title, virtual, rva, raw_size, raw_at, flags
    set name_bytes to title as bytes
    put_all(out, name_bytes)
    repeat 8 - length of name_bytes times
        add 0 to out
    end
    put32(out, virtual)
    put32(out, rva)
    put32(out, raw_size)
    put32(out, raw_at)
    put32(out, 0)
    put32(out, 0)
    put16(out, 0)
    put16(out, 0)
    put32(out, flags)
end

to pad_to_size with out, size
    repeat while length of out is less than size
        add 0 to out
    end
end

to linux_file with a
    set base to 4194304 # 0x400000
    set text_size to length of hot of a + length of cold of a
    set text_at to 256
    set rodata_at to align_up(text_at + text_size, 16)
    set first_end to rodata_at + length of rodata of a
    set data_at to align_up(first_end, 4096)
    set dat to data of a
    pad_to(dat, 16)
    set bss_at to data_at + length of dat
    set bases to dictionary where "hot" is base + text_at, "rodata" is base + rodata_at, "data" is base + data_at, "bss" is base + bss_at
    set text to place_labels(a, bases)
    place_absolutes(a, bases, 0)
    set out to empty list
    put_all(out, list of 0x7F, 0x45, 0x4C, 0x46, 2, 1, 1, 0) # ELF, 64-bit, little-endian
    repeat 8 times
        add 0 to out
    end
    put16(out, 2) # an executable
    put16(out, 62) # x86-64
    put32(out, 1)
    put64(out, base + text_at + label_offset(a, "start"))
    put64(out, 64) # the program headers
    put64(out, 0)
    put32(out, 0)
    put16(out, 64)
    put16(out, 56)
    put16(out, 3)
    put16(out, 64)
    put16(out, 0)
    put16(out, 0)
    program_header(out, 1, 5, 0, base, first_end, first_end) # the code and read-only data: read and run
    program_header(out, 1, 6, data_at, base + data_at, length of dat, length of dat + bss of a) # the data: read and write
    program_header(out, 0x6474E551, 6, 0, 0, 0, 0) # a stack no code runs from
    pad_to_size(out, text_at)
    put_all(out, text)
    pad_to_size(out, rodata_at)
    put_all(out, rodata of a)
    pad_to_size(out, data_at)
    put_all(out, dat)
    return out
end

to program_header with out, type, flags, offset, address, file_size, memory_size
    put32(out, type)
    put32(out, flags)
    put64(out, offset)
    put64(out, address)
    put64(out, address)
    put64(out, file_size)
    put64(out, memory_size)
    put64(out, 4096)
end
