# what the programs in tools/ make when they run
tools/*.bmp
# pages made from the apps (by moth build --web, in the Node.js command line Moth had until 1.5)
apps/*.html
# moth.moth built into a program of its own: moth.exe on Windows, moth on Linux
/moth.exe
/moth
# where npm run bench and npm run versus put the programs they time, while they do
/.bench-*
# the VS Code extension, packed (by node editors/vscode/make-vsix.mjs)
editors/vscode/*.vsix
# what the guestbook keeps, and its tests' database, when it's run in its folder
apps/guestbook/*.db
apps/guestbook/guestbook
apps/guestbook/guestbook.exe
# what Python makes when it runs the Jupyter kernel or its tests
editors/jupyter/**/__pycache__/
