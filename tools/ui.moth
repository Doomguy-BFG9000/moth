to set_ticked with control, tick
    if on_windows
        return win's set_ticked(control, tick)
    end
    return gtk's set_ticked(control, tick)
end

to add_item with control, text
    if on_windows
        return win's add_item(control, text)
    end
    return gtk's add_item(control, text)
end

to clear_items with control
    if on_windows
        return win's clear_items(control)
    end
    return gtk's clear_items(control)
end

to remove_item with control, place
    if on_windows
        return win's remove_item(control, place)
    end
    return gtk's remove_item(control, place)
end

to count_of with control
    if on_windows
        return win's count_of(control)
    end
    return gtk's count_of(control)
end

to chosen_place with control
    if on_windows
        return win's chosen_place(control)
    end
    return gtk's chosen_place(control)
end

to choose with control, place
    if on_windows
        return win's choose(control, place)
