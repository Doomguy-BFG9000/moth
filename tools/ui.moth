# The system's own windows and controls, on Windows or Linux: windows.moth's on Windows and linux.moth's (GTK)
# on Linux, which have the same functions, so a program that uses this one works on both. It needs both files
# beside it, and is built with --allow-libraries.
#
#   use "ui.moth" as ui
#   to say_hello
#       ui's message(w, "Hello, " + ui's text_of(name))
#   end
#   set w to ui's window("Hello", 360, 140)
#   set name to ui's text_box(w, 20, 20, 200, 26)
#   ui's button(w, "Greet", 230, 20, 100, 28, say_hello)
#   ui's run()

use "windows.moth" as win
use "linux.moth" as gtk
use the library "kernel32"
    GetTickCount() gives a whole number
end

# which it is: a library every Windows has, which no Linux has
set on_windows to yes
try
    GetTickCount()
if it fails
    set on_windows to no
end

to window with title, width, height
    if on_windows
        return win's window(title, width, height)
    end
    return gtk's window(title, width, height)
end

to button with parent, text, x, y, width, height, handler
    if on_windows
        return win's button(parent, text, x, y, width, height, handler)
    end
    return gtk's button(parent, text, x, y, width, height, handler)
end

to label with parent, text, x, y, width, height
    if on_windows
        return win's label(parent, text, x, y, width, height)
    end
    return gtk's label(parent, text, x, y, width, height)
end

to text_box with parent, x, y, width, height
    if on_windows
        return win's text_box(parent, x, y, width, height)
    end
    return gtk's text_box(parent, x, y, width, height)
end

to text_area with parent, x, y, width, height
    if on_windows
        return win's text_area(parent, x, y, width, height)
    end
    return gtk's text_area(parent, x, y, width, height)
end

to on_change with control, handler
    if on_windows
        return win's on_change(control, handler)
    end
    return gtk's on_change(control, handler)
end

to checkbox with parent, text, x, y, width, height, handler
    if on_windows
        return win's checkbox(parent, text, x, y, width, height, handler)
