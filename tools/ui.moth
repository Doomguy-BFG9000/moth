to dropdown with parent, x, y, width, height, handler
    if on_windows
        return win's dropdown(parent, x, y, width, height, handler)
    end
    return gtk's dropdown(parent, x, y, width, height, handler)
end

to text_of with control
    if on_windows
        return win's text_of(control)
    end
    return gtk's text_of(control)
end

to set_text with control, text
    if on_windows
        return win's set_text(control, text)
