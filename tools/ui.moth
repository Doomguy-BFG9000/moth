to menu_item with parent, title, text, handler
    if on_windows
        return win's menu_item(parent, title, text, handler)
    end
    return gtk's menu_item(parent, title, text, handler)
end

to timer with parent, milliseconds, handler
    if on_windows
        return win's timer(parent, milliseconds, handler)
    end
    return gtk's timer(parent, milliseconds, handler)
